<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.pnttung.lingora.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_foundationStatus"
            app:destination="@id/foundationStatusFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.pnttung.lingora.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_register_to_foundationStatus"
            app:destination="@id/foundationStatusFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/foundationStatusFragment"
        android:name="com.pnttung.lingora.ui.foundation.FoundationStatusFragment"
        android:label="Foundation Status"
        tools:layout="@layout/fragment_foundation_status">
        <action
            android:id="@+id/action_foundationStatus_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/foundationStatusFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
