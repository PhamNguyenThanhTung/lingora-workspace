# Learner server configuration. Keep real values in ignored .env.local or Vercel.
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key
DATABASE_URL=postgresql://replace-user:replace-password@replace-host:5432/postgres?schema=app
# WRITING SRS is opt-in and restricted to comma-separated learner UUIDs.
WRITING_SRS_ENABLED=false
WRITING_SRS_LEARNER_IDS=
