@startuml 01-usecase-tong-quat
title Lingora - Sơ đồ Use Case tổng quát
left to right direction

skinparam dpi 150
skinparam defaultFontName Arial
skinparam defaultFontSize 22
skinparam titleFontSize 30
skinparam ArrowFontSize 18
skinparam ActorFontSize 22
skinparam UsecaseFontSize 20
skinparam PackageFontSize 24
skinparam shadowing false
skinparam roundcorner 20
skinparam nodesep 25
skinparam ranksep 110
skinparam ArrowColor #334155
skinparam ActorBorderColor #334155
skinparam UsecaseBorderColor #334155
skinparam UsecaseBackgroundColor #F8FAFC
skinparam PackageBorderColor #334155

' ===== Actors =====
actor "Khách\n(chưa đăng nhập)" as Guest
actor "Người dùng\nxác thực" as Auth
actor "Học viên" as Learner
actor "Người soạn bài" as Creator
actor "Kiểm duyệt viên" as Mod
actor "Quản lý tổ chức" as OrgMgr
actor "Quản trị viên" as Admin
actor "Nhân viên\nvận hành" as Ops

' ===== Kế thừa: 6 vai trò đều là Người dùng xác thực =====
Auth <|-- Learner
Auth <|-- Creator
Auth <|-- Mod
Auth <|-- OrgMgr
Auth <|-- Admin
Auth <|-- Ops
Guest -[hidden]down- Auth

rectangle "Lingora Platform System" {

  usecase "UC-01\nĐăng nhập & Phiên làm việc" as UC01 #E0F2FE

  package "Học tập" {
    usecase "UC-02\nMục tiêu & Thời gian học" as UC02
    usecase "UC-03\nXếp lớp & Điểm xuất phát" as UC03
    usecase "UC-04\nLộ trình & Nhảy cấp" as UC04
    usecase "UC-05\nHọc bài & Làm lại" as UC05
    usecase "UC-06\nÔn tập ngắt quãng (SRS)" as UC06
    usecase "UC-07\nTiến độ, Năng lực & Chuỗi" as UC07
  }

  package "Nội dung" {
    usecase "UC-08\nLập đề cương, Giao bài\n& Soạn bài" as UC08
    usecase "UC-09\nKiểm duyệt nội dung" as UC09
    usecase "UC-10\nXuất bản nội dung" as UC10
    usecase "UC-15\nQuản lý nhóm học viên\n(mở rộng)" as UC15 #EEF2FF
  }

  package "Quản trị & Vận hành" {
    usecase "UC-11\nTài khoản & 6 Vai trò" as UC11
    usecase "UC-12\nBáo cáo vận hành" as UC12
    usecase "UC-13\nKiểm toán an ninh" as UC13
    usecase "UC-14\nPhiếu hỗ trợ kỹ thuật" as UC14
  }
}

' ===== Khách đăng nhập =====
Guest --> UC01

' ===== Chức năng của từng vai trò =====
Learner --> UC02
Learner --> UC03
Learner --> UC04
Learner --> UC05
Learner --> UC06
Learner --> UC07

Creator --> UC08
Mod --> UC09
OrgMgr --> UC08
OrgMgr --> UC10
OrgMgr --> UC15

Admin --> UC10
Admin --> UC11
Admin --> UC12
Admin --> UC13
Ops --> UC14

' ===== Mọi chức năng đều yêu cầu đăng nhập trước =====
UC02 ..> UC01 : <<include>>
UC03 ..> UC01 : <<include>>
UC04 ..> UC01 : <<include>>
UC05 ..> UC01 : <<include>>
UC06 ..> UC01 : <<include>>
UC07 ..> UC01 : <<include>>
UC08 ..> UC01 : <<include>>
UC09 ..> UC01 : <<include>>
UC10 ..> UC01 : <<include>>
UC11 ..> UC01 : <<include>>
UC12 ..> UC01 : <<include>>
UC13 ..> UC01 : <<include>>
UC14 ..> UC01 : <<include>>
UC15 ..> UC01 : <<include>>

legend bottom
  <<include>>: phải đăng nhập (UC-01) trước khi thực hiện.
  Khách đăng nhập thành công trở thành Người dùng xác thực.
  Ô xanh nhạt (UC-15): chức năng mở rộng.
end legend
@enduml
