@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Calibri", "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 20
skinparam defaultFontColor #0F172A

skinparam dpi 300

' Monochrome Palette
!define COLOR_BORDER #334155
!define COLOR_BG #FFFFFF
!define COLOR_TEXT #0F172A
!define COLOR_MUTED #64748B
!define COLOR_NOTE_BG #F8FAFC
!define COLOR_NOTE_BORDER #94A3B8

' Use Case Styling
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.8
    FontSize 18
    ArrowColor #475569
    ArrowFontSize 16
}

' Actor Styling - Clean Monochrome
skinparam actor {
    BackgroundColor #F8FAFC
    BorderColor #334155
    BorderThickness 1.8
    FontSize 18
}

' Activity Diagram Styling - Monochrome & Subtle Grayscale Lanes
skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.8
    FontSize 18
    StartColor #0F172A
    EndColor #0F172A
    BarColor #0F172A
    DiamondBackgroundColor #FFFFFF
    DiamondBorderColor #334155
    DiamondFontSize 16
}

' Class Diagram Styling
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.8
    FontSize 18
    HeaderBackgroundColor #F8FAFC
    StereotypeFontSize 16
    AttributeFontSize 16
}

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    BorderThickness 1.5
    FontSize 18
    FontStyle bold
}

skinparam note {
    BackgroundColor #F8FAFC
    BorderColor #64748B
    FontSize 14
}

skinparam arrow {
    Color #475569
    FontSize 14
}
@enduml
