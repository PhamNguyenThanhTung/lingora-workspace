@startuml
!include _style.puml
left to right direction
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 65

actor "Lesson Creator" as Creator
actor "Moderator" as Moderator
actor "Org Manager" as OrgMgr
actor "Operations Staff" as OpsStaff
actor "Administrator" as Admin

rectangle "Content & Administration Subsystems" {
  ' Content Governance
  usecase "UC-08 Plan, Assign & Create Draft" as UC08
  usecase "Plan Curriculum &\nAssign Lesson" as PlanAssign
  usecase "Submit for Review" as SubmitReview
  usecase "Clone-to-Draft v2" as CloneDraft

  usecase "UC-09 Review & Moderate Content" as UC09
  usecase "Approve Revision" as ApproveRev
  usecase "Request Changes" as RequestChanges

  usecase "UC-10 Publish Approved Content" as UC10
  usecase "Emergency Publish\n(Audit Required)" as EmergencyPublish

  ' Administration & Operations
  usecase "UC-11 Manage Accounts & Roles" as UC11
  usecase "UC-12 View System Reports" as UC12
  usecase "UC-13 View & Audit Security Logs" as UC13
  usecase "UC-14 Handle Support Tickets" as UC14

  ' Relationships
  PlanAssign ..> UC08 : <<include>>
  SubmitReview ..> UC08 : <<include>>
  CloneDraft ..> UC08 : <<extend>>

  ApproveRev ..> UC09 : <<include>>
  RequestChanges ..> UC09 : <<include>>

  EmergencyPublish .> UC10 : <<extend>>
  EmergencyPublish ..> UC13 : <<include>>
}

OrgMgr --> UC08
Creator --> UC08
Moderator --> UC09
OrgMgr --> UC10

Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> EmergencyPublish

OpsStaff --> UC14

@enduml
