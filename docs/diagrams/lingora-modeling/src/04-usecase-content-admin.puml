@startuml
skinparam dpi 150
skinparam defaultFontName Arial
skinparam defaultFontSize 20
skinparam titleFontSize 26
skinparam ArrowFontSize 16
skinparam UsecaseFontSize 18
skinparam ActorFontSize 20
skinparam shadowing false
skinparam nodesep 25
skinparam ranksep 80

left to right direction
title Sơ đồ Use Case Phân hệ Đề cương & Biên soạn - Lingora

actor "Admin" as Admin
actor "Giáo viên" as Teacher

Admin -[hidden]right-> Teacher

rectangle "Phân hệ Đề cương & Biên soạn" as P_Content {
    usecase "UC-09: Lập đề cương, ma trận đề thi & Phân công" as UC_09
    usecase "UC-10: Soạn bài học & Câu hỏi đề thi theo phân công" as UC_10
    usecase "UC-11: Nộp bài & Nộp lại sau chỉnh sửa" as UC_11
    usecase "UC-12: Thẩm định & Xuất bản nội dung" as UC_12
    
    UC_09 -[hidden]right-> UC_10
    UC_10 -[hidden]right-> UC_11
    UC_11 -[hidden]right-> UC_12
}

usecase "UC-01: Xác thực, Đăng nhập & Quản lý hồ sơ" as UC_01

P_Content -[hidden]down-> UC_01

' Liên kết Actor với Use Case (đường nét liền, KHÔNG mũi tên)
Admin -- UC_01
Admin -- UC_09
Admin -- UC_10
Admin -- UC_12

Teacher -- UC_01
Teacher -- UC_10
Teacher -- UC_11

' Quan hệ Include
UC_09 .[#94A3B8].> UC_01 : <<include>>
UC_10 .[#94A3B8].> UC_01 : <<include>>
UC_11 .[#94A3B8].> UC_01 : <<include>>
UC_12 .[#94A3B8].> UC_01 : <<include>>

@enduml
