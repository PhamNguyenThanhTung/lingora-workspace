@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Calibri", "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 14
skinparam defaultFontColor #0F172A
skinparam dpi 300

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.5
    FontSize 13
    ArrowColor #475569
    ArrowFontSize 12
}

skinparam actor {
    BackgroundColor #F8FAFC
    BorderColor #334155
    BorderThickness 1.5
    FontSize 13
}

skinparam rectangle {
    BorderColor #334155
    BorderThickness 2
    FontSize 16
    FontStyle bold
}

left to right direction
skinparam nodesep 18
skinparam ranksep 45

' Base authenticated user
actor "Authenticated User\n(Người dùng xác thực)" as AuthUser

' Specialized Actors inheriting from Authenticated User
actor "Learner\n(Học viên)" as Learner
actor "Lesson Creator\n(Người soạn bài)" as Creator
actor "Moderator\n(Kiểm duyệt viên)" as Moderator
actor "Org Manager\n(Quản lý tổ chức)" as OrgMgr
actor "Administrator\n(Quản trị viên)" as Admin
actor "Operations Staff\n(Nhân viên vận hành)" as OpsStaff

' Inheritance hierarchy (All 6 roles inherit Authenticated User)
Learner -up-|> AuthUser
Creator -up-|> AuthUser
Moderator -up-|> AuthUser
OrgMgr -up-|> AuthUser
Admin -up-|> AuthUser
OpsStaff -up-|> AuthUser

rectangle "Lingora Platform System" {
  usecase "UC-01 Login & Session\n(Đăng nhập & Phiên làm việc)" as UC01 #F8FAFC

  usecase "UC-02 Configure Goals & Study Time\n(Mục tiêu & Thời gian học)" as UC02
  usecase "UC-03 Placement Assessment\n(Xếp lớp & Điểm xuất phát)" as UC03
  usecase "UC-04 Browse Path & Conditional Jump\n(Lộ trình & Nhảy cấp)" as UC04
  usecase "UC-05 Complete Lesson & Retry\n(Học bài & Làm lại)" as UC05
  usecase "UC-06 Spaced Repetition (SRS)\n(Ôn tập ngắt quãng)" as UC06
  usecase "UC-07 Track Progress, Mastery & Streak\n(Tiến độ, Năng lực & Chuỗi)" as UC07

  usecase "UC-08 Plan, Assign & Create Lesson Draft\n(Lập đề cương, Giao bài & Soạn bài)" as UC08
  usecase "UC-09 Review & Moderate Content\n(Kiểm duyệt nội dung)" as UC09
  usecase "UC-10 Publish Approved Content\n(Xuất bản nội dung)" as UC10

  usecase "UC-11 Manage Accounts & Roles\n(Tài khoản & 6 Vai trò)" as UC11
  usecase "UC-12 View System Reports\n(Báo cáo vận hành)" as UC12
  usecase "UC-13 View & Audit Security Logs\n(Kiểm toán an ninh)" as UC13
  usecase "UC-14 Handle Support Tickets\n(Phiếu hỗ trợ kỹ thuật)" as UC14
  usecase "UC-15 Manage Cohorts & Groups\n(Quản lý nhóm học viên - Mở rộng)" as UC15 #F1F5F9
}

' All authenticated users must login to establish session
AuthUser --> UC01

' Learner use cases
Learner --> UC02
Learner --> UC03
Learner --> UC04
Learner --> UC05
Learner --> UC06
Learner --> UC07

' Content management use cases
Creator --> UC08 : <<author>>
OrgMgr --> UC08 : <<plan & assign>>
Moderator --> UC09

' Publishing & Governance use cases
OrgMgr --> UC10
OrgMgr --> UC15

Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin ..> UC10 : <<emergency>>

' Support use cases
OpsStaff --> UC14

@enduml
