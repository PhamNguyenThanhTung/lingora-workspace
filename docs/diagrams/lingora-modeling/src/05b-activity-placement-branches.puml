@startuml
!include _style.puml

|#F8FAFC|Learner|
start

if (Thao tác Onboarding / Profile?) then (Bỏ qua - Skip)
  |#FFFFFF|System|
  :Ghi nhận selfReportedLevel là UNVERIFIED;
  :Gán điểm vào mặc định = Course A1, Unit 1;
  note right
    * UNVERIFIED: Chưa có đánh giá năng lực
    * Không tạo AssessmentResult
    * Không tạo SkillProfile
    * Không verified CEFR level
  end note
  |#F8FAFC|Learner|
  :Vào học từ Course A1, Unit 1;
  stop

else (Thi lại - Retake từ Profile)
  |#F8FAFC|Learner|
  :Kích hoạt Retake từ Profile;
  :Làm 30 câu hỏi đánh giá;
  |#FFFFFF|System|
  :Tính điểm thô & Placement Mapping;
  :Lưu bản ghi AssessmentResult mới;
  note right
    Bảo toàn lịch sử thi cũ,
    không ghi đè AssessmentResult trước.
  end note
  :Cập nhật SkillProfile & Starting Unit mới;
  |#F8FAFC|Learner|
  :Nhận kết quả Level & Starting Unit mới;
  stop
endif

@enduml
