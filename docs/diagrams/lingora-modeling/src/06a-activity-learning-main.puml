@startuml
!include _style.puml

|#F8FAFC|Learner|
start
:1. Chọn Unit trên Lộ trình học;

|#FFFFFF|System|
if (Unit hiển thị khi đủ 4/4 Lesson Published?) then (Đủ 4/4)
  |#F8FAFC|Learner|
  :2. Mở Bài học kế tiếp;
  :3. Mở Lesson Content Viewer;
  :4. Học lý thuyết & từ vựng;
  :5. Bắt đầu phiên làm bài tập;

  repeat
    :6. Trả lời câu hỏi hiện tại;
    |#FFFFFF|System|
    :7. Chấm điểm tất định;
    if (Kết quả trả lời?) then (Đúng)
      :8. Nhận 100% điểm câu hỏi;
    else (Sai)
      :9. Chuyển sang luồng Retry;
    endif
  repeat while (Còn câu hỏi trong bài?) is (Còn)
  ->Hết;

  :10. Gộp cập nhật nguyên tử:
  * UserProgress = COMPLETED
  * [UC-07] Tăng chuỗi Streak
  * Thêm thẻ SRS (1,3,7,14,30 ngày);
  |#F8FAFC|Learner|
  :11. Xem tổng kết & mở bài tiếp;
  stop
else (Chưa đủ)
  |#FFFFFF|System|
  :Ẩn Unit (Chưa đủ 4/4 Published);
  stop
endif

@enduml
