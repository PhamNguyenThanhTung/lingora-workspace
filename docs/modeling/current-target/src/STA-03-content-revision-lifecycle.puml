@startuml
!include ../style.puml
' diagram-id: STA-03
' classification: TARGET
' authority: ADR-034/035/036/043; UC-10/11/12
' Two lifecycles on one page; immutable assessment composition has no Teacher draft/edit path.
' Logical source retention does not choose physical Lesson source-freeze fields.
title Sơ đồ trạng thái – Lesson và version đánh giá
left to right direction
state "Lesson revision / package" as LessonFlow {
  state "Nháp / correction được phép" as L_DRAFT
  state "Lesson chờ duyệt" as L_REVIEW
  state "Lesson cần sửa" as L_CHANGES
  state "Lesson đã duyệt" as L_APPROVED
  state "Lesson đã xuất bản" as L_PUBLISHED
  state "Lesson đã lưu trữ" as L_ARCHIVED
  state "Lesson đã thu hồi" as L_WITHDRAWN
  [*] --> L_DRAFT : Teacher hiện được giao tạo/correction
  L_DRAFT --> L_REVIEW : Teacher submit Lesson; giữ nguồn và episode
  L_REVIEW --> L_CHANGES : Admin feedback
  L_CHANGES --> L_REVIEW : Teacher hiện phụ trách sửa/nộp nguồn; giữ history
  L_REVIEW --> L_APPROVED : Admin approve
  L_APPROVED --> L_PUBLISHED : Admin publish thành công
  L_PUBLISHED --> L_PUBLISHED : Bản sửa là revision mới; bản này giữ nguyên
  L_PUBLISHED --> L_ARCHIVED : Replacement publish thành công
  L_PUBLISHED --> L_WITHDRAWN : Admin withdraw
}
state "Assessment version do hệ thống ghép" as AssessmentFlow {
  state "Version hoàn chỉnh chờ duyệt" as A_REVIEW
  state "Version nhận feedback; composition giữ nguyên" as A_CHANGES
  state "Version đã duyệt" as A_APPROVED
  state "Version đã xuất bản" as A_PUBLISHED
  state "Version đã lưu trữ" as A_ARCHIVED
  state "Version đã thu hồi" as A_WITHDRAWN
  [*] --> A_REVIEW : System assembly đủ submitted sources theo blueprint
  A_REVIEW --> A_CHANGES : Admin feedback item/toàn version → source Lessons
  A_CHANGES --> [*] : Giữ version; nguồn sửa/nộp lại tạo successor A_REVIEW mới
  A_REVIEW --> A_APPROVED : Admin approve đúng version/readiness
  A_APPROVED --> A_PUBLISHED : Admin publish thành công
  A_PUBLISHED --> A_PUBLISHED : Nguồn sửa → version mới; attempt vẫn pin version này
  A_PUBLISHED --> A_ARCHIVED : Successor publish thành công
  A_PUBLISHED --> A_WITHDRAWN : Admin withdraw
}
' Assembly with insufficient/invalid inputs creates no partial version/state instance.
' Creator/creation episode, source submission/submitter and current Teacher are distinct.
' Completed evidence/history survives replacement/withdrawal; no hard delete or forced repeat.
@enduml
