  <diagram id="page-SYS-02" name="02 - Hệ thống - Tổng quan hệ thống mục tiêu (SYS-02)">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1093" pageHeight="495" math="0" shadow="0">
      <root>
