  <diagram id="page-STA-01" name="26 - State - Trạng thái tài khoản (STA-01)">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0" />
