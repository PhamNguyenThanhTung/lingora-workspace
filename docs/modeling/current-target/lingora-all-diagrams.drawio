  <diagram id="page-DATA-03" name="32 - Data - Logical ERD mục tiêu (DATA-03)">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3900" pageHeight="1500" math="0" shadow="0">
      <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n' Addendum authority: ADR-042; Study Focus affects supplementary practice only.\n' Shared academic presentation; identities and authority belong in comments/index.\nskinparam monochrome true\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 14\nskinparam defaultFontColor black\nskinparam titleFontSize 18\nskinparam titleFontColor black\nskinparam ArrowColor black\nskinparam ArrowThickness 1\nskinparam roundCorner 0\nskinparam nodesep 35\nskinparam ranksep 45\nskinparam ActorBackgroundColor white\nskinparam ActorBorderColor black\nskinparam ParticipantBackgroundColor white\nskinparam ParticipantBorderColor black\nskinparam ControlBackgroundColor white\nskinparam BoundaryBackgroundColor white\nskinparam DatabaseBackgroundColor white\nskinparam ClassBackgroundColor white\nskinparam ClassBorderColor black\nskinparam ClassHeaderBackgroundColor white\nskinparam EntityBackgroundColor white\nskinparam EntityBorderColor black\nskinparam ActivityBackgroundColor white\nskinparam ActivityBorderColor black\nskinparam ActivityDiamondBackgroundColor white\nskinparam ActivityDiamondBorderColor black\nskinparam StateBackgroundColor white\nskinparam StateBorderColor black\nskinparam PackageBackgroundColor white\nskinparam PackageBorderColor #555555\nskinparam RectangleBackgroundColor white\nskinparam RectangleBorderColor black\nskinparam NoteBackgroundColor white\nskinparam NoteBorderColor black\nskinparam sequenceLifeLineBorderColor #555555\nskinparam sequenceGroupBackgroundColor white\nskinparam sequenceGroupBodyBackgroundColor white\n' diagram-id: DATA-03\n' classification: TARGET\n' Logical identifiers/reference fields below are symbolic, not approved physical columns/keys.\n' Authority ADR-030–036/041–043. Relation grouping and separate response/binding/history records\n' express persistence requirements without mandating one SQL table per drawn entity.\ntitle Sơ đồ quan hệ dữ liệu logic của Lingora\nhide circle\nskinparam nodesep 35\nskinparam ranksep 50\n\n entity \&quot;AccountRecord\&quot; as Account {\n  * accountIdentity\n  --\n  role; accountStatus\n  locale; timezone; streak\n }\n entity \&quot;ContextRecord\&quot; as Context {\n  * accountIdentity + learnedLanguage\n  --\n  status; purpose; studyPreferences\n  studyFocus (mặc định BALANCED)\n  startingPoint; provenance; selfReport\n }\n entity \&quot;LessonAttemptRecord\&quot; as Attempt {\n  * attemptIdentity\n  --\n  contextRef; lessonRevisionRef\n  contributionSum; responseCount\n  completedAt\n }\n entity \&quot;ExerciseResponseRecord\&quot; as Response {\n  * attemptRef + exerciseRef + responseOrder\n  --\n  firstOrRetry; contribution\n }\n entity \&quot;CompletionRecord\&quot; as Completion {\n  * contextRef + lessonRef\n  --\n  completedAt; attemptProvenance\n }\n Account ||--o{ Context\n Context ||--o{ Attempt\n Attempt ||--o{ Response\n Context ||--o{ Completion\n Completion |o--|| Attempt : nguồn hoàn thành\n entity \&quot;CurriculumReference\&quot; as Curriculum {\n  * curriculumPositionIdentity\n  --\n  language; framework; version\n  level; course; unit\n  ordering; eligibility\n  finiteTopicSkillCatalog; controlledKnowledgeAreas\n }\n entity \&quot;LessonRecord\&quot; as Lesson {\n  * lessonIdentity\n  --\n  curriculumRef; required; activeRevisionRef\n }\n entity \&quot;RevisionRecord\&quot; as Revision {\n  * revisionIdentity\n  --\n  lessonRef; priorRevisionRef; lifecycle\n  creatorRef; creationEpisodeRef\n  exactSubmissionReviewRefs\n  submissionActorAndEpisodeRefs\n  concurrencyVersion\n }\n entity \&quot;ExerciseRecord\&quot; as Exercise {\n  * revisionRef + exerciseIdentity\n  --\n  order; type; core\n  practiceSkillRefs; immutableAreaSnapshot\n  learnerPayload; protectedGradingData\n }\n entity \&quot;VocabularyRecord\&quot; as Vocabulary {\n  * language + vocabularyIdentity\n }\n entity \&quot;LessonVocabularyLink\&quot; as LessonVocabulary {\n  * revisionRef + vocabularyRef\n  --\n  coreOrOptional\n }\n Curriculum ||--o{ Lesson\n Lesson ||--o{ Revision\n Revision ||--o{ Exercise\n Revision ||--o{ LessonVocabulary\n Vocabulary ||--o{ LessonVocabulary\n entity \&quot;SrsCardRecord\&quot; as Card {\n  * accountRef + vocabularyRef\n  --\n  enrollmentSource; stage; dueAt\n }\n entity \&quot;SrsOperationRecord\&quot; as Review {\n  * reviewOperationIdentity\n  --\n  cardRef; selfRating; serverTime\n  scheduleOutcome; idempotencyIdentity\n }\n Card ||--o{ Review\n entity \&quot;BlueprintRecord\&quot; as Blueprint {\n  * blueprintIdentity\n  --\n  purpose; curriculumRef; coverage\n  itemRequirements; assessmentConfiguration\n }\n entity \&quot;AssessmentVersionRecord\&quot; as Version {\n  * assessmentVersionIdentity\n  --\n  blueprintRef; approvedSnapshot\n  systemAssemblyInputRef; successorOfRef\n  rubricSnapshot\n }\n entity \&quot;VersionItemRecord\&quot; as Item {\n  * assessmentVersionRef + itemIdentity\n  --\n  contentSnapshot; protectedGradingData\n  creatorRef; creationEpisodeRef\n  sourceLessonRevisionRef; sourceSubmissionRef\n  contributionEpisodeRef; secureOriginGuard\n }\n entity \&quot;AssessmentAttemptRecord\&quot; as AssessmentAttempt {\n  * assessmentAttemptIdentity\n  --\n  contextRef; pinnedVersionRef\n  purpose\n  submissionIdentity\n }\n entity \&quot;AssessmentResultRecord\&quot; as Result {\n  * assessmentAttemptRef\n  --\n  aggregateOutcome; recommendation\n  assessmentType; deliveryMode; completedAt\n }\n entity \&quot;AssignmentRecord\&quot; as Assignment {\n  * assignmentIdentity\n  --\n  lessonRef; currentTeacherRef; currentScopeRef\n }\n entity \&quot;AssignmentHistoryRecord\&quot; as History {\n  * assignmentRef + episodeIdentity\n  --\n  previousTeacher; nextTeacher\n  scopeSnapshot; episodeOrderAndBoundary\n }\n entity \&quot;SecurityAuditRecord\&quot; as Audit {\n  * auditEventIdentity\n  --\n  actorKind; verifiedAuthSubjectRef[0..1]; action\n  targetVersionRef\n  serverTime; outcome; reason\n }\n Blueprint ||--o{ Version\n Version ||--|{ Item\n Version ||--o{ AssessmentAttempt\n AssessmentAttempt ||--o| Result\n Assignment ||--o{ History\nAccount ||--o{ Card\nVocabulary ||--o{ Card\nContext ||--o{ AssessmentAttempt\nLesson ||--o{ Assignment\nAccount |o--o{ Audit\nBlueprint -[hidden]down- Account\nAssignment -[hidden]right- Revision\n' References without drawn joins: attempt→revision, completion→lesson, assignment→current Teacher.\n' Revision creator/creationEpisode differs from exact source submission/submitter/episode.\n' VersionItem sourceSubmissionRef pins retained actor/action/time/target/episode review history,\n' distinct from SecurityAuditRecord; it must match sourceLessonRevisionRef and contributionEpisodeRef.\n' SecurityAuditRecord.actorKind is ACCOUNT, SYSTEM or VERIFIED_AUTH_SUBJECT. ACCOUNT requires one Account reference and no verifiedAuthSubjectRef; SYSTEM requires neither reference; VERIFIED_AUTH_SUBJECT requires a verifiedAuthSubjectRef and no Account. Account actions cannot omit their actor; this adds no business role or table.\n' Assessment contribution blueprint scope is checked through the source item, not a second Assignment target.\n' Lesson–Vocabulary is the structural union/view; completion enrolls exact completed-revision core links.\n' Version membership remains complete (one or more configured items); empty drafts are not assembled versions.\n' CurriculumReference groups approved curriculum concepts; not a physical denormalization decision.\n' Completion and latest completed performance remain distinct; history survives withdrawal/replacement.\n' No Enrollment, persisted LearningPlan, SkillProfile or mastery store required.\n@enduml\n&quot;,&quot;config&quot;:null}" id="plantuml-6"><mxCell style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1" connectable="0" parent="1"><mxGeometry x="0.0" y="0.0" width="0.0" height="0.0" as="geometry" /></mxCell></UserObject>

            <UserObject label="Sơ đồ quan hệ dữ liệu logic của Lingora" plantUmlId="cltitle_2" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=18;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Arial;" plantUmlBaseValue="Sơ đồ quan hệ dữ liệu logic của Lingora" id="cltitle_2"><mxCell style="text;html=1;fillColor=none;strokeColor=none;fontSize=18;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;fontFamily=Arial;" vertex="1" parent="plantuml-6">
      <mxGeometry x="1592.3124" y="63.355" width="512.93718" height="30.0" as="geometry" />
    </mxCell></UserObject>
    <UserObject label="AccountRecord" plantUmlId="cls_3" plantUmlBaseStyle="swimlane;collapsible=0;fontStyle=0;align=center;fontSize=14;fontColor=#000000;startSize=26;spacingLeft=0;fillColor=#FFFFFF;strokeColor=#000000;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;marginBottom=0;stackSpacing=0;marginTop=5.5;rounded=0;shadow=0;fontFamily=Arial;swimlaneFillColor=#FFFFFF;" plantUmlBaseValue="AccountRecord" id="cls_3"><mxCell style="swimlane;collapsible=0;fontStyle=0;align=center;fontSize=14;fontColor=#000000;startSize=26;spacingLeft=0;fillColor=#FFFFFF;strokeColor=#000000;horizontal=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;marginBottom=0;stackSpacing=0;marginTop=5.5;rounded=0;shadow=0;fontFamily=Arial;swimlaneFillColor=#FFFFFF;" vertex="1" parent="plantuml-6">
      <mxGeometry x="2382.3" y="535.2475" width="286.3224" height="112.99374999999999" as="geometry" />
    </mxCell></UserObject>
    <UserObject label="accountIdentity" plantUmlId="mb_4" plantUmlBaseStyle="text;html=1;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=4;overflow=hidden;rotatable=0;fillColor=none;strokeColor=none;fontSize=14;fontColor=#000000;fontStyle=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;fontFamily=Arial;" plantUmlBaseValue="accountIdentity" id="mb_4"><mxCell style="text;html=1;align=left;verticalAlign=middle;spacingLeft=30;spacingRight=4;overflow=visible;rotatable=0;fillColor=none;strokeColor=none;fontSize=14;fontColor=#000000;fontStyle=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;fontFamily=Arial;" vertex="1" parent="cls_3">
