<mxGeometry as="geometry" x="1160" y="235" width="150" height="60" /></mxCell></UserObject><UserObject id="label_t_24" label="Bản sửa là revision mới; bản này giữ nguyên"><mxCell vertex="1" parent="plantuml-5" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;"><mxGeometry as="geometry" x="890" y="315" width="300" height="70" /></mxCell></UserObject><UserObject id="label_t_25" label="Replacement publish thành công"><mxCell vertex="1" parent="plantuml-5" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;"><mxGeometry as="geometry" x="945" y="440" width="250" height="60" /></mxCell></UserObject><UserObject id="label_t_26" label="Admin withdraw"><mxCell vertex="1" parent="plantuml-5" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;"><mxGeometry as="geometry" x="1250" y="445" width="180" height="55" /></mxCell></UserObject><UserObject id="label_t_27" label="System assembly đủ submitted sources theo blueprint"><mxCell vertex="1" parent="plantuml-5" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;"><mxGeometry as="geometry" x="85" y="1040" width="245" height="85" /></mxCell></UserObject><UserObject id="label_t_28" label="Admin feedback item/toàn version → source Lessons"><mxCell vertex="1" parent="plantuml-5" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;"><mxGeometry as="geometry" x="505" y="1100" width="250" height="65" /></mxCell></UserObject><UserObject id="label_t_29" label="Giữ version; nguồn sửa/nộp lại tạo successor A_REVIEW mới"><mxCell vertex="1" parent="plantuml-5" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;"><mxGeometry as="geometry" x="535" y="1400" width="300" height="100" /></mxCell></UserObject><UserObject id="label_t_30" label="Admin approve đúng version/readiness"><mxCell vertex="1" parent="plantuml-5" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;"><mxGeometry as="geometry" x="630" y="1035" width="200" height="70" /></mxCell></UserObject><UserObject id="label_t_31" label="Admin publish thành công"><mxCell vertex="1" parent="plantuml-5" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;"><mxGeometry as="geometry" x="1085" y="1035" width="210" height="65" /></mxCell></UserObject><UserObject id="label_t_32" label="Nguồn sửa → version mới; attempt vẫn pin version này"><mxCell vertex="1" parent="plantuml-5" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;"><mxGeometry as="geometry" x="890" y="1120" width="300" height="80" /></mxCell></UserObject><UserObject id="label_t_33" label="Successor publish thành công"><mxCell vertex="1" parent="plantuml-5" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;"><mxGeometry as="geometry" x="945" y="1340" width="250" height="70" /></mxCell></UserObject><UserObject id="label_t_34" label="Admin withdraw"><mxCell vertex="1" parent="plantuml-5" style="text;html=1;whiteSpace=wrap;overflow=visible;fontSize=14;fontFamily=Arial;fillColor=#FFFFFF;strokeColor=none;align=center;verticalAlign=middle;"><mxGeometry as="geometry" x="1250" y="1340" width="180" height="65" /></mxCell></UserObject></