 Admin cannot author content, bypass approval or edit learner evidence.\n' One responsible Teacher per Lesson package; reassignment preserves attribution/history.\n' Support reads necessary identity/status/minimal context summary; account actions audited.\n' Assessment publication requires readiness/review/approval; immutable version pins attempts.\n' Published revision replacement is atomic; privileged actions emit security audit events.\nleft to right direction\ntitle S\u01a1 \u0111\u1ed3 Use Case c\u1ee7a Qu\u1ea3n tr\u1ecb vi\u00ean\n\nactor \&quot;Qu\u1ea3n tr\u1ecb vi\u00ean\&quot; as Admin\nrectangle \&quot;H\u1ec6 TH\u1ed0NG H\u1eccC NGO\u1ea0I NG\u1eee LINGORA\&quot; {\n  package \&quot;T\u00e0i kho\u1ea3n v\u00e0 v\u1eadn h\u00e0nh\&quot; {\n    usecase \&quot;Qu\u1ea3n l\u00fd h\u1ed3 s\u01a1 c\u00e1 nh\u00e2n\&quot; as Profile\n    usecase \&quot;Qu\u1ea3n l\u00fd t\u00e0i kho\u1ea3n h\u1ecdc vi\u00ean, gi\u00e1o vi\u00ean\&quot; as Accounts\n    usecase \&quot;Xem b\u00e1o c\u00e1o v\u00e0 nh\u1eadt k\u00fd\&quot; as Audit\n    usecase \&quot;\u0110\u0103ng nh\u1eadp / X\u00e1c th\u1ef1c\&quot; as Login\n  }\n  package \&quot;\u0110\u1ec1 c\u01b0\u01a1ng v\u00e0 ph\u00e2n c\u00f4ng\&quot; {\n    usecase \&quot;Qu\u1ea3n l\u00fd c\u1ea5u tr\u00fac v\u00e0 c\u1ea5u h\u00ecnh kh\u00f3a h\u1ecdc\&quot; as Curriculum\n    usecase \&quot;L\u1eadp \u0111\u1ec1 c\u01b0\u01a1ng b\u00e0i \u0111\u00e1nh gi\u00e1\&quot; as Blueprint\n    usecase \&quot;Ph\u00e2n c\u00f4ng v\u00e0 ph\u00e2n c\u00f4ng l\u1ea1i\&quot; as Assign\n  }\n  package \&quot;Th\u1ea9m \u0111\u1ecbnh v\u00e0 xu\u1ea5t b\u1ea3n\&quot; {\n    usecase \&quot;Th\u1ea9m \u0111\u1ecbnh n\u1ed9i dung \u0111\u00e3 n\u1ed9p\&quot; as Review\n    usecase \&quot;Y\u00eau c\u1ea7u ch\u1ec9nh s\u1eeda\&quot; as Changes\n    usecase \&quot;Ph\u00ea duy\u1ec7t n\u1ed9i dung\&quot; as Approve\n    usecase \&quot;Xu\u1ea5t b\u1ea3n b\u00e0i h\u1ecdc \u0111\u00e3 duy\u1ec7t\&quot; as Publish\n    usecase \&quot;Xu\u1ea5t b\u1ea3n phi\u00ean b\u1ea3n \u0111\u00e1nh gi\u00e1 \u0111\u00e3 duy\u1ec7t\&quot; as Assessment\n    usecase \&quot;L\u01b0u tr\u1eef ho\u1eb7c thu h\u1ed3i n\u1ed9i dung\&quot; as Archive\n  }\n}\nAdmin -- Profile\nAdmin -- Accounts\nAdmin -- Audit\nAdmin -- Login\nAdmin -- Curriculum\nAdmin -- Blueprint\nAdmin -- Assign\nAdmin -- Review\nAdmin -- Changes\nAdmin -- Approve\nAdmin -- Publish\nAdmin -- Assessment\nAdmin -- Archive\n\nProfile ..&gt; Login : &lt;&lt;include&gt;&gt;\nAccounts ..&gt; Login : &lt;&lt;include&gt;&gt;\nAudit ..&gt; Login : &lt;&lt;include&gt;&gt;\nCurriculum ..&gt; Login : &lt;&lt;include&gt;&gt;\nBlueprint ..&gt; Login : &lt;&lt;include&gt;&gt;\nAssign ..&gt; Login : &lt;&lt;include&gt;&gt;\nReview ..&gt; Login : &lt;&lt;include&gt;&gt;\nChanges ..&gt; Login : &lt;&lt;include&gt;&gt;\nApprove ..&gt; Login : &lt;&lt;include&gt;&gt;\nPublish ..&gt; Login : &lt;&lt;include&gt;&gt;\nAssessment ..&gt; Login : &lt;&lt;include&gt;&gt;\nArchive ..&gt; Login : &lt;&lt;include&gt;&gt;\n@enduml\n&quot;, &quot;config&quot;: null}">
