        <UserObject id="2" label="" plantUmlData="{&quot;data&quot;: &quot;@startuml\n' Shared academic presentation; identities and authority belong in comments/index.\nskinparam monochrome true\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 14\nskinparam defaultFontColor black\nskinparam titleFontSize 18\nskinparam titleFontColor black\nskinparam ArrowColor black\nskinparam ArrowThickness 1\nskinparam roundCorner 0\nskinparam nodesep 35\nskinparam ranksep 45\nskinparam ActorBackgroundColor white\nskinparam ActorBorderColor black\nskinparam ParticipantBackgroundColor white\nskinparam ParticipantBorderColor black\nskinparam ControlBackgroundColor white\nskinparam BoundaryBackgroundColor white\nskinparam DatabaseBackgroundColor white\nskinparam ClassBackgroundColor white\nskinparam ClassBorderColor black\nskinparam ClassHeaderBackgroundColor white\nskinparam EntityBackgroundColor white\nskinparam EntityBorderColor black\nskinparam ActivityBackgroundColor white\nskinparam ActivityBorderColor black\nskinparam ActivityDiamondBackgroundColor white\nskinparam ActivityDiamondBorderColor black\nskinparam StateBackgroundColor white\nskinparam StateBorderColor black\nskinparam PackageBackgroundColor white\nskinparam PackageBorderColor #555555\nskinparam RectangleBackgroundColor white\nskinparam RectangleBorderColor black\nskinparam NoteBackgroundColor white\nskinparam NoteBorderColor black\nskinparam sequenceLifeLineBorderColor #555555\nskinparam sequenceGroupBackgroundColor white\nskinparam sequenceGroupBodyBackgroundColor white\n' diagram-id: DOM-01\n' classification: TARGET\n' Authority: ADR-030\u2013036. Business associations, not persisted relations.\n' Course/Language multiplicity permits future courses; MVP shared core convention is not a permanent constraint.\n' LearningPlan and Progress are derived domain concepts, not required persisted entities.\ntitle S\u01a1 \u0111\u1ed3 l\u1edbp mi\u1ec1n c\u1ee7a h\u1ec7 th\u1ed1ng Lingora\nhide circle\nhide empty members\nskinparam classAttributeIconSize 0\nskinparam nodesep 30\nskinparam ranksep 45\n\n class User {\n  role: Admin | Teacher | Learner\n  status: AccountStatus\n }\n class Profile {\n  timezone: TimeZone\n  streak: Integer\n }\n class LearningContext {\n  status: ACTIVE | PAUSED\n  startingPoint: Level\n  purpose: LearningPurpose\n }\n class LearningPlan &lt;&lt;derived&gt;&gt; {\n  orderedLessons: Lesson[*]\n }\n class Progress &lt;&lt;derived&gt;&gt; {\n  completedEligible / eligibleRequired\n }\n User \&quot;1\&quot; *-- \&quot;1\&quot; Profile\n User \&quot;1\&quot; -- \&quot;0..*\&quot; LearningContext : s\u1edf h\u1eefu\n LearningContext \&quot;1\&quot; -- \&quot;0..1\&quot; LearningPlan : x\u00e1c \u0111\u1ecbnh\n LearningContext \&quot;1\&quot; -- \&quot;0..*\&quot; Progress : theo d\u00f5i theo c\u1ea5p\n class Language {\n  name: Text\n }\n class ProficiencyFramework {\n  name: Text\n  version: Text\n }\n class Level {\n  label: Text\n }\n class Course\n class LogicalUnit\n class Lesson {\n  required: Boolean\n  availability: CurriculumAvailability\n }\n class Exercise {\n  type: ExerciseType\n  core: Boolean\n }\n class Vocabulary\n Language \&quot;1\&quot; -- \&quot;0..*\&quot; Course : c\u00f3 ch\u01b0\u01a1ng tr\u00ecnh\n ProficiencyFramework \&quot;1\&quot; -- \&quot;1..*\&quot; Level : \u0111\u1ecbnh ngh\u0129a\n Course \&quot;1\&quot; *-- \&quot;0..*\&quot; LogicalUnit\n LogicalUnit \&quot;1\&quot; *-- \&quot;0..*\&quot; Lesson\n Lesson \&quot;0..*\&quot; -- \&quot;0..*\&quot; Vocabulary : t\u1eeb c\u1ed1t l\u00f5i / t\u00f9y ch\u1ecdn\n class LessonAttempt {\n  performance: Percentage\n  completed: Boolean\n }\n class SrsCard {\n  stage: Integer\n  dueAt: DateTime\n }\n class AssessmentBlueprint {\n  purpose: Placement | LevelUp\n }\n class AssessmentVersion {\n  published: Boolean\n }\n class AssessmentResult {\n  recommendationOrOutcome: Result\n }\n LearningContext \&quot;1\&quot; -- \&quot;0..*\&quot; LessonAttempt : th\u1ef1c hi\u1ec7n\n LessonAttempt \&quot;0..*\&quot; -- \&quot;1\&quot; Lesson : h\u1ecdc / l\u00e0m l\u1ea1i\n User \&quot;1\&quot; -- \&quot;0..*\&quot; SrsCard : \u00f4n t\u1eadp\n SrsCard \&quot;0..*\&quot; -- \&quot;1\&quot; Vocabulary : ghi nh\u1edb\n AssessmentBlueprint \&quot;1\&quot; -- \&quot;0..*\&quot; AssessmentVersion : c\u00f3 phi\u00ean b\u1ea3n\n AssessmentVersion \&quot;1\&quot; -- \&quot;0..*\&quot; AssessmentResult : cung c\u1ea5p b\u1eb1ng ch\u1ee9ng\n LearningContext \&quot;1\&quot; -- \&quot;0..*\&quot; AssessmentResult : nh\u1eadn k\u1ebft qu\u1ea3\n class Assignment\n class ContentRevision {\n  status: ContentStatus\n }\n class AssessmentItem\n class SecurityAuditEvent {\n  action: Text\n  outcome: Text\n }\n Assignment \&quot;0..*\&quot; -- \&quot;1\&quot; User : gi\u00e1o vi\u00ean ph\u1ee5 tr\u00e1ch\n Assignment \&quot;0..*\&quot; -- \&quot;1\&quot; Lesson : g\u00f3i n\u1ed9i dung\n Lesson \&quot;1\&quot; *-- \&quot;1..*\&quot; ContentRevision\n ContentRevision \&quot;1\&quot; *-- \&quot;0..*\&quot; Exercise\n AssessmentVersion \&quot;1\&quot; *-- \&quot;1..*\&quot; AssessmentItem\n User \&quot;1\&quot; -- \&quot;0..*\&quot; SecurityAuditEvent : th\u1ef1c hi\u1ec7n h\u00e0nh \u0111\u1ed9ng\nLearningContext \&quot;0..*\&quot; -- \&quot;1\&quot; Language : ng\u00f4n ng\u1eef h\u1ecdc\nLogicalUnit \&quot;0..*\&quot; -- \&quot;1\&quot; Level : nh\u00f3m theo c\u1ea5p\n' Rules kept in captions/index: context uniqueness/two ACTIVE, no score gate,\n' one retry, SRS recurrence, immutability and retained attribution/history.\n' No persistence identity, FK, SQL datatype or index is selected.\n@enduml\n&quot;, &quot;config&quot;: null}">
