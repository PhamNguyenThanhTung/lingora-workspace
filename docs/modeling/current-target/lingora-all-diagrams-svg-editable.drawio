        <UserObject id="2" label="" plantUmlData="{&quot;data&quot;: &quot;@startuml\n' Shared academic presentation; identities and authority belong in comments/index.\nskinparam monochrome true\nskinparam backgroundColor white\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 14\nskinparam defaultFontColor black\nskinparam titleFontSize 18\nskinparam titleFontColor black\nskinparam ArrowColor black\nskinparam ArrowThickness 1\nskinparam roundCorner 0\nskinparam nodesep 35\nskinparam ranksep 45\nskinparam ActorBackgroundColor white\nskinparam ActorBorderColor black\nskinparam ParticipantBackgroundColor white\nskinparam ParticipantBorderColor black\nskinparam ControlBackgroundColor white\nskinparam BoundaryBackgroundColor white\nskinparam DatabaseBackgroundColor white\nskinparam ClassBackgroundColor white\nskinparam ClassBorderColor black\nskinparam ClassHeaderBackgroundColor white\nskinparam EntityBackgroundColor white\nskinparam EntityBorderColor black\nskinparam ActivityBackgroundColor white\nskinparam ActivityBorderColor black\nskinparam ActivityDiamondBackgroundColor white\nskinparam ActivityDiamondBorderColor black\nskinparam StateBackgroundColor white\nskinparam StateBorderColor black\nskinparam PackageBackgroundColor white\nskinparam PackageBorderColor #555555\nskinparam RectangleBackgroundColor white\nskinparam RectangleBorderColor black\nskinparam NoteBackgroundColor white\nskinparam NoteBorderColor black\nskinparam sequenceLifeLineBorderColor #555555\nskinparam sequenceGroupBackgroundColor white\nskinparam sequenceGroupBodyBackgroundColor white\n' diagram-id: DATA-03\n' classification: TARGET\n' Logical identifiers/reference fields below are symbolic, not approved physical columns/keys.\n' Authority ADR-030\u2013036. Relation grouping and separate response/binding/history records\n' express persistence requirements without mandating one SQL table per drawn entity.\ntitle S\u01a1 \u0111\u1ed3 quan h\u1ec7 d\u1eef li\u1ec7u logic c\u1ee7a Lingora\nhide circle\nskinparam nodesep 35\nskinparam ranksep 50\n\n entity \&quot;AccountRecord\&quot; as Account {\n  * accountIdentity\n  --\n  role; accountStatus\n  locale; timezone; streak\n }\n entity \&quot;ContextRecord\&quot; as Context {\n  * accountIdentity + learnedLanguage\n  --\n  status; purpose; studyPreferences\n  startingPoint; provenance; selfReport\n }\n entity \&quot;LessonAttemptRecord\&quot; as Attempt {\n  * attemptIdentity\n  --\n  contextRef; lessonRevisionRef\n  contributionSum; responseCount\n  completedAt\n }\n entity \&quot;ExerciseResponseRecord\&quot; as Response {\n  * attemptRef + exerciseRef + responseOrder\n  --\n  firstOrRetry; contribution\n }\n entity \&quot;CompletionRecord\&quot; as Completion {\n  * contextRef + lessonRef\n  --\n  completedAt; attemptProvenance\n }\n Account ||--o{ Context\n Context ||--o{ Attempt\n Attempt ||--o{ Response\n Context ||--o{ Completion\n Completion |o--|| Attempt : ngu\u1ed3n ho\u00e0n th\u00e0nh\n entity \&quot;CurriculumReference\&quot; as Curriculum {\n  * curriculumPositionIdentity\n  --\n  language; framework; version\n  level; course; unit\n  ordering; eligibility\n }\n entity \&quot;LessonRecord\&quot; as Lesson {\n  * lessonIdentity\n  --\n  curriculumRef; required; activeRevisionRef\n }\n entity \&quot;RevisionRecord\&quot; as Revision {\n  * revisionIdentity\n  --\n  lessonRef; priorRevisionRef; lifecycle\n  attribution; reviewHistory\n  concurrencyVersion\n }\n entity \&quot;ExerciseRecord\&quot; as Exercise {\n  * revisionRef + exerciseIdentity\n  --\n  order; type; core\n  learnerPayload; protectedGradingData\n }\n entity \&quot;VocabularyRecord\&quot; as Vocabulary {\n  * language + vocabularyIdentity\n }\n entity \&quot;LessonVocabularyLink\&quot; as LessonVocabulary {\n  * lessonRef + vocabularyRef\n  --\n  coreOrOptional\n }\n Curriculum ||--o{ Lesson\n Lesson ||--|{ Revision\n Revision ||--o{ Exercise\n Lesson ||--o{ LessonVocabulary\n Vocabulary ||--o{ LessonVocabulary\n entity \&quot;SrsCardRecord\&quot; as Card {\n  * accountRef + vocabularyRef\n  --\n  enrollmentSource; stage; dueAt\n }\n entity \&quot;SrsOperationRecord\&quot; as Review {\n  * reviewOperationIdentity\n  --\n  cardRef; selfRating; serverTime\n  scheduleOutcome; idempotencyIdentity\n }\n Card ||--o{ Review\n entity \&quot;BlueprintRecord\&quot; as Blueprint {\n  * blueprintIdentity\n  --\n  purpose; curriculumRef; coverage\n  itemRequirements; assessmentConfiguration\n }\n entity \&quot;AssessmentVersionRecord\&quot; as Version {\n  * assessmentVersionIdentity\n  --\n  blueprintRef; approvedSnapshot\n  rubricSnapshot\n }\n entity \&quot;VersionItemRecord\&quot; as Item {\n  * assessmentVersionRef + itemIdentity\n  --\n  contentSnapshot; protectedGradingData\n  practiceExposureEligibility\n }\n entity \&quot;AssessmentAttemptRecord\&quot; as AssessmentAttempt {\n  * assessmentAttemptIdentity\n  --\n  contextRef; pinnedVersionRef\n  purpose\n  submissionIdentity\n }\n entity \&quot;AssessmentResultRecord\&quot; as Result {\n  * assessmentAttemptRef\n  --\n  aggregateOutcome; recommendation\n  assessmentType; deliveryMode; completedAt\n }\n entity \&quot;AssignmentRecord\&quot; as Assignment {\n  * assignmentIdentity\n  --\n  lessonRef; blueprintRef; currentTeacherRef\n }\n entity \&quot;AssignmentHistoryRecord\&quot; as History {\n  * assignmentRef + historyIdentity\n  --\n  previousTeacher; nextTeacher\n  authorAttribution\n }\n entity \&quot;SecurityAuditRecord\&quot; as Audit {\n  * auditEventIdentity\n  --\n  actorRef; action\n  targetVersionRef\n  serverTime; outcome; reason\n }\n Blueprint ||--o{ Version\n Version ||--|{ Item\n Version ||--o{ AssessmentAttempt\n AssessmentAttempt ||--o| Result\n Assignment ||--o{ History\nAccount ||--o{ Card\nVocabulary ||--o{ Card\nContext ||--o{ AssessmentAttempt\nLesson ||--o{ Assignment\nAccount ||--o{ Audit\nBlueprint -[hidden]down- Account\nAssignment -[hidden]right- Revision\n' References without drawn joins: attempt\u2192revision, completion\u2192lesson, assignment\u2192teacher/blueprint.\n' CurriculumReference groups approved curriculum concepts; not a physical denormalization decision.\n' Completion and latest completed performance remain distinct; history survives withdrawal/replacement.\n' No Enrollment, persisted LearningPlan, SkillProfile or mastery store required.\n@enduml\n&quot;, &quot;config&quot;: null}">
