@startuml
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
title Sequence Diagram - UC-01 Authenticate & Manage Session

actor "Learner / Admin" as User
participant Browser
participant "Next.js App" as Next
participant "Supabase Auth" as Auth
database "PostgreSQL DB" as DB

User -> Browser: Nhập thông tin đăng nhập/đăng ký
Browser -> Next: Gửi biểu mẫu xác thực
Next -> Auth: Xác thực thông tin tài khoản
alt Thông tin hợp lệ
  Auth --> Next: Trả về Session (Access Token & Refresh Token)
  Next -> Browser: Thiết lập cookie phiên httpOnly
  opt Đăng ký tài khoản mới
    Auth -> DB: Kích hoạt Trigger auth.users
    DB -> DB: Tạo bản ghi Profile tương ứng
  end
  Next --> Browser: Chuyển hướng tới trang phù hợp theo vai trò (Role)
else Thông tin không hợp lệ
  Auth --> Next: Báo lỗi xác thực
  Next --> Browser: Hiển thị thông báo lỗi an toàn
end
@enduml
