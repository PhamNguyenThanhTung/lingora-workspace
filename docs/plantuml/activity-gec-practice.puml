@startuml
title Biểu đồ hoạt động - UC-06 Luyện viết tình huống với GEC nội bộ
skinparam shadowing false
start
:Chọn kịch bản đã xuất bản;
:Hiển thị câu gợi ý (prompt) tiếp theo theo thứ tự;
:Chọn phương thức nhập;
if (Nhập văn bản?) then (gõ)
  :Nhập văn bản tiếng Anh có giới hạn trong ô soạn thảo;
else (nói)
  :Bật microphone và SpeechRecognition;
  if (Browser API và quyền khả dụng?) then (có)
    :Chuyển giọng nói thành văn bản trong ô soạn thảo;
    :Kiểm tra hoặc chỉnh sửa bản chép lời;
  else (không)
    :Hiển thị cảnh báo không chặn luồng;
    :Chuyển về nhập văn bản;
  endif
endif
if (Đầu vào hợp lệ?) then (có)
  :POST original_text + scenario_code tới Next.js /api/ai/gec;
  :Gọi thành phần FastAPI nội bộ /v1/gec/correct;
  if (Model khả dụng?) then (có)
    :T5-small sinh corrected_text;
    :Căn chỉnh xác định tạo phần sai khác (diff);
    :Hiển thị câu gốc/câu sửa dưới dạng văn bản an toàn;
    :Tùy chọn phát câu sửa bằng speechSynthesis;
    if (Còn prompt?) then (có)
      :Chuyển sang trạng thái kịch bản tiếp theo;
    else (không)
      :Hoàn thành bài luyện;
    endif
  else (không)
    :Hiển thị trạng thái MODEL_UNAVAILABLE có thể phục hồi;
  endif
else (không)
  :Hiển thị lỗi kiểm tra đầu vào;
endif
stop
@enduml
