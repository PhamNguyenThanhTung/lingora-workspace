@startuml
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
title Sơ đồ Luồng Dữ liệu Mức 1 (DFD Level 1) - Tiến trình 4.0: Ôn tập Spaced Repetition (SRS)
skinparam roundCorner 10
skinparam defaultFontName Arial

' ==========================================
' TÁC NHÂN NGOÀI (EXTERNAL ENTITY)
' ==========================================
rectangle "Học viên\n(Learner)" as Learner #EEF2FF

' ==========================================
' CÁC TIẾN TRÌNH CON (SUB-PROCESSES)
' ==========================================
usecase "4.1\nTruy vấn thẻ\nSRS đến hạn" as P41 #FAF5FF
usecase "4.2\nHiển thị thẻ &\nNội dung từ vựng" as P42 #FAF5FF
usecase "4.3\nThu thập &\nXác thực đánh giá" as P43 #FAF5FF
usecase "4.4\nTính toán SM-2 &\nGhi giao dịch" as P44 #FAF5FF

' ==========================================
' KHO DỮ LIỆU LIÊN QUAN (DATA STORES)
' ==========================================
database "D2: Kho từ vựng\n(Vocabularies)" as D2 #F8FAFC
database "D3: Thẻ Flashcard & SRS\n(Flashcards, UserVocabSrs)" as D3 #F8FAFC
database "D4: Nhật ký Ôn tập\n(Immutable ReviewLogs)" as D4 #F8FAFC

' ==========================================
' LUỒNG DỮ LIỆU (DATA FLOWS)
' ==========================================
Learner --> P41 : [DF-41] Yêu cầu mở phiên ôn tập
D3 --> P41 : [DF-42] Trả về danh sách thẻ đến hạn (next_review_at <= now)
P41 --> P42 : [DF-43] Danh sách ID từ vựng cần ôn
D2 --> P42 : [DF-44] Lấy từ vựng, nghĩa, ví dụ & audio
P42 --> Learner : [DF-45] Hiển thị thẻ Flashcard (mặt trước / mặt sau)
Learner --> P43 : [DF-46] Đánh giá khả năng nhớ (Again, Hard, Good, Easy)
P43 --> P44 : [DF-47] Tham số đánh giá & ID người dùng
P44 --> D4 : [DF-48] Ghi bản ghi ReviewLog bất biến
P44 --> D3 : [DF-49] Cập nhật interval, ease_factor & next_review_at
D3 --> P44 : [DF-50] Xác nhận cập nhật giao dịch thành công
P44 --> Learner : [DF-51] Kết quả ôn tập & Thời gian ôn tập tiếp theo
@enduml
