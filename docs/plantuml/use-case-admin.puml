@startuml
title LINGORA - Admin Use Cases
left to right direction
skinparam shadowing false

rectangle "LINGORA Web Learning System" {
  usecase "UC-01\nAuthentication & Session" as UC01
  usecase "UC-04\nContent Administration" as UC04

  usecase "Manage courses and lessons" as ManageLessons
  usecase "Manage vocabulary and exercises" as ManageExercises
  usecase "Manage scenarios" as ManageScenarios
  usecase "Upload approved media" as UploadMedia
  usecase "Publish / unpublish content" as Publish
}

actor Admin

UC01 -- Admin
UC04 -- Admin

UC04 ..> ManageLessons : <<include>>
UC04 ..> ManageExercises : <<include>>
UC04 ..> ManageScenarios : <<include>>
UC04 ..> UploadMedia : <<include>>
UC04 ..> Publish : <<include>>

note left of UploadMedia
  MIME, size and RLS validation
end note
@enduml
