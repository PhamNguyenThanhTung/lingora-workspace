@startuml
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
title LINGORA - UC-06 Scenario Writing and Grammar Check
left to right direction
actor Learner
rectangle "Lingora Web Learning System" {
  usecase "UC-06\nScenario Writing and Grammar Check" as UC06
  usecase "Select Writing Prompt" as Prompt
  usecase "Submit Written Sentence" as Submit
  usecase "Check Sentence by Rules" as Check
  usecase "View Correction Feedback" as Feedback
}
Learner -- UC06
UC06 ..> Prompt : <<include>>
UC06 ..> Submit : <<include>>
UC06 ..> Check : <<include>>
UC06 ..> Feedback : <<include>>
@enduml
