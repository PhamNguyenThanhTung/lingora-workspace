@startuml
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
title Sơ đồ Luồng Dữ liệu Mức 1 (DFD Level 1) - Tiến trình 3.0: Học bài học & Làm bài tập tương tác
skinparam roundCorner 10
skinparam defaultFontName Arial

' ==========================================
' TÁC NHÂN NGOÀI (EXTERNAL ENTITY)
' ==========================================
rectangle "Học viên\n(Learner)" as Learner #EEF2FF

' ==========================================
' CÁC TIẾN TRÌNH CON (SUB-PROCESSES)
' ==========================================
usecase "3.1\nTruy xuất bài học\nđã xuất bản" as P31 #FAF5FF
usecase "3.2\nHiển thị từ vựng\nvà phát âm audio" as P32 #FAF5FF
usecase "3.3\nTiếp nhận &\nChấm điểm bài tập" as P33 #FAF5FF
usecase "3.4\nTổng kết điểm &\nCập nhật tiến độ" as P34 #FAF5FF

' ==========================================
' KHO DỮ LIỆU LIÊN QUAN (DATA STORES)
' ==========================================
database "D2.1: Khóa học & Bài học\n(Courses, Units, Lessons)" as D21 #F8FAFC
database "D2.2: Ngân hàng Bài tập\n(Exercises, Vocabularies)" as D22 #F8FAFC
database "D6: Tiến độ & Điểm số\n(UserLessonProgress)" as D6 #F8FAFC

' ==========================================
' LUỒNG DỮ LIỆU (DATA FLOWS)
' ==========================================
Learner --> P31 : [DF-31] Chọn khóa học & bài học
D21 --> P31 : [DF-32] Danh sách bài học và cấu trúc chương
P31 --> P32 : [DF-33] Danh sách từ vựng theo bài
D22 --> P32 : [DF-34] File audio, nghĩa và câu ví dụ
P32 --> Learner : [DF-35] Hiển thị thẻ từ vựng & phát âm
P31 --> P33 : [DF-36] Danh sách câu hỏi bài tập tương tác
D22 --> P33 : [DF-37] Đáp án chuẩn & cấu hình bài tập
Learner --> P33 : [DF-38] Gửi đáp án bài làm (MCQ, Fill, Reorder)
P33 --> Learner : [DF-39] Phản hồi đúng/sai tức thì
P33 --> P34 : [DF-40] Kết quả bài làm chi tiết
P34 --> D6 : [DF-41] Lưu % hoàn thành bài học & điểm số
P34 --> Learner : [DF-42] Tổng kết kết quả bài học
@enduml
