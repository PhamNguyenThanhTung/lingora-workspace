@startuml
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8

title Sơ đồ Kiến trúc Hệ thống (System Architecture Diagram) - Nền tảng Lingora

package "1. Tầng Trình diễn (Presentation / Client)" #EEF2FF {
  [Ứng dụng Học viên\n(Next.js App Router Client)] as ClientApp
  [Cổng Quản trị CMS\n(React / Next.js Admin UI)] as AdminPortal
  [Trình duyệt Web Speech API\n(Audio & Speech Playback/Input)] as WebSpeech
}

package "2. Tầng Ứng dụng & BFF (Next.js Server)" #E0F2FE {
  [Next.js Server Actions & Route Handlers] as BFF
  [Bộ kiểm tra Phiên & Phân quyền SSR] as AuthGuard
  [Mô-đun Kiểm tra Ngữ pháp Nội bộ] as GrammarService
}

package "3. Tầng Dịch vụ Dữ liệu (Supabase BaaS)" #DCFCE7 {
  [Supabase Auth (JWT & GoTrue)] as SupaAuth
  [PostgREST Engine & Hàm RPC SM-2] as PostgREST
  [CSDL PostgreSQL (17 Bảng & Chính sách RLS)] as PostgresDB
  [Supabase Storage (Lưu trữ Audio Học liệu)] as SupaStorage
}

ClientApp --> BFF : HTTPS / REST / Server Actions
AdminPortal --> BFF : HTTPS / Admin CMS Actions
ClientApp ..> WebSpeech : Gọi API phát âm & ghi âm
BFF --> AuthGuard : Kiểm tra phiên đăng nhập & phân quyền
BFF --> GrammarService : Gửi câu phân tích ngữ pháp & sinh diff
AuthGuard --> SupaAuth : Xác thực JWT & Phiên bảo mật
BFF --> PostgREST : Truy vấn dữ liệu có kiểm soát chính sách RLS
PostgREST --> PostgresDB : Thực thi truy vấn SQL & hàm tính toán RPC
BFF --> SupaStorage : Upload media & stream file audio phát âm
@enduml