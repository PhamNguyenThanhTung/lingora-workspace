@startuml
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
title Activity Diagram - UC-06 Scenario Writing Practice & Grammar Check

start
:Chọn kịch bản tình huống đã xuất bản;
while (Còn câu gợi ý (prompt) trong kịch bản?) is (có)
  :Hiển thị câu gợi ý (prompt);
  repeat
    :Chọn phương thức nhập liệu;
    if (Phương thức nhập?) then (Gõ chữ)
      :Nhập câu tiếng Anh vào ô soạn thảo;
    else (Giọng nói)
      :Bật microphone và Web Speech API;
      if (Trình duyệt hỗ trợ & được cấp quyền?) then (có)
        :Chuyển giọng nói thành văn bản trong ô soạn thảo;
        :Người học rà soát và chỉnh sửa câu văn (nếu cần);
      else (không)
        :Hiển thị cảnh báo quyền microphone;
        :Nhập câu tiếng Anh trực tiếp vào ô soạn thảo;
      endif
    endif
    :Bấm nút gửi câu trả lời;
    if (Đầu vào hợp lệ (1-500 ký tự)?) then (hợp lệ)
      repeat
        :Gửi yêu cầu phân tích câu tới hệ thống;
        :Thực hiện kiểm tra ngữ pháp qua mô-đun nội bộ;
        if (Mô-đun phản hồi thành công?) then (có)
          :Sinh câu sửa chuẩn xác (corrected text);
          :Tạo phần sai khác trực quan (diff highlight);
          :Hiển thị kết quả kèm giải thích lỗi;
          :Tùy chọn nghe phát âm câu sửa (Speech Synthesis);
          break
        else (lỗi / timeout)
          :Hiển thị thông báo lỗi phân tích;
          if (Người dùng chọn Thử lại?) then (có)
            ' Quay lại gửi yêu cầu phân tích
          else (bỏ qua câu)
            :Ghi nhận trạng thái bỏ qua câu này;
            break
          endif
        endif
      repeat while (Thử lại phân tích)
      break
    else (không hợp lệ)
      :Hiển thị thông báo lỗi đầu vào (quá dài / để trống);
    endif
  repeat while (Chỉnh sửa và nhập lại)
endwhile (hết câu)

:Hoàn thành kịch bản & Lưu lịch sử bài làm;
:Cập nhật tiến độ học tập và chuỗi ngày Streak;
stop
@enduml
