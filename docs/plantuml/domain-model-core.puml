@startuml
title Lingora Core Domain Model (Implementation-Independent)
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
hide methods
hide circle

' Scope palette definitions
!define CORE_COLOR #E0F2FE
!define VOCAB_COLOR #DCFCE7
!define PROGRESS_COLOR #FAF5FF
!define GOV_COLOR #FEF3C7
!define ADAPTIVE_COLOR #EDE9FE
!define EXTENSION_COLOR #F3F4F6

legend top right
  **Ranh giới & Phạm vi Miền:**
  |<#E0F2FE>| **Core Learning Aggregate** (Course, Unit [Target], Lesson, Exercise) |
  |<#DCFCE7>| **Vocabulary & SRS Aggregate** (Language, Vocabulary, SRS Cards, Review Logs) |
  |<#FAF5FF>| **Learner Identity & Progress Aggregate** (Profile, UserProgress) |
  |<#EDE9FE>| **Assessment, Remediation & Mastery Aggregate** (LearnerProfile, SkillProfile, etc.) |
  |<#FEF3C7>| **Governance & Audit Aggregate** (AuditLog [Target]) |
  |<#F3F4F6>| **Extension Boundary (Optional / Future Migration — Outside Core MVP)** |
endlegend

package "Core Learning Aggregate (Scope: CORE)" <<Rectangle>> {
  class Course CORE_COLOR {
    + id: UUID [Applied]
    + language_code: String [Applied]
    + cefr: Cefr (A1) [Applied]
    + order_index: Integer [Applied]
    + is_published: Boolean [Applied]
    + status: ContentStatus [Target]
    + creator_id: UUID [Target]
    + reviewer_id: UUID [Target]
    + published_at: Timestamp [Target]
  }

  class Unit CORE_COLOR {
    + id: UUID [Target Schema]
    + course_id: UUID [Target Schema]
    + order_index: Integer (1..6) [Target Schema]
    + title: String [Target Schema]
    + description: String [Target Schema]
  }

  class Lesson CORE_COLOR {
    + id: UUID [Applied]
    + course_id: UUID [Applied]
    + unit_id: UUID [Target Schema]
    + order_index: Integer (1..24) [Applied]
    + is_published: Boolean [Applied]
    + status: ContentStatus [Target]
    + objective: String [Target Schema]
    + creator_id: UUID [Target]
    + reviewer_id: UUID [Target]
    + assignment_brief: String / JSON [Target Candidate]
    + supersedes_id: UUID [Target Candidate DD-02]
  }

  class Exercise CORE_COLOR {
    + id: UUID [Applied]
    + lesson_id: UUID [Applied]
    + type: ExerciseType [Applied: MCQ, FILL_BLANK, REORDER | Target: LISTENING, GRAMMAR]
    + payload: JSONB (ADR-006 payloadVersion) [Applied]
    + order_index: Integer [Applied]
  }
}

package "Vocabulary & SRS Aggregate (Scope: CORE)" <<Rectangle>> {
  class Language VOCAB_COLOR {
    + code: String (PK) [Applied]
    + name: String [Applied]
    + native_name: String [Applied]
    + is_learnable: Boolean [Applied]
    + is_ui_locale: Boolean [Applied]
  }

  class Vocabulary VOCAB_COLOR {
    + id: UUID [Applied]
    + language_code: String [Applied]
    + term: String [Applied]
    + normalized_term: String [Applied]
    + phonetic: String [Applied]
    + audio_url: String [Applied]
    + cefr: Cefr [Applied]
    + created_at: Timestamp [Applied]
    + updated_at: Timestamp [Applied]
  }

  class LessonVocabulary VOCAB_COLOR {
    + lesson_id: UUID [Applied]
    + vocabulary_id: UUID [Applied]
    + order_index: Integer [Applied]
  }

  class UserVocabSrs VOCAB_COLOR {
    + id: UUID [Applied]
    + user_id: UUID [Applied]
    + vocabulary_id: UUID [Applied]
    + ease_factor: Float [Applied]
    + interval_days: Float [Applied]
    + recall_probability: Float [Applied]
    + next_review_at: Timestamp [Applied]
    + last_reviewed_at: Timestamp [Applied]
    + review_count: Integer [Applied]
    + lapse_count: Integer [Applied]
    + created_at: Timestamp [Applied]
  }

  class ReviewLog VOCAB_COLOR {
    + id: UUID [Applied]
    + srs_card_id: UUID [Applied]
    + is_correct: Boolean [Applied]
    + interval_days: Float [Applied]
    + reviewed_at: Timestamp [Applied]
  }
}

package "Learner Identity & Progress Aggregate (Scope: CORE)" <<Rectangle>> {
  class Profile PROGRESS_COLOR {
    + id: UUID [Applied]
    + email: String [Applied]
    + display_name: String [Applied]
    + role: Role [Applied: 2 roles | Target: 6 roles]
    + assigned_roles: Role[] [Target]
    + ui_locale: String [Applied]
    + native_lang_code: String [Applied]
    + streak_count: Integer [Applied]
    + daily_goal_min: Integer [Applied]
    + timezone: String [Applied]
    + last_qualifying_activity_date: Date [Applied]
    + starting_unit: Integer (1..6) [Target Candidate DD-06]
    + placement_history: JSONB [Target Candidate DD-06]
  }

  class UserProgress PROGRESS_COLOR {
    + id: UUID [Applied]
    + user_id: UUID [Applied]
    + lesson_id: UUID [Applied]
    + status: ProgressStatus [Applied]
    + score: Integer [Applied]
    + completed_at: Timestamp [Applied]
    + updated_at: Timestamp [Applied]
  }

  class LearningProgress PROGRESS_COLOR {
    + id: UUID [Target Schema]
    + user_id: UUID [Target Schema]
    + course_id: UUID [Target Schema]
    + completed_content_ratio: Float [Target Schema]
    + last_accessed_at: Timestamp [Target Schema]
    + updated_at: Timestamp [Target Schema]
  }
}

package "Governance & Audit Aggregate (Scope: CORE)" <<Rectangle>> {
  class AuditLog GOV_COLOR {
    + id: UUID [Target Schema]
    + actor_id: UUID [Target Schema]
    + action: String [Target Schema]
    + entity_type: String [Target Schema]
    + entity_id: UUID [Target Schema]
    + metadata: JSONB [Target Schema]
    + created_at: Timestamp [Target Schema]
  }
}

package "Learning Assessment, Remediation & Mastery Aggregate (Scope: CORE)" <<Rectangle>> {
  class LearnerProfile ADAPTIVE_COLOR {
    + id: UUID [Target]
    + user_id: UUID [Target]
    + target_language: String [Target]
    + learning_goal: String [Target]
    + self_reported_level: String [Target]
    + verified_proficiency: String [Target]
  }

  class SkillProfile ADAPTIVE_COLOR {
    + id: UUID [Target]
    + user_id: UUID [Target]
    + vocabulary_level: String [Target]
    + grammar_level: String [Target]
    + reading_level: String [Target]
    + listening_level: String [Target]
    + anchor_level: String [Pending Validation]
    + radar_data: JSONB [Target]
    + source_assessment_result_id: UUID [Target, Nullable]
  }

  class AssessmentResult ADAPTIVE_COLOR {
    + id: UUID [Target]
    + user_id: UUID [Target]
    + assessment_type: String [Target]
    + delivery_mode: String [Target]
    + dimensions: JSONB [Target]
    + raw_scores: JSONB [Target]
    + stage_data: JSONB [Target]
    + language_config: JSONB [Target]
    + completed_at: Timestamp [Target]
  }

  class Concept ADAPTIVE_COLOR {
    + id: UUID [Target]
    + code: String [Target]
    + domain: String [VOCABULARY, GRAMMAR, READING, LISTENING, PRONUNCIATION]
    + language_code: String [Target]
    + name: String [Target]
    + description: String [Target]
    + cefr_level: String [Target]
    + prerequisite_concept_id: UUID [Target, Nullable]
    + is_active: Boolean [Target]
  }

  class ConceptMastery ADAPTIVE_COLOR {
    + id: UUID [Target]
    + user_id: UUID [Target]
    + concept_id: UUID [Target]
    + mastery_state: String [Target]
    + evidence_count: Integer [Target]
    + last_assessed_at: Timestamp [Target]
  }

  class KnowledgeGap ADAPTIVE_COLOR {
    + id: UUID [Target]
    + user_id: UUID [Target]
    + concept_id: UUID [Target]
    + gap_severity: String [Target]
    + detected_at: Timestamp [Target]
    + resolved_at: Timestamp [Target]
  }

  class LevelReadiness ADAPTIVE_COLOR {
    + id: UUID [Target]
    + user_id: UUID [Target]
    + current_level: String [Target]
    + target_level: String [Target]
    + readiness_status: String [ADVANCE, ADVANCE_WITH_SUPPORT, REMEDIATE]
    + evidence_summary: JSONB [Target]
    + evaluated_at: Timestamp [Target]
  }

  class RemedialModule ADAPTIVE_COLOR {
    + id: UUID [Target]
    + concept_id: UUID [Target]
    + unit_id: UUID [Target]
    + creator_id: UUID [Target]
    + status: ContentStatus [Target]
    + reviewer_id: UUID [Target]
    + published_at: Timestamp [Target]
    + version: Integer [Target]
    + remedial_type: String [Target]
    + content_payload: JSONB [Target]
    + created_at: Timestamp [Target]
  }

  class Recommendation ADAPTIVE_COLOR {
    + id: UUID [Target]
    + user_id: UUID [Target]
    + recommendation_type: String [Target]
    + target_unit_id: UUID [Target]
    + remedial_module_id: UUID [Target]
    + rationale: String [Target]
    + input_snapshot: JSONB [Target]
    + rule_version: String [Target]
    + generated_at: Timestamp [Target]
  }
}

package "Extension Boundary (Scope: EXTENSION | Status: FUTURE_MIGRATION — Outside Core MVP)" <<Cloud>> EXTENSION_COLOR {
  class Cohort EXTENSION_COLOR {
    + id: UUID [Future]
    + name: String [Future]
    + manager_id: UUID [Future]
  }

  class CohortMember EXTENSION_COLOR {
    + cohort_id: UUID [Future]
    + user_id: UUID [Future]
    + role: String [Future]
  }

  class SupportTicket EXTENSION_COLOR {
    + id: UUID [Future]
    + user_id: UUID [Future]
    + assigned_to: UUID [Future]
    + status: String [Future]
  }
}

' Core Relationships
Language "1" *-- "0..*" Course
Course "1" *-- "1..*" Unit : contains [Target]
Course "1" *-- "1..*" Lesson : direct [Applied]
Unit "1" *-- "1..*" Lesson : contains [Target]
Lesson "1" *-- "1..*" Exercise : contains
Language "1" *-- "0..*" Vocabulary
Lesson "1" o-- "0..*" LessonVocabulary
Vocabulary "1" o-- "0..*" LessonVocabulary

Profile "1" -- "0..*" UserProgress
Lesson "1" -- "0..*" UserProgress
Profile "1" -- "0..*" UserVocabSrs
Vocabulary "1" -- "0..*" UserVocabSrs
UserVocabSrs "1" *-- "0..*" ReviewLog

Profile "1" -- "0..*" AuditLog : triggers [Target]
Lesson "0..1" -- "0..1" Lesson : supersedes [Target Candidate]

Profile "1" -- "1" LearnerProfile : manages [Target]
LearnerProfile "1" -- "0..1" SkillProfile : outputs [Target]
LearnerProfile "1" -- "0..*" AssessmentResult : evaluated by [Target]
LearnerProfile "1" -- "0..*" LearningProgress : monitors / owns [Target]
' Note: Profile -- LearningProgress direct link removed; sole canonical owner is LearnerProfile (Role.LEARNER only)
LearnerProfile "1" -- "0..*" ConceptMastery : tracks [Target]
LearnerProfile "1" -- "0..*" KnowledgeGap : detects [Target]
LearnerProfile "1" -- "0..*" LevelReadiness : measures [Target]
LearnerProfile "1" -- "0..*" Recommendation : receives [Target]
Recommendation "0..*" -- "0..1" RemedialModule : prescribes [Target]
Concept "1" -- "0..*" ConceptMastery : tracks [Target]
Concept "1" -- "0..*" KnowledgeGap : identifies [Target]
Concept "1" -- "0..*" RemedialModule : addresses [Target]
Exercise "0..*" -- "1" Concept : tags [Target]
Unit "1" -- "0..*" RemedialModule : contains [Target]

' Extension relationships (dashed)
Profile "1" .. "0..*" CohortMember : member of [Future]
Cohort "1" .. "0..*" CohortMember : enrolls [Future]
Profile "1" .. "0..*" SupportTicket : files / handles [Future]

@enduml
