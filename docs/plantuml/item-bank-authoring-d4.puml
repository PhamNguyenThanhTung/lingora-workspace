@startuml
!theme plain
skinparam roundCorner 8
skinparam defaultFontName "Segoe UI"
skinparam monochrome false
skinparam shadowing false
skinparam packageStyle rectangle

title Lingora — Assessment Item Bank & Exercise Authoring Architecture (D4)

package "Exercise Authoring Models (5 Canonical Types)" as ExerciseModels #F8FAFC {
  abstract class "Canonical Exercise Payload" as BaseExercise #E2E8F0 {
    +ExerciseType type
    +UUID conceptId (FK)
    +String prompt
    +String explanation
  }

  class "MCQ (Multiple Choice)" as ExMCQ #DBEAFE {
    +List<Option> options (text, isCorrect)
  }

  class "FILL_BLANK (Gap Fill)" as ExFill #DBEAFE {
    +String sentence
    +List<String> acceptedAnswers
    +Boolean caseSensitive
  }

  class "REORDER (Sentence Syntax)" as ExReorder #DBEAFE {
    +List<String> tokens
    +List<String> correctSequence
  }

  class "LISTENING (Audio Comprehension)" as ExListening #FEF3C7 {
    +String audioUrl (lingora-media)
    +Integer playbackLimit (e.g. 3)
    +List<Option> options
    +String transcript
    -- Status: TARGET SCHEMA SPEC --
  }

  class "GRAMMAR (Morphosyntax)" as ExGrammar #FEF3C7 {
    +String sourceSentence
    +String targetPattern
    +List<String> acceptedAnswers
    +List<DistractorFeedback> distractors
    -- Status: TARGET SCHEMA SPEC --
    (Deterministic != GEC AI service)
  }

  BaseExercise <|-- ExMCQ
  BaseExercise <|-- ExFill
  BaseExercise <|-- ExReorder
  BaseExercise <|-- ExListening
  BaseExercise <|-- ExGrammar
}

note top of BaseExercise #FFFFFF
  <b>STATUS DISCLAIMER:</b>
  These are D4 logical/target authoring models.
  Applied DB currently supports MCQ, FILL_BLANK, REORDER.
  LISTENING and GRAMMAR are Target Schema specifications.
  No AssessmentSession, Exam, or QuestionBank ghost entities.
end note

package "Assessment Item Bank (Logical Metadata)" as ItemBank #F1F5F9 {
  class AssessmentItem #E0E7FF {
    +UUID itemId (PK)
    +String language (e.g. 'en', 'zh')
    +SkillDimension dimension (VOCAB, GRAMMAR, READING, LISTENING)
    +UUID conceptId (FK)
    +String curriculumProvenance
    +ItemDifficulty descriptiveDifficulty (ENTRY, MID, UPPER)
    +ExerciseType exerciseType
    +Integer itemVersion
    +String itemBankVersion
    +String languageConfigVersion
    +String rubricReference
    +ContentStatus publicationState
    +List<Eligibility> assessmentEligibility
  }

  AssessmentItem *-- BaseExercise : wraps payload
}

package "Independent Assessment Axes (D3 Invariant)" as Axes #F0FDF4 {
  enum "assessmentType (Pedagogical Purpose)" as Purpose #DCFCE7 {
    DIAGNOSTIC (Initial ability estimation & Starting Unit)
    EXIT (Post-learning gatekeeping before transition)
    RE_EVALUATION (Periodic / On-demand profile refresh)
  }

  enum "deliveryMode (Execution Mode)" as Mode #BBF7D0 {
    PLACEMENT (Onboarding curriculum placement)
    JUMP (Accelerated unit skipping >=95%)
    STANDARD (Standard formal assessment)
  }

  AssessmentItem ..> Purpose : eligible for
  AssessmentItem ..> Mode : delivered via
}

package "Immutable Persisted Assessment Evidence" as Evidence #FFFFFF {
  class AssessmentResult #E2E8F0 {
    +UUID id
    +UUID userId
    +AssessmentType assessmentType
    +DeliveryMode deliveryMode
    +JSONB dimensions
    +JSONB rawScores
    +JSONB stageData
    +DateTime completedAt
  }

  AssessmentItem ..> AssessmentResult : generates item responses in
}

@enduml
