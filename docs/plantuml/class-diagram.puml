@startuml
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
skinparam classAttributeIconSize 0
hide empty methods

title Sơ đồ Lớp Nghiệp vụ (Domain Class Diagram) - Hệ thống Lingora

class Profile #EEF2FF {
  +id: UUID
  +email: String
  +displayName: String
  +role: RoleEnum
  +uiLocale: String
  +dailyGoalMinutes: Integer
  +streakCount: Integer
  +getLearningStats(): Stats
  +updateDailyGoal(min: Integer): void
}

class Course #E0F2FE {
  +id: UUID
  +languageCode: String
  +cefrLevel: CEFREnum
  +getLessons(): List<Lesson>
  +getLocalizedTitle(locale: String): String
}

class Lesson #E0F2FE {
  +id: UUID
  +courseId: UUID
  +orderIndex: Integer
  +getVocabularies(): List<Vocabulary>
  +getExercises(): List<Exercise>
}

class Vocabulary #DCFCE7 {
  +id: UUID
  +languageCode: String
  +normalizedTerm: String
  +audioUrl: String
  +getMeaning(locale: String): String
  +getExample(locale: String): String
}

class Exercise #DCFCE7 {
  +id: UUID
  +lessonId: UUID
  +type: ExerciseTypeEnum
  +payload: JSON
  +evaluateAnswer(input: String): ScoreResult
}

class UserVocabSrs #FEF9C3 {
  +id: UUID
  +userId: UUID
  +vocabularyId: UUID
  +easeFactor: Float
  +intervalDays: Float
  +nextReviewAt: Timestamp
  +reviewCount: Integer
  +applySM2(rating: Integer): ReviewResult
}

class ChatScenario #FAF5FF {
  +id: UUID
  +scenarioCode: String
  +cefrLevel: CEFREnum
  +systemPrompt: String
  +isPublished: Boolean
  +getPrompts(): List<Prompt>
}

class GrammarChecker #FAF5FF {
  +analyzeSentence(text: String, context: String): GrammarAnalysis
  +computeDiff(original: String, corrected: String): List<DiffToken>
}

class UserProgress #EEF2FF {
  +id: UUID
  +userId: UUID
  +lessonId: UUID
  +score: Integer
  +status: ProgressStatusEnum
  +markCompleted(score: Integer): void
}

Profile "1" *-- "*" UserProgress : theo dõi tiến độ
Profile "1" *-- "*" UserVocabSrs : quản lý thẻ SRS
Course "1" *-- "*" Lesson : chứa bài học
Lesson "1" *-- "*" Vocabulary : giới thiệu
Lesson "1" *-- "*" Exercise : chứa bài tập
Vocabulary "1" -- "*" UserVocabSrs : lập lịch ôn tập
ChatScenario "1" ..> GrammarChecker : kiểm tra ngữ pháp
Profile "1" ..> ChatScenario : thực hành kịch bản
@enduml