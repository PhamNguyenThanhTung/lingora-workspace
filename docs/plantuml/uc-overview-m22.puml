@startuml
title LINGORA - Use Case Overview (M2.2 System Behavior)
left to right direction
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8

skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #334155
  FontSize 10
}

skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #374151
}

skinparam usecase {
  BackgroundColor #F9FAFB
  BorderColor #4B5563
}

skinparam rectangle {
  BorderColor #9CA3AF
}

' --- 6 CANONICAL HUMAN ACTORS ---
actor Learner
actor "Lesson Creator" as Creator
actor "Moderator" as Moderator
actor "Organizational Manager" as Org
actor "Operations Staff" as Ops
actor "Administrator" as Admin

' --- SYSTEM BOUNDARY ---
rectangle "Lingora Learning Platform - M2.2 System Behavior" {

  package "Core Learning (Learner Facing)" #F0FDF4 {
    usecase "UC-01\nAuthenticate & Manage Session" as UC01
    usecase "UC-02\nConfigure Goals & Study Time" as UC02
    usecase "UC-03\nTake Placement Test" as UC03
    usecase "UC-04\nBrowse Learning Path" as UC04
    usecase "UC-05\nComplete Lesson Exercises" as UC05
    usecase "UC-06\nSpaced Repetition Review (SRS)" as UC06
    usecase "UC-07\nTrack Progress & Streak" as UC07
  }

  package "Content Governance & Authoring" #EFF6FF {
    usecase "UC-08\nCreate & Edit Lesson Draft" as UC08
    usecase "UC-09\nReview & Moderate Content" as UC09
    usecase "UC-10\nPublish Approved Content" as UC10

    note right of UC09
      <b>Separation of Duties (SoD):</b>
      - Creator authors & submits (UC-08)
      - Moderator reviews & approves / requests changes (UC-09)
      - Organizational Manager publishes approved content (UC-10)
      - Admin emergency publish on APPROVED only (reason + AuditLog)
      - Creator cannot review own content
    end note
  }

  package "Administration & Operations" #F8FAFC {
    usecase "UC-11\nManage Accounts & Roles" as UC11
    usecase "UC-12\nView System Reports" as UC12
    usecase "UC-13\nView & Audit Security Logs" as UC13
    usecase "UC-14\nHandle Support Tickets" as UC14
  }

  package "Optional / Future Extension Boundary" #FAF5FF {
    usecase "UC-15\nManage Cohorts & Group Progress" as UC15
    note right of UC15
      <b>Boundary Rule:</b>
      Optional / future extension module.
      Zero dependency from Core Learning (UC-01..07).
      Gated by organization license.
    end note
  }
}

' --- ASSOCIATIONS ---
Learner -- UC01
Learner -- UC02
Learner -- UC03
Learner -- UC04
Learner -- UC05
Learner -- UC06
Learner -- UC07

UC03 ..> UC04 : <<determines starting unit>>

Creator -- UC08
Moderator -- UC09
Org -- UC10
Admin -- UC10 : (Emergency publish on APPROVED only)

Admin -- UC11
Admin -- UC12
Admin -- UC13

Ops -- UC14

Org -- UC15

@enduml
