@startuml
title Lingora MVP - Screen Sitemap
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8

rectangle "Public Screens" #F3F4F6 {
 [Landing] #FFFFFF
 [Login] #FFFFFF
 [Register] #FFFFFF
}

rectangle "Learner Screens" #E0F2FE {
 [Onboarding] #FFFFFF
 [Dashboard] #FFFFFF
 [Course Path] #FFFFFF
 [Lesson] #FFFFFF
 [Review] #FFFFFF
 [Progress] #FFFFFF
 [Profile and Goal] #FFFFFF
}

rectangle "Admin & Operations Screens" #EDE9FE {
 [Admin Portal] #FFFFFF
 [Content Queue] #FFFFFF
 [Lesson Editor] #FFFFFF
 [Review Queue] #FFFFFF
 [Users and Roles] #FFFFFF
 [Reports] #FFFFFF
 [Support Tickets] #FFFFFF
 [Cohorts (optional)] #FFFFFF
}
[Landing] --> [Login]
[Landing] --> [Register]
[Register] --> [Onboarding]
[Onboarding] --> [Dashboard]
[Login] --> [Dashboard]
[Login] --> [Admin Portal]
[Dashboard] --> [Course Path]
[Course Path] --> [Lesson]
[Lesson] --> [Review]
[Lesson] --> [Progress]
[Dashboard] --> [Profile and Goal]
[Admin Portal] --> [Content Queue]
[Content Queue] --> [Lesson Editor]
[Admin Portal] --> [Review Queue]
[Admin Portal] --> [Users and Roles]
[Admin Portal] --> [Reports]
[Admin Portal] --> [Support Tickets]
[Admin Portal] --> [Cohorts (optional)]
@enduml
