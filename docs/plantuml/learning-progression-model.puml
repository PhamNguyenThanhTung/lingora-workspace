@startuml
title Lingora Learning Progression, Adaptive Entry & Remediation Architecture
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8

start

:Learner Onboarding;

if (Lựa chọn luồng khởi đầu (Flexible Entry Flow)?) then (Làm Đánh giá Chẩn đoán (Khuyến nghị))
  :Thực hiện Stage-Adaptive Diagnostic Assessment;
  note right
    **Common Assessment Engine (D3/D4):**
    - Giai đoạn 1: Routing Stage
    - Giai đoạn 2: Targeted Stage
    - 4 chiều: Vocab, Grammar, Reading, Listening
    - Quy mô ~25–30 câu, <= 15 phút (PROPOSED)
    - Tiếng Anh: CEFR A1–B2
    - Tiếng Trung: HSK, Reading ẩn pinyin (hidePinyin: true)
  end note
  
  :Xuất Skill Profile đa chiều (Spider/Radar Chart);
  :Ghi nhận verifiedProficiency trong hồ sơ;
  
  if (Chương trình Tiếng Anh A1 (Placement Mapping A)?) then (Có)
    if (0..7 điểm) then
      :Starting Unit = **Unit 1**;
    elseif (8..12 điểm) then
      :Starting Unit = **Unit 2**;
    elseif (13..17 điểm) then
      :Starting Unit = **Unit 3**;
    elseif (18..22 điểm) then
      :Starting Unit = **Unit 4**;
    elseif (23..26 điểm) then
      :Starting Unit = **Unit 5**;
    else (27..30 điểm)
      :Starting Unit = **Unit 6**;
    endif
  else (Khóa học khác / Tiếng Trung)
    :Đề xuất Starting Unit/Level theo Rubric cấu hình;
  endif
  :Lưu kết quả AssessmentResult & SkillProfile;
else (Chọn cấp độ tự khai báo / Bỏ qua)
  :Ghi nhận selfReportedLevel (A0..B2);
  note right
    **Tách biệt rạch ròi:**
    selfReportedLevel != verifiedProficiency (UNVERIFIED)
  end note
  :Starting Unit gán theo cấp độ tự chọn (hoặc mặc định Unit 1);
endif

:Vào Starting Unit trên Lộ trình Học tập;

partition "Tiến trình Học tập & Bổ khuyết Chuyên biệt (Learning Progression & Remediation)" {
  repeat
    :Học Lesson (N exercises trong bài);
    note right
      Mỗi exercise gắn Concept Tag.
      Lỗi sai liên tiếp -> Bắt tín hiệu tạo KnowledgeGap.
    end note
    
    if (Có câu sai & còn trong hạn ngạch Controlled Retry?) then (Có)
      :Thực hiện Controlled Retry (D7);
      note right
        **Thuật toán D7 Chuẩn:**
        - N = số câu thực tế trong bài học
        - Hạn ngạch: max(1, floor(N * 0.10))
        - Retry đúng nhận 70% credit
        - Hoàn thành = giải quyết hết bài first-pass
          và các câu sai bắt buộc trong retry
        - Completion != điểm sàn 80%
      end note
    endif
    
    :Cập nhật Learning Progress (UserProgress = COMPLETED);
    :Cập nhật ConceptMastery theo bằng chứng thực tế;
    note right
      **4 Khái niệm Tách biệt:**
      Progress != Proficiency != Mastery != Readiness
    end note

    :Kích hoạt SRS Pool cho từ vựng bài học (Policy B: [1,3,7,14,30]);
    
    if (Kết thúc Unit: Đánh giá Level Readiness?) then (Đánh giá chuyển tiếp)
      if (Trạng thái = ADVANCE?) then (Đạt chuẩn)
        :Mở khóa Unit tiếp theo;
      elseif (Trạng thái = ADVANCE_WITH_SUPPORT?) then (Đạt kèm hỗ trợ)
        :Mở khóa Unit tiếp theo + Gợi ý bài tập bổ trợ nhẹ;
      else (Trạng thái = REMEDIATE)
        :Kích hoạt RemedialModule (Concept-level Remediation);
        note right
          **Nguyên tắc Remedial:**
          - Micro-lesson nhắm đúng KnowledgeGap
          - Ngữ cảnh mới, từ vựng mới, bài tập mới
          - KHÔNG hạ cấp độ tổng thể
          - KHÔNG bắt học lại bài cũ đã hoàn thành
        end note
        :Học viên hoàn thành micro-lesson bổ khuyết;
        :Đóng KnowledgeGap & Cập nhật ConceptMastery;
      endif
    endif

    if (Yêu cầu Nhảy cấp (Conditional Jump D5)?) then (Có)
      if (Đang trong Cooldown 24h?) then (Có)
        :Bị chặn Jump; Tiếp tục học tuần tự;
      else (Không)
        :Xác định khoảng cách Jump đến Unit k;
        if (Nhảy 1 Unit) then
          :Bài test 20 câu (Unit k-1);
        elseif (Nhảy 2-3 Units) then
          :Bài test tích lũy 25-30 câu;
        else (Nhảy >3 Units)
          :Bài test chẩn đoán toàn diện 40 câu;
        endif
        
        if (Điểm số >= 95%?) then (Đạt (Pass))
          :Mở khóa thẳng đến Unit k;
          :Gán nhãn các Unit bỏ qua: SKIPPED_BY_JUMP;
          note right
            **Nguyên tắc Jump Provenance (C-07):**
            - SKIPPED_BY_JUMP / UNLOCKED_BY_JUMP (by_jump = true) != COMPLETED_BY_LEARNING
            - [HISTORICAL TERM: COMPLETED_BY_JUMP is deprecated/superseded]
            - UserProgress ghi nhận provenance: by_jump = true
            - Không tương đương hoàn thành học liệu thực tế
          end note
        else (Trượt (Fail))
          :Kích hoạt Cooldown 24 giờ;
          :Tiếp tục học tuần tự;
        endif
      endif
    endif

  repeat while (Còn bài học / Unit tiếp theo trong lộ trình?)
}

:Hoàn thành Đề cương Khóa học (Learning Progress = 100%);
note right
  **Consistency Guard (C-06):**
  Progress != Proficiency
  Completed B1 != B2
  Hoàn thành 100% học liệu không tự động nâng cấp độ năng lực
end note

if (Thực hiện Đánh giá Đầu ra (Exit / Re-evaluation Assessment)?) then (Có)
  :Thực hiện Exit Assessment (AssessmentType: EXIT);
  :Xuất Skill Profile cập nhật;
  :Cập nhật verifiedProficiency mới trong hồ sơ;
else (Không)
  :Giữ nguyên verifiedProficiency hiện tại;
  :Ghi nhận hoàn thành nội dung khóa học;
endif

:Cập nhật Báo cáo Cá nhân Tổng hợp (LearningProgress + SkillProfile + ConceptMastery + LevelReadiness);
stop

@enduml
