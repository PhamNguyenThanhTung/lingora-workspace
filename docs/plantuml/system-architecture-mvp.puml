@startuml
title Lingora MVP - System Architecture
left to right direction
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
skinparam componentStyle rectangle

actor Learner
actor "Content & Operations Staff" as Staff

package "Client Applications" #E0F2FE {
  [Learner Web] as LWeb #FFFFFF
  [Admin Web] as AWeb #FFFFFF
}

package "Application Services" #EEF2FF {
  [Learner API] as LAPI #FFFFFF
  [Admin API] as AAPI #FFFFFF
  [Auth & RBAC] as Auth #FFFFFF
}

package "Backend Services (Supabase)" #F8FAFC {
  database "Supabase Postgres\n(+ Row Level Security)" as DB #F1F5F9
  folder "Supabase Storage\n(Audio & Media)" as Store #DCFCE7
}

Learner --> LWeb : Học tập & Luyện tập
Staff --> AWeb : Quản trị & Soạn thảo

LWeb --> LAPI : HTTPS / REST
AWeb --> AAPI : HTTPS / REST

LAPI --> Auth : Xác thực JWT
AAPI --> Auth : Kiểm tra quyền hạn

LAPI --> DB : Đọc/Ghi tiến độ & bài học
AAPI --> DB : Quản lý nội dung & tài khoản

LAPI --> Store : Tải audio & media
AAPI --> Store : Tải lên & Quản lý media
@enduml


