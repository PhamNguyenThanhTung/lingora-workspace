@startuml
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
title Activity Diagram - UC-04 Manage Educational Content
start
:Xác thực người dùng với vai trò Admin;
:Chọn khóa học, bài học, từ vựng, bài tập hoặc kịch bản;
:Tạo hoặc chỉnh sửa nội dung và bản dịch;
if (Cần upload file media?) then (có)
  :Kiểm tra định dạng MIME, dung lượng file;
  :Upload file media lên storage;
endif
:Kiểm tra tính hợp lệ của nội dung và bài tập;
if (Sẵn sàng xuất bản?) then (có)
  :Kiểm tra bản dịch bắt buộc và cấu trúc bài học;
  if (Đạt yêu cầu?) then (có)
    :Xuất bản nội dung (is_published = true);
  else (không)
    :Hiển thị thông báo lỗi cần bổ sung;
  endif
else (không)
  :Lưu bản nháp nội dung (chưa xuất bản);
endif
:Ghi nhận cập nhật thành công;
stop
@enduml
