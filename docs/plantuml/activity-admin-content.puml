@startuml
title Biểu đồ hoạt động - UC-04 Quản trị nội dung và xuất bản
skinparam shadowing false
start
:Xác thực với role ADMIN;
:Chọn khóa học, bài học, từ vựng, bài tập hoặc kịch bản;
:Tạo hoặc sửa nội dung và bản dịch;
if (Cần tệp đa phương tiện?) then (có)
  :Kiểm tra MIME, kích thước và đường dẫn đích;
  :Tải tệp đa phương tiện đã duyệt;
endif
:Kiểm tra nội dung và payload bài tập;
if (Sẵn sàng xuất bản?) then (có)
  :Kiểm tra bản dịch bắt buộc và thứ tự thành phần con;
  if (Kiểm tra xuất bản đạt?) then (có)
    :Xuất bản nội dung;
  else (không)
    :Hiển thị lỗi kiểm tra có hướng xử lý;
  endif
else (không)
  :Lưu nội dung ở trạng thái chưa xuất bản;
endif
:Ghi nhận trạng thái đã cập nhật;
stop
@enduml
