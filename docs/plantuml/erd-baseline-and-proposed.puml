@startuml
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
title Sơ đồ Thực thể Quan hệ (ERD)
hide methods
hide stereotypes
skinparam linetype ortho
skinparam defaultFontSize 12
skinparam nodesep 24
skinparam ranksep 24

' ==========================================
' 1. NGƯỜI DÙNG & NGÔN NGỮ HỆ THỐNG
' ==========================================
entity Language #EEF2FF {
  * code : varchar(8) <<PK>>
  --
  name : text
  native_name : text
  is_learnable : boolean
  is_ui_locale : boolean
}

entity Profile #EEF2FF {
  * id : uuid <<PK, FK auth.users>>
  --
  email : text <<UQ>>
  display_name : text
  role : enum (STUDENT, ADMIN)
  ui_locale : varchar(8) <<FK>>
  native_lang_code : varchar(8) <<FK>>
  daily_goal_min : int
  streak_count : int
  created_at : timestamp
}

' ==========================================
' 2. KHÓA HỌC & BÀI HỌC ĐA NGỮ
' ==========================================
entity Course #E0F2FE {
  * id : uuid <<PK>>
  --
  language_code : varchar(8) <<FK>>
  cefr : enum (A1..C2)
  created_at : timestamp
}

entity CourseTranslation #E0F2FE {
  * course_id : uuid <<PK, FK>>
  * locale : varchar(8) <<PK, FK>>
  --
  title : text
  description : text
}

entity Lesson #E0F2FE {
  * id : uuid <<PK>>
  --
  course_id : uuid <<FK>>
  order_index : int
  created_at : timestamp
}

entity LessonTranslation #E0F2FE {
  * lesson_id : uuid <<PK, FK>>
  * locale : varchar(8) <<PK, FK>>
  --
  title : text
  overview : text
}

' ==========================================
' 3. TỪ VỰNG & BÀI TẬP TƯƠNG TÁC
' ==========================================
entity Vocabulary #DCFCE7 {
  * id : uuid <<PK>>
  --
  language_code : varchar(8) <<FK>>
  normalized_term : text
  audio_path : text
}

entity VocabularyTranslation #DCFCE7 {
  * vocabulary_id : uuid <<PK, FK>>
  * locale : varchar(8) <<PK, FK>>
  --
  meaning : text
  example_sentence : text
}

entity LessonVocabulary #DCFCE7 {
  * lesson_id : uuid <<PK, FK>>
  * vocabulary_id : uuid <<PK, FK>>
  --
  order_index : int
}

entity Exercise #DCFCE7 {
  * id : uuid <<PK>>
  --
  lesson_id : uuid <<FK>>
  type : enum (MCQ, FILL, REORDER, GRAMMAR)
  order_index : int
  payload : jsonb
}

' ==========================================
' 4. ÔN TẬP SPACED REPETITION (SRS)
' ==========================================
entity UserVocabSrs #FEF9C3 {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK>>
  vocabulary_id : uuid <<FK>>
  ease_factor : float
  interval_days : float
  next_review_at : timestamp
  review_count : int
  lapse_count : int
}

entity ReviewLog #FEF9C3 {
  * id : uuid <<PK>>
  --
  srs_card_id : uuid <<FK>>
  rating : int (1..4)
  ease_factor : float
  interval_days : float
  reviewed_at : timestamp
}

' ==========================================
' 5. KỊCH BẢN, LUYỆN VIẾT & TIẾN ĐỘ
' ==========================================
entity ChatScenario #FAF5FF {
  * id : uuid <<PK>>
  --
  scenario_code : text <<UQ>>
  language_code : varchar(8) <<FK>>
  cefr_level : enum
  is_published : boolean
}

entity ChatScenarioTranslation #FAF5FF {
  * scenario_id : uuid <<PK, FK>>
  * ui_locale : varchar(8) <<PK, FK>>
  --
  title : text
  description : text
  system_prompt : text
}

entity ChatSession #FAF5FF {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK>>
  scenario_id : uuid <<FK>>
  status : enum (ACTIVE, COMPLETED)
  created_at : timestamp
}

entity ChatMessage #FAF5FF {
  * id : uuid <<PK>>
  --
  session_id : uuid <<FK>>
  role : enum (USER, SYSTEM)
  content : text
  created_at : timestamp
}

entity UserProgress #FAF5FF {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK>>
  lesson_id : uuid <<FK>>
  score : int
  status : enum (NOT_STARTED, COMPLETED)
  completed_at : timestamp
}

' ==========================================
' QUAN HỆ KHÓA NGOẠI (24 FOREIGN KEYS)
' ==========================================
Language ||--o{ Profile : "ui_locale / native_lang"
Language ||--o{ Course : "language_code"
Language ||--o{ CourseTranslation : "locale"
Language ||--o{ LessonTranslation : "locale"
Language ||--o{ Vocabulary : "language_code"
Language ||--o{ VocabularyTranslation : "locale"
Language ||--o{ ChatScenario : "language_code"
Language ||--o{ ChatScenarioTranslation : "ui_locale"

Profile ||--o{ UserProgress : "user_id"
Profile ||--o{ UserVocabSrs : "user_id"
Profile ||--o{ ChatSession : "user_id"

Course ||--o{ CourseTranslation : "course_id"
Course ||--o{ Lesson : "course_id"

Lesson ||--o{ LessonTranslation : "lesson_id"
Lesson ||--o{ LessonVocabulary : "lesson_id"
Lesson ||--o{ Exercise : "lesson_id"
Lesson ||--o{ UserProgress : "lesson_id"

Vocabulary ||--o{ VocabularyTranslation : "vocabulary_id"
Vocabulary ||--o{ LessonVocabulary : "vocabulary_id"
Vocabulary ||--o{ UserVocabSrs : "vocabulary_id"

UserVocabSrs ||--o{ ReviewLog : "srs_card_id"

ChatScenario ||--o{ ChatScenarioTranslation : "scenario_id"
ChatScenario ||--o{ ChatSession : "scenario_id"
ChatSession ||--o{ ChatMessage : "session_id"

@enduml
