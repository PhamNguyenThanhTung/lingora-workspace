@startuml
skinparam dpi 150
skinparam defaultFontName Arial
skinparam defaultFontSize 20
skinparam titleFontSize 26
skinparam ArrowFontSize 16
skinparam UsecaseFontSize 18
skinparam ActorFontSize 20
skinparam shadowing false
skinparam nodesep 25
skinparam ranksep 80

left to right direction
title Sơ đồ Use Case Phân hệ Quản trị & Vận hành - Lingora

actor "Admin" as Admin

rectangle "Phân hệ Quản trị & Vận hành" as P_Admin {
    usecase "UC-13: Quản lý Người dùng & Tài khoản Giáo viên" as UC_13
    usecase "UC-14: Xem Báo cáo & Thống kê toàn hệ thống" as UC_14
    
    UC_13 -[hidden]right-> UC_14
}

usecase "UC-01: Xác thực, Đăng nhập & Quản lý hồ sơ" as UC_01

P_Admin -[hidden]down-> UC_01

' Liên kết Actor với Use Case (đường nét liền, KHÔNG mũi tên)
Admin -- UC_01
Admin -- UC_13
Admin -- UC_14

' Quan hệ Include
UC_13 .[#94A3B8].> UC_01 : <<include>>
UC_14 .[#94A3B8].> UC_01 : <<include>>

@enduml
