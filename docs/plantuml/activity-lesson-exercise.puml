@startuml
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
title Activity Diagram - UC-02 Browse Lessons & UC-03 Interactive Exercises
start
:Xác thực người dùng (Learner);
:Tải khóa học và bài học đã xuất bản;
if (Có bài học?) then (có)
  :Hiển thị từ vựng và audio phát âm;
  :Tải danh sách bài tập theo thứ tự;
  while (Còn bài tập?) is (có)
    :Hiển thị bài tập (MCQ, Fill, Reorder);
    :Thu thập và kiểm tra câu trả lời;
    :Hiển thị phản hồi đúng/sai;
  endwhile (không)
  :Tính điểm đánh giá (0-100);
  :Cập nhật tiến độ học tập (UserProgress);
  :Cập nhật chuỗi ngày học liên tục (Streak);
  :Hiển thị màn hình hoàn thành;
else (không)
  :Hiển thị trạng thái không có bài học;
endif
stop
@enduml
