@startuml
title Biểu đồ hoạt động - UC-02/UC-03 Luồng học bài và làm bài tập
skinparam shadowing false
start
:Xác thực học viên;
:Tải khóa học và bài học đã xuất bản;
if (Có bài học?) then (có)
  :Hiển thị từ vựng và âm thanh;
  :Tải bài tập theo orderIndex;
  while (Còn bài tập?) is (có)
    :Hiển thị theo loại đã duyệt;
    :Thu thập và kiểm tra câu trả lời;
    :Hiển thị phản hồi đúng/sai;
  endwhile (không)
  :Tính điểm 0-100;
  :Cập nhật UserProgress không lặp tác dụng (idempotent);
  :Đánh giá sự kiện chuỗi ngày học hợp lệ;
  :Hiển thị trạng thái hoàn thành;
else (không)
  :Hiển thị trạng thái trống/lỗi có thể phục hồi;
endif
stop
@enduml
