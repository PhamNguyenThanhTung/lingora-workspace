@startuml
title LINGORA - Tổng quan ca sử dụng
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Học viên" as Learner

rectangle "Hệ thống học tập Web LINGORA" {
  usecase "UC-01\nXác thực và phiên" as UC01
  usecase "UC-02\nDuyệt và học bài" as UC02
  usecase "UC-03\nBài tập và đánh giá" as UC03
  usecase "UC-04\nQuản trị nội dung" as UC04
  usecase "UC-05\nSRS xác định" as UC05
  usecase "UC-06\nLuyện viết tình huống với GEC\n(xử lý T5-small nội bộ)" as UC06
  usecase "UC-07\nTiến độ, chuỗi ngày học và mục tiêu ngày" as UC07
  usecase "UC-08\nNhắc nhở trong ứng dụng" as UC08
  usecase "UC-09\nKiểm tra trình độ đầu vào\n[ĐỀ XUẤT / CHƯA TRIỂN KHAI]" as UC09
  usecase "UC-10\nThành tích riêng tư\n[ĐỀ XUẤT / CHƯA TRIỂN KHAI]" as UC10
}

actor "Quản trị viên" as Admin

Learner -- UC01
Learner -- UC02
Learner -- UC03
Learner -- UC05
Learner -- UC06
Learner -- UC07
Learner -- UC08
Learner -- UC09
Learner -- UC10
UC01 -- Admin
UC04 -- Admin

UC03 ..> UC07 : <<include>>
UC05 ..> UC07 : <<include>>
UC09 ..> UC03 : <<include>> dùng lại engine
UC10 ..> UC07 : <<include>> sự kiện tiến độ

note bottom of UC06
  GEC/T5-small là xử lý nội bộ Lingora,
  không phải actor bên ngoài.
end note
note bottom of UC09
  Mục tiêu đã duyệt; chưa triển khai.
end note
note bottom of UC10
  Chỉ riêng tư; không có bảng xếp hạng.
end note
@enduml
