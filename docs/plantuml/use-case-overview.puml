@startuml
title LINGORA - Use Case Overview
left to right direction
skinparam packageStyle rectangle
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam dpi 200

actor Learner
actor Admin

rectangle "Lingora Web Learning System" {
  usecase "UC-01\nAuthenticate & Manage Session" as UC01
  usecase "UC-02\nBrowse & Learn Lessons" as UC02
  usecase "UC-03\nComplete Interactive Exercises" as UC03
  usecase "UC-04\nManage Educational Content" as UC04
  usecase "UC-05\nSpaced Repetition Review (SRS)" as UC05
  usecase "UC-06\nScenario Writing & Grammar Check" as UC06
  usecase "UC-07\nTrack Progress, Streak & Goals" as UC07
  usecase "UC-08\nReceive In-App Study Reminders" as UC08
  usecase "UC-09\nTake Placement Test" as UC09
  usecase "UC-10\nEarn Achievements & Badges" as UC10
}

Learner -- UC01
Learner -- UC02
Learner -- UC03
Learner -- UC05
Learner -- UC06
Learner -- UC07
Learner -- UC08
Learner -- UC09
Learner -- UC10

UC01 -- Admin
UC04 -- Admin

UC03 ..> UC07 : <<include>>
UC05 ..> UC07 : <<include>>
UC09 ..> UC03 : <<include>>
UC10 ..> UC07 : <<include>>
@enduml
