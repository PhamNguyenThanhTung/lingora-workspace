@startuml
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
title LINGORA - UC-05 Spaced Repetition Review
left to right direction
actor Learner
rectangle "Lingora Web Learning System" {
  usecase "UC-05\nSpaced Repetition Review" as UC05
  usecase "View Due Cards" as Due
  usecase "Submit Recall Result" as Recall
  usecase "Update Review Schedule" as Schedule
}
Learner -- UC05
UC05 ..> Due : <<include>>
UC05 ..> Recall : <<include>>
UC05 ..> Schedule : <<include>>
@enduml
