@startuml
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
title LINGORA - UC-08 Receive Study Reminders
left to right direction
actor Learner
rectangle "Lingora Web Learning System" {
  usecase "UC-08\nReceive Study Reminders" as UC08
  usecase "Detect Missed Daily Activity" as Detect
  usecase "Show Reminder in Application" as Reminder
  usecase "Dismiss Reminder" as Dismiss
}
Learner -- UC08
UC08 ..> Detect : <<include>>
UC08 ..> Reminder : <<include>>
UC08 ..> Dismiss : <<include>>
@enduml
