@startuml
title Biểu đồ hoạt động - UC-05 Ôn tập SRS xác định
skinparam shadowing false
start
:Xác thực học viên;
:Truy vấn thẻ thuộc học viên\nvới nextReviewAt <= now;
if (Có thẻ đến hạn?) then (có)
  while (Còn thẻ?) is (có)
    :Hiển thị thẻ từ vựng;
    :Thu thập kết quả ghi nhớ;
    :Gọi RPC record_review;
    if (RPC thành công?) then (có)
      :Thêm ReviewLog bất biến;
      :Cập nhật một thẻ UserVocabSrs;
    else (không)
      :Hiển thị lỗi có thể thử lại;
    endif
  endwhile (không)
  :Đánh giá sự kiện tiến độ/streak;
else (không)
  :Hiển thị trạng thái không có thẻ đến hạn;
endif
note right
  Tên policy giữ là xác định cho đến khi
  audit RPC chứng minh tương thích SM-2.
end note
stop
@enduml
