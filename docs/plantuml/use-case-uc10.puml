@startuml
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
title LINGORA - UC-10 Earn Achievements and Badges
left to right direction
actor Learner
rectangle "Lingora Web Learning System" {
  usecase "UC-10\nEarn Achievements and Badges" as UC10
  usecase "Evaluate Milestone" as Evaluate
  usecase "Award Private Badge" as Award
  usecase "View Personal Achievements" as View
}
Learner -- UC10
UC10 ..> Evaluate : <<include>>
UC10 ..> Award : <<include>>
UC10 ..> View : <<include>>
@enduml
