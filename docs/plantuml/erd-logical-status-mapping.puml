@startuml
title Lingora 2-Axis Data Model & ERD (Scope vs Implementation Status)
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8
hide methods
hide circle

' Palette definitions based on 2-axis model
!define APPLIED_COLOR #DCFCE7
!define TARGET_COLOR #E0F2FE
!define EXTENSION_FUTURE_COLOR #F3F4F6

legend top right
  **Trục 1: Phạm vi Nghiệp vụ (Scope) & Trục 2: Trạng thái Triển khai (Status)**
  |<#DCFCE7>| **Scope: CORE** | Status: **CURRENT_APPLIED_DATABASE** (Đang chạy thực tế) |
  |<#E0F2FE>| **Scope: CORE** | Status: **TARGET_SCHEMA** (Thiết kế schema.prisma, cần migration) |
  |<#F3F4F6>| **Scope: EXTENSION** | Status: **FUTURE_MIGRATION** (Mô-đun mở rộng B2B / Support) |
endlegend

entity "languages" as Language APPLIED_COLOR {
  * code : varchar(8) <<PK>>
  --
  name : text
  native_name : text
  is_learnable : boolean
  is_ui_locale : boolean
  .. [Scope: CORE | Status: CURRENT_APPLIED_DATABASE] ..
}

entity "profiles" as Profile APPLIED_COLOR {
  * id : uuid <<PK, auth.users>>
  --
  email : text <<UQ>>
  display_name : text
  role : Role <<Applied: LEARNER, ADMIN | Target: 6 roles>>
  assigned_roles : Role[] <<Target>>
  ui_locale : varchar(8)
  native_lang_code : varchar(8)
  daily_goal_min : int
  streak_count : int
  timezone : text
  last_qualifying_activity_date : date
  starting_unit : int <<Target Design Candidate DD-06>>
  placement_history : jsonb <<Target Design Candidate DD-06>>
  .. [Scope: CORE | Status: CURRENT_APPLIED_DATABASE] ..
}

entity "courses" as Course APPLIED_COLOR {
  * id : uuid <<PK>>
  --
  language_code : varchar(8) <<FK>>
  cefr : Cefr (A1)
  order_index : int
  is_published : boolean <<Applied>>
  status : ContentStatus <<Target Schema>>
  creator_id : uuid <<FK, Target>>
  reviewer_id : uuid <<FK, Target>>
  .. [Scope: CORE | Status: CURRENT_APPLIED_DATABASE] ..
}

entity "course_translations" as CourseTranslation APPLIED_COLOR {
  * course_id : uuid <<PK, FK>>
  * locale : varchar(8) <<PK, FK>>
  --
  title : text
  description : text
  .. [Scope: CORE | Status: CURRENT_APPLIED_DATABASE] ..
}

entity "units" as Unit TARGET_COLOR {
  * id : uuid <<PK>>
  --
  course_id : uuid <<FK>>
  order_index : int
  created_at : timestamp
  updated_at : timestamp
  .. [Scope: CORE | Status: TARGET_SCHEMA (Migration Required)] ..
}

entity "unit_translations" as UnitTranslation TARGET_COLOR {
  * unit_id : uuid <<PK, FK>>
  * locale : varchar(8) <<PK, FK>>
  --
  title : text
  description : text
  .. [Scope: CORE | Status: TARGET_SCHEMA (Migration Required)] ..
}

entity "lessons" as Lesson APPLIED_COLOR {
  * id : uuid <<PK>>
  --
  course_id : uuid <<FK>>
  unit_id : uuid <<FK, Target Schema>>
  order_index : int
  is_published : boolean <<Applied>>
  status : ContentStatus <<Target Schema>>
  objective : text <<Target Schema>>
  creator_id : uuid <<FK, Target>>
  reviewer_id : uuid <<FK, Target>>
  assignment_brief : text <<Target Candidate DD-04>>
  supersedes_id : uuid <<FK, Target Candidate DD-02>>
  created_at : timestamp
  updated_at : timestamp
  .. [Scope: CORE | Status: CURRENT_APPLIED_DATABASE] ..
}

entity "lesson_translations" as LessonTranslation APPLIED_COLOR {
  * lesson_id : uuid <<PK, FK>>
  * locale : varchar(8) <<PK, FK>>
  --
  title : text
  description : text
  .. [Scope: CORE | Status: CURRENT_APPLIED_DATABASE] ..
}

entity "exercises" as Exercise APPLIED_COLOR {
  * id : uuid <<PK>>
  --
  lesson_id : uuid <<FK>>
  type : ExerciseType <<Applied: MCQ, FILL_BLANK, REORDER | Target: LISTENING, GRAMMAR>>
  payload : jsonb <<ADR-006 payloadVersion>>
  order_index : int
  created_at : timestamp
  updated_at : timestamp
  .. [Scope: CORE | Status: CURRENT_APPLIED_DATABASE] ..
}

entity "vocabularies" as Vocabulary APPLIED_COLOR {
  * id : uuid <<PK>>
  --
  language_code : varchar(8) <<FK>>
  term : text
  normalized_term : text
  phonetic : text
  audio_url : text
  cefr : Cefr
  created_at : timestamp
  updated_at : timestamp
  .. [Scope: CORE | Status: CURRENT_APPLIED_DATABASE] ..
}

entity "vocabulary_translations" as VocabularyTranslation APPLIED_COLOR {
  * vocabulary_id : uuid <<PK, FK>>
  * locale : varchar(8) <<PK, FK>>
  --
  meaning : text
  example : text
  .. [Scope: CORE | Status: CURRENT_APPLIED_DATABASE] ..
}

entity "lesson_vocabularies" as LessonVocabulary APPLIED_COLOR {
  * lesson_id : uuid <<PK, FK>>
  * vocabulary_id : uuid <<PK, FK>>
  .. [Scope: CORE | Status: CURRENT_APPLIED_DATABASE] ..
}

entity "user_progress" as UserProgress APPLIED_COLOR {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK>>
  lesson_id : uuid <<FK>>
  status : ProgressStatus
  score : int
  completed_at : timestamp
  updated_at : timestamp
  .. [Scope: CORE | Status: CURRENT_APPLIED_DATABASE] ..
}

entity "user_vocab_srs" as UserVocabSrs APPLIED_COLOR {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK>>
  vocabulary_id : uuid <<FK>>
  ease_factor : float
  interval_days : float
  recall_probability : float
  next_review_at : timestamp
  last_reviewed_at : timestamp
  review_count : int
  lapse_count : int
  created_at : timestamp
  .. [Scope: CORE | Status: CURRENT_APPLIED_DATABASE] ..
}

entity "review_logs" as ReviewLog APPLIED_COLOR {
  * id : uuid <<PK>>
  --
  srs_card_id : uuid <<FK>>
  is_correct : boolean
  interval_days : float
  reviewed_at : timestamp
  .. [Scope: CORE | Status: CURRENT_APPLIED_DATABASE] ..
}

entity "audit_logs" as AuditLog TARGET_COLOR {
  * id : uuid <<PK>>
  --
  actor_id : uuid <<FK>>
  action : text
  entity_type : text
  entity_id : uuid
  metadata : jsonb
  created_at : timestamp
  .. [Scope: CORE | Status: TARGET_SCHEMA (Migration Required)] ..
}

entity "cohorts" as Cohort EXTENSION_FUTURE_COLOR {
  * id : uuid <<PK>>
  --
  name : text
  manager_id : uuid <<FK>>
  .. [Scope: EXTENSION | Status: FUTURE_MIGRATION] ..
}

entity "cohort_members" as CohortMember EXTENSION_FUTURE_COLOR {
  * cohort_id : uuid <<PK, FK>>
  * user_id : uuid <<PK, FK>>
  --
  role : text
  .. [Scope: EXTENSION | Status: FUTURE_MIGRATION] ..
}

entity "support_tickets" as SupportTicket EXTENSION_FUTURE_COLOR {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK>>
  assigned_to : uuid <<FK>>
  status : text
  .. [Scope: EXTENSION | Status: FUTURE_MIGRATION] ..
}

entity "chat_scenarios" as ChatScenario APPLIED_COLOR {
  * id : uuid <<PK>>
  --
  code : text <<UQ>>
  is_published : boolean
  system_prompt : text
  created_at : timestamp
  .. [Scope: CORE | Status: CURRENT_APPLIED_DATABASE] ..
}

entity "chat_scenario_translations" as ChatScenarioTranslation APPLIED_COLOR {
  * scenario_id : uuid <<PK, FK>>
  * ui_locale : varchar(8) <<PK, FK>>
  --
  title : text
  description : text
  .. [Scope: CORE | Status: CURRENT_APPLIED_DATABASE] ..
}

' Applied Relationships
Language ||--o{ Course
Course ||--o{ CourseTranslation
Course ||--o{ Lesson : "Applied direct link"
Lesson ||--o{ LessonTranslation
Lesson ||--o{ Exercise
Language ||--o{ Vocabulary
Vocabulary ||--o{ VocabularyTranslation
Lesson ||--o{ LessonVocabulary
Vocabulary ||--o{ LessonVocabulary
Profile ||--o{ UserProgress
Lesson ||--o{ UserProgress
Profile ||--o{ UserVocabSrs
Vocabulary ||--o{ UserVocabSrs
UserVocabSrs ||--o{ ReviewLog
ChatScenario ||--o{ ChatScenarioTranslation

' Target Hierarchy & Governance
Course ||--o{ Unit : "Target hierarchy [Migration Required]"
Unit ||--o{ UnitTranslation : "[Migration Required]"
Unit ||--o{ Lesson : "Target unit containment [Migration Required]"
Profile ||--o{ AuditLog : "Actor audit [Migration Required]"
Lesson ||--o| Lesson : "supersedes_id [Candidate DD-02]"

' Extension Relationships (Dashed)
Profile ..o{ CohortMember
Cohort ..o{ CohortMember
Profile ..o{ SupportTicket

@enduml
