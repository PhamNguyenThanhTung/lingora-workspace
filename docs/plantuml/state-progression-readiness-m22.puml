@startuml
title LINGORA - State Machines: Content, Progression & Readiness (M2.2)
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8

skinparam state {
  BackgroundColor #F9FAFB
  BorderColor #4B5563
  ArrowColor #374151
}

' ========================================================
' STATE MACHINE 1: CONTENT LIFECYCLE (6 STATES)
' ========================================================
state "Content Lifecycle States" as ContentLifecycle #EFF6FF {
  state DRAFT : Authoring / Editing\nby Creator
  state IN_REVIEW : Pending Moderation\nLocked for editing
  state CHANGES_REQUESTED : Feedback attached\nEditable by Creator
  state APPROVED : Moderation passed\nAwaiting publication
  state PUBLISHED : Live for learners\nPublished content
  state ARCHIVED : Retired / Deprecated\nCore terminal state

  [*] --> DRAFT : Creator initializes content
  DRAFT --> IN_REVIEW : Submit for review [creator]
  IN_REVIEW --> CHANGES_REQUESTED : Request changes [moderator != creator]
  CHANGES_REQUESTED --> DRAFT : Creator resumes editing
  IN_REVIEW --> APPROVED : Moderation approved [moderator != creator]
  APPROVED --> PUBLISHED : Publish release [Org Manager / Admin emergency]
  PUBLISHED --> ARCHIVED : Retire content [Org Manager / Admin]
  ARCHIVED --> [*]

  note right of ARCHIVED
    Core terminal state.
    Revisions create new Lesson
    record via Clone-to-Draft v2
    (supersedesId).
  end note
}

' ========================================================
' STATE MACHINE 2: LEARNER PROGRESSION (4 STATES)
' ========================================================
state "Learner Progression States" as LearnerProgression #F0FDF4 {
  state LOCKED : Lesson locked\nPre-requisite unmet
  state IN_PROGRESS : Active learning session\nExercises in progress
  state COMPLETED : Lesson exercises completed\n[zero 80% score floor]
  state SKIPPED_BY_JUMP : Bypassed via Jump Assessment\n[by_jump=true, zero CEFR]

  [*] --> LOCKED : Curriculum initialized
  [*] --> IN_PROGRESS : Starting point assigned\n(Diagnostic / Provisional)
  LOCKED --> IN_PROGRESS : Prior lesson COMPLETED\nor prior unit passed
  IN_PROGRESS --> COMPLETED : All items & retry processed\nCompletion rule met
  LOCKED --> SKIPPED_BY_JUMP : Jump Assessment PASS (>= 95%)\nBypassed lesson marked
  IN_PROGRESS --> SKIPPED_BY_JUMP : Jump Assessment PASS (>= 95%)\nBypassed lesson marked
  SKIPPED_BY_JUMP --> [*]
  COMPLETED --> [*]
}

' ========================================================
' STATE MACHINE 3: LEVEL READINESS (3 CANONICAL OUTPUTS)
' ========================================================
state "Level Readiness Appraisal (3 Canonical Outputs)" as LevelReadiness #FFFBEB {
  state ADVANCE : Full progression\nUnlocks next Unit
  state ADVANCE_WITH_SUPPORT : Progression with scaffolding\nUnlocks next Unit with support
  state REMEDIATE : Concept deficits detected\nTargeted remediation scheduled

  [*] --> ADVANCE : Readiness evaluated [CONFIGURABLE / OPEN CUTOFFS]
  [*] --> ADVANCE_WITH_SUPPORT : Readiness evaluated [CONFIGURABLE / OPEN CUTOFFS]
  [*] --> REMEDIATE : Readiness evaluated [CONFIGURABLE / OPEN CUTOFFS]

  ADVANCE --> [*]
  ADVANCE_WITH_SUPPORT --> [*]
  REMEDIATE --> [*]

  note right of LevelReadiness
    Readiness cutoffs are CONFIGURABLE.
    No automatic advance.
    No whole-level downgrade.
    No forced replay of old lessons.
  end note
}

' ========================================================
' STATE MACHINE 4 & 5: KNOWLEDGE GAP & CONCEPT MASTERY
' ========================================================
state "Gap & Mastery States" as GapAndMastery #FAF5FF {
  state "KnowledgeGap: OPEN" as KG_OPEN : Error pattern detected\n[threshold CONFIGURABLE]
  state "KnowledgeGap: IN_REMEDIATION" as KG_REMED : Assigned remedial\nmicro-lesson
  state "KnowledgeGap: RESOLVED" as KG_RESOLVED : Target concept\ndemonstrated

  [*] --> KG_OPEN : Concept error pattern
  KG_OPEN --> KG_REMED : Remedial path scheduled
  KG_REMED --> KG_RESOLVED : Target concept verified
  KG_RESOLVED --> [*]

  --

  state "ConceptMastery: NOVICE" as CM_NOVICE : Initial evidence\n[CONFIGURABLE]
  state "ConceptMastery: DEVELOPING" as CM_DEV : Active practice evidence\n[CONFIGURABLE]
  state "ConceptMastery: MASTERED" as CM_MAST : Sustained mastery evidence\n[CONFIGURABLE]

  [*] --> CM_NOVICE : First concept interaction
  CM_NOVICE --> CM_DEV : Mastery evidence [CONFIGURABLE]
  CM_DEV --> CM_MAST : Mastery evidence [CONFIGURABLE]
  CM_MAST --> CM_DEV : Performance adjustment [CONFIGURABLE]
  CM_DEV --> CM_NOVICE : Performance adjustment [CONFIGURABLE]
}

@enduml
