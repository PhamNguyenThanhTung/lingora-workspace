@startuml
title LINGORA - DFD Level 0
left to right direction
skinparam shadowing false

rectangle Learner
rectangle Admin

rectangle "P1\nAuthentication & Session" as P1
rectangle "P2\nLesson & Exercise" as P2
rectangle "P3\nContent Administration" as P3
rectangle "P4\nDeterministic SRS" as P4
rectangle "P5\nScenario Writing & Internal GEC" as P5
rectangle "P6\nProgress, Goal & Reminder" as P6

database "D1 Auth/Profile" as D1
database "D2 Learning Content" as D2
database "D3 Learner Progress" as D3
database "D4 SRS State & Review Logs" as D4
database "D5 Scenario Catalog" as D5
database "D6 Approved Media" as D6

Learner --> P1 : credentials/session request
P1 --> Learner : authenticated session
P1 --> D1 : identity/profile operations

Learner --> P2 : lesson/exercise request, answers
P2 --> Learner : content, feedback, score
P2 --> D2 : read published lesson data
P2 --> D3 : write learner progress
P2 --> D6 : read authorized media

Admin --> P3 : content/media/publish commands
P3 --> Admin : validation/publication result
P3 --> D2 : manage learning content
P3 --> D5 : manage scenarios
P3 --> D6 : manage approved media

Learner --> P4 : review result
P4 --> Learner : due card and next schedule
P4 --> D4 : atomic review log and card update

Learner --> P5 : scenario code and English text
P5 --> Learner : corrected text and deterministic diff
P5 --> D5 : read published scenario

Learner --> P6 : goal/reminder interaction
P6 --> Learner : progress, streak, in-app reminder
P6 --> D3 : read/update learner progress
@enduml
