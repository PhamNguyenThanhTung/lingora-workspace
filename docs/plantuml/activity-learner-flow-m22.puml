@startuml
title LINGORA - End-to-End Learner Journey Activity Flow (M2.2)
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8

skinparam activity {
  BackgroundColor #F9FAFB
  BorderColor #4B5563
  ArrowColor #374151
}

skinparam diamond {
  BackgroundColor #FEF3C7
  BorderColor #D97706
}

skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontSize 10
}

start

:Authenticate & Initialize Session (UC-01 / BF-01);
:Configure Goals & Study Time (UC-02 / P1-FR-014);

if (Choose Initial Assessment Pathway?) then (Diagnostic Assessment)
  :Take Diagnostic Assessment (~25-30 items, PROPOSED) (UC-03 / BF-08);
  :Persist immutable AssessmentResult (created -> completed -> immutable);
  :Generate SkillProfile (Vocab, Grammar, Reading, Listening);
  :Assign verifiedProficiency;
  :Map Diagnostic Score (Mapping A) to curriculumStartingPoint (Unit 1..6);
else (Self-Report / Skip)
  :Record selfReportedLevel as UNVERIFIED;
  :Assign provisional curriculumStartingPoint (Unit 1);
  note right
    <b>Branch A Invariant:</b>
    Zero AssessmentResult.
    Zero SkillProfile.
    Zero verifiedProficiency.
  end note
endif

:Browse Unlocked Curriculum / Learning Path (UC-04 / BF-09);

repeat
  if (Attempt Unit Jump Assessment?) then (Yes)
    :Select Target Unit & Take Jump Assessment (UC-04 / BF-11);
    note right
      Scope: 20q (1 unit) / 25-30q (2-3 units) / 40q (>3 units)
      Passing Threshold: >= 95%
    end note
    if (Score >= 95%?) then (PASS)
      :Mark bypassed lessons as SKIPPED_BY_JUMP (by_jump=true);
      :Unlock target Unit & Lessons;
      note right
        Never marked COMPLETED_BY_JUMP.
        Zero CEFR certification.
      end note
    else (FAIL)
      :Record Jump failure;
      :Lock Jump for 24-hour cooldown period;
      :Resume learning at current position;
    endif
  else (No)
  endif

  :Select Active Lesson & Launch Player (UC-05 / BF-09);

  repeat
    :Present Lesson Exercise Item;
    :Learner Submits Response;
    if (Response is Correct?) then (Yes)
      :Mark Item Correct on First Pass;
    else (No)
      if (Retry Allowance Available? [max(1, floor(N * 0.10))]) then (Yes)
        :Offer Controlled Retry Attempt (UC-05 / BF-10);
        if (Learner Retries & Answers Correctly?) then (Yes)
          :Mark Item Correct on Retry (70% Credit);
        else (No)
          :Mark Item Incorrect;
        endif
        :Decrement Retry Allowance;
      else (No Allowance Remaining)
        :Mark Item Incorrect;
      endif
    endif
  repeat while (More Exercise Items in Lesson?) is (Yes)
  -> No;

  :Process Lesson Completion (UC-05);
  note right
    Completion Rule:
    All items processed & retry handled.
    Zero 80% score floor.
    Exercise correctness != Completion != Mastery.
  end note

  :Mark Lesson as COMPLETED (UC-05);

  if (Knowledge Gap (OPEN) Detected on Target Concept?) then (Yes)
    :Schedule Remedial Micro-Lesson (ADVANCE_WITH_SUPPORT or REMEDIATE);
    :Learner Completes Remedial Practice Item (UC-04 / BF-09);
    :Transition KnowledgeGap state to RESOLVED;
  else (No)
  endif

  :Schedule Concepts & Vocab into SRS Queue;
  note right
    Initial interval = 1 day (Stage 1)
  end note

  if (Daily SRS Queue has Due Items?) then (Yes)
    :Launch Daily SRS Review Session (UC-06 / BF-12);
    repeat
      :Present Review Card (Vocab / Grammar Prompt);
      :Learner Submits Review Answer;
      if (Review Correct?) then (Correct)
        :Advance Interval Stage [1 -> 3 -> 7 -> 14 -> 30 days];
      else (Incorrect)
        :Reset Interval Stage to 1 day;
      endif
      :Atomic record_review RPC Call;
    repeat while (More Due Review Items?) is (Yes)
    -> No;
  else (No Due Items)
  endif

  :Evaluate Daily Streak Criteria (UC-07 / BF-13);
  note right
    Timezone: Asia/Ho_Chi_Minh
    Qualifying activity completed in local day
    Active today: streak maintained/incremented
    Missed previous day: reset to 1
  end note

repeat while (Learner Continues to Next Lesson?) is (Yes)
-> Exit;

stop

@enduml
