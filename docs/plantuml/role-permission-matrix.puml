@startuml
title Lingora MVP - Role and Permission Boundaries
skinparam dpi 200
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8

rectangle "System-wide" #FEE2E2 {
 component "Administrator\naccounts, roles, config, reports" as A #FFFFFF
 component "Operations Staff\nsupport, incidents, monitoring" as O #FFFFFF
}

rectangle "Content workflow" #E0F2FE {
 component "Lesson Creator\ndraft, edit, preview, submit" as C #FFFFFF
 component "Moderator\naccuracy, pedagogy, approve" as M #FFFFFF
}

rectangle "Learning" #DCFCE7 {
 component "Learner\nlearn, review, goals, own data" as L #FFFFFF
 component "Organizational Manager (optional)\ncohort and aggregate reports" as G #FFFFFF
}

C --> M : Gửi duyệt nội dung (In Review)
M --> A : Ủy quyền xuất bản (Approved)
G --> L : Gán khóa học theo nhóm (Cohort)
A ..> C : Phân quyền tài khoản
A ..> O : Giám sát vận hành & Hỗ trợ
@enduml

