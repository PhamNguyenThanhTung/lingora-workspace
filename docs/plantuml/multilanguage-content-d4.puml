@startuml
!theme plain
skinparam roundCorner 8
skinparam defaultFontName "Segoe UI"
skinparam monochrome false
skinparam shadowing false
skinparam packageStyle rectangle

title Lingora — Multi-Language 4-Tier Content & Assessment Chain (D4)

package "Tier 1: Common Content & Assessment Engine" as Tier1 #F8FAFC {
  class "Common Engine (Language-Invariant)" as Engine #E2E8F0 {
    +coordinateAssessmentLifecycle()
    +routeStages(Routing -> Targeted)
    +captureEvidence()
    +emitAssessmentResult()
    +emitSkillProfile()
    -- Architectural Rule --
    Zero hardcoded language branching
    All behaviors parameterized via Config
  }
}

package "Tier 2: Declarative Language Configuration" as Tier2 #F0FDF4 {
  class "LanguageConfig Interface" as BaseConfig #DCFCE7 {
    +String languageCode
    +String referenceFramework
    +List<String> activeBands
    +JSONB dimensionConfigs
  }

  class "EnglishConfig (en)" as EnConfig #BBF7D0 {
    +referenceFramework = "CEFR" (A1..B2)
    +supportsCollocations = true
    +supportsWordFamilies = true
    +readingWordLimits = {A1: 80, A2: 150}
    +listeningScope = "WORD_AND_PHRASE"
    +dialogueScope = "PROPOSED_EXTENSION"
  }

  class "ChineseConfig (zh)" as ZhConfig #BBF7D0 {
    +referenceFramework = "HSK"
    +hskFrameworkVersion = "PENDING_VALIDATION"
    +supportsPinyin = true
    +supportsTones = true
    +hidePinyinDefault = true (Hanzi Reading)
    +toneDistinctionTest = true
  }

  BaseConfig <|-- EnConfig
  BaseConfig <|-- ZhConfig
  Engine --> BaseConfig : parameterizes via
}

package "Tier 3: Language-Scoped Item Bank" as Tier3 #FEF3C7 {
  class "English Item Bank" as EnBank #FDE68A {
    +Items linked to English Concepts
    +Difficulty: Entry / Mid / Upper
    +Grammar: tense, order, prepositions
    +Vocabulary: collocations, context
  }

  class "Chinese Item Bank" as ZhBank #FDE68A {
    +Items linked to Chinese Concepts
    +Difficulty: Entry / Mid / Upper
    +Grammar: measure words, aspect particles
    +Reading: Hanzi recognition (hidePinyin)
  }

  EnConfig --> EnBank : governs
  ZhConfig --> ZhBank : governs
}

package "Tier 4: Language-Specific Rubrics & Evaluation" as Tier4 #EFF6FF {
  class "English Rubric" as EnRubric #DBEAFE {
    +Grammar error taxonomy (S-V, tense, prep)
    +Vocabulary depth scoring
    +Connected speech / pronunciation notes
  }

  class "Chinese Rubric" as ZhRubric #DBEAFE {
    +Tone accuracy rules
    +Hanzi stroke / character confusion analysis
    +Word order & measure word error classification
  }

  EnBank --> EnRubric : evaluated by
  ZhBank --> ZhRubric : evaluated by
}

note bottom of ZhConfig #FFFFFF
  <b>CHINESE READING INVARIANT (E-EXP-04):</b>
  For Hanzi reading assessment, hidePinyin MUST default to true.
  Eliminates Latin pinyin crutches to accurately measure character recognition.
  HSK version mapping (HSK 2.0 vs 3.0) remains OPEN / PENDING.
end note

@enduml
