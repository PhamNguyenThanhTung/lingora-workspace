digraph LingoraProductDatabase {
  graph [rankdir=LR, splines=spline, nodesep=0.7, ranksep=1.1, bgcolor="#FFFFFF", fontname="Helvetica-Bold", fontsize=16, label="Lingora Product Database — Physical Entity-Relationship Overview (Canonical 34 Tables)", labelloc=t];
  node [shape=none, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8, color="#546E7A", arrowsize=0.7];

  subgraph cluster_auth {
    label="External Supabase Auth Provider";
    style="dashed";
    color="#78909C";
    bgcolor="#ECEFF1";
    auth_users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF" color="#78909C">
      <tr><td bgcolor="#B0BEC5" colspan="2"><b>auth.users (Provider Identity)</b></td></tr>
      <tr><td align="left"><b>PK id</b></td><td align="left">uuid</td></tr>
      <tr><td align="left">email</td><td align="left">text</td></tr>
    </table>>];
  }

  subgraph cluster_curriculum {
    label="1. Curriculum & Content Hierarchy (Schema: app)";
    style="rounded,filled";
    color="#1565C0";
    fillcolor="#E3F2FD";
    margin=14;
    languages [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#1565C0">
      <tr><td bgcolor="#1565C0" colspan="2"><font color="#FFFFFF"><b>app.languages</b></font></td></tr>
      <tr><td align="left"><b>PK id</b></td><td align="left"><font color="#555555">uuid</font></td></tr>
      <tr><td align="left">code</td><td align="left"><font color="#555555">text</font></td></tr>
      <tr><td align="left">names</td><td align="left"><font color="#555555">jsonb</font></td></tr>
      <tr><td align="left">is_learnable</td><td align="left"><font color="#555555">boolean</font></td></tr>
      <tr><td align="left">is_ui_locale</td><td align="left"><font color="#555555">boolean</font></td></tr>
      <tr><td align="left">created_at</td><td align="left"><font color="#555555">timestamptz</font></td></tr>
      <tr><td align="left">updated_at</td><td align="left"><font color="#555555">timestamptz</font></td></tr>
    </table>>];
    frameworks [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#1565C0">
      <tr><td bgcolor="#1565C0" colspan="2"><font color="#FFFFFF"><b>app.frameworks</b></font></td></tr>
      <tr><td align="left"><b>PK id</b></td><td align="left"><font color="#555555">uuid</font></td></tr>
      <tr><td align="left">code</td><td align="left"><font color="#555555">text</font></td></tr>
      <tr><td align="left">version</td><td align="left"><font color="#555555">text</font></td></tr>
      <tr><td align="left">names</td><td align="left"><font color="#555555">jsonb</font></td></tr>
      <tr><td align="left">created_at</td><td align="left"><font color="#555555">timestamptz</font></td></tr>
      <tr><td align="left">updated_at</td><td align="left"><font color="#555555">timestamptz</font></td></tr>
    </table>>];
    levels [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#1565C0">
      <tr><td bgcolor="#1565C0" colspan="2"><font color="#FFFFFF"><b>app.levels</b></font></td></tr>
      <tr><td align="left"><b>PK id</b></td><td align="left"><font color="#555555">uuid</font></td></tr>
      <tr><td align="left">framework_id</td><td align="left"><font color="#555555">uuid</font></td></tr>
      <tr><td align="left">code</td><td align="left"><font color="#555555">text</font></td></tr>
      <tr><td align="left">label</td><td align="left"><font color="#555555">jsonb</font></td></tr>
      <tr><td align="left">position</td><td align="left"><font color="#555555">integer</font></td></tr>
      <tr><td align="left">created_at</td><td align="left"><font color="#555555">timestamptz</font></td></tr>
      <tr><td align="left">updated_at</td><td align="left"><font color="#555555">timestamptz</font></td></tr>
    </table>>];
    courses [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#1565C0">
      <tr><td bgcolor="#1565C0" colspan="2"><font color="#FFFFFF"><b>app.courses</b></font></td></tr>
      <tr><td align="left"><b>PK id</b></td><td align="left"><font color="#555555">uuid</font></td></tr>
      <tr><td align="left">language_id</td><td align="left"><font color="#555555">uuid</font></td></tr>
      <tr><td align="left">framework_id</td><td align="left"><font color="#555555">uuid</font></td></tr>
      <tr><td align="left">names</td><td align="left"><font color="#555555">jsonb</font></td></tr>
      <tr><td align="left">is_active</td><td align="left"><font color="#555555">boolean</font></td></tr>
