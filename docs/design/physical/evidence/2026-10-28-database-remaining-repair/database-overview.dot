      <tr><td align="left">default_start_level_id</td><td align="left"><font color="#555555">uuid</font></td></tr>
      <tr><td align="left">gate_config</td><td align="left"><font color="#555555">jsonb</font></td></tr>
      <tr><td align="left">practice_config</td><td align="left"><font color="#555555">jsonb</font></td></tr>
      <tr><td align="left">coverage_catalog</td><td align="left"><font color="#555555">jsonb</font></td></tr>
      <tr><td align="left">coverage_catalog_generation</td><td align="left"><font color="#555555">bigint</font></td></tr>
      <tr><td align="left">created_at</td><td align="left"><font color="#555555">timestamptz</font></td></tr>
      <tr><td align="left">updated_at</td><td align="left"><font color="#555555">timestamptz</font></td></tr>
      <tr><td align="left">row_version</td><td align="left"><font color="#555555">bigint</font></td></tr>
    </table>>];
    units [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#1565C0">
      <tr><td bgcolor="#1565C0" colspan="2"><font color="#FFFFFF"><b>app.units</b></font></td></tr>
      <tr><td align="left"><b>PK id</b></td><td align="left"><font color="#555555">uuid</font></td></tr>
      <tr><td align="left">course_id</td><td align="left"><font color="#555555">uuid</font></td></tr>
      <tr><td align="left">level_id</td><td align="left"><font color="#555555">uuid</font></td></tr>
      <tr><td align="left">code</td><td align="left"><font color="#555555">text</font></td></tr>
      <tr><td align="left">position</td><td align="left"><font color="#555555">integer</font></td></tr>
      <tr><td align="left">names</td><td align="left"><font color="#555555">jsonb</font></td></tr>
      <tr><td align="left">created_at</td><td align="left"><font color="#555555">timestamptz</font></td></tr>
      <tr><td align="left">updated_at</td><td align="left"><font color="#555555">timestamptz</font></td></tr>
      <tr><td align="left">row_version</td><td align="left"><font color="#555555">bigint</font></td></tr>
    </table>>];
    lessons [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3" bgcolor="#FFFFFF" color="#1565C0">
      <tr><td bgcolor="#1565C0" colspan="2"><font color="#FFFFFF"><b>app.lessons</b></font></td></tr>
      <tr><td align="left"><b>PK id</b></td><td align="left"><font color="#555555">uuid</font></td></tr>
      <tr><td align="left">unit_id</td><td align="left"><font color="#555555">uuid</font></td></tr>
      <tr><td align="left">position</td><td align="left"><font color="#555555">integer</font></td></tr>
      <tr><td align="left">is_required</td><td align="left"><font color="#555555">boolean</font></td></tr>
      <tr><td align="left">availability</td><td align="left"><font color="#555555">text</font></td></tr>
      <tr><td align="left">active_revision_id</td><td align="left"><font color="#555555">uuid</font></td></tr>
      <tr><td align="left">created_at</td><td align="left"><font color="#555555">timestamptz</font></td></tr>
      <tr><td align="left">updated_at</td><td align="left"><font color="#555555">timestamptz</font></td></tr>
      <tr><td align="left">row_version</td><td align="left"><font color="#555555">bigint</font></td></tr>
    </table>>];
  }

  subgraph cluster_authoring {
