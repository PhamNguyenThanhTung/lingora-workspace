        // 1. Explicit pg_default_acl inventory (PRE-10: decomposes entries, checks current_user creator, recognizes '=X' PUBLIC syntax)
        const defaultAclRes = await pgClient.query(`
          SELECT defaclrole::regrole::text AS role,
                 defaclnamespace::regnamespace::text AS schema,
                 defaclobjtype AS objtype,
                 defaclacl::text[] AS acl
            FROM pg_default_acl
           WHERE defaclrole = (SELECT oid FROM pg_roles WHERE rolname = CURRENT_USER)
           ORDER BY defaclnamespace, defaclobjtype;
        `);

        // Deconstruct ACL entries
        const parsedAclEntries = [];
        for (const row of defaultAclRes.rows) {
          for (const item of (row.acl || [])) {
            const [granteePart, grantor] = item.split('/');
            const [grantee, privs] = granteePart.split('=');
            parsedAclEntries.push({
              schema: row.schema,
              objtype: row.objtype,
              grantee: grantee === '' ? 'PUBLIC' : grantee,
              privileges: privs,
              grantor,
            });
          }
        }

        const globalFuncAcl = defaultAclRes.rows.find((r) => r.schema === '-' && r.objtype === 'f');
        // In PostgreSQL aclitem: '=X/...' means PUBLIC has execute!
        // To ensure public execute is revoked, no entry should have grantee PUBLIC ('='), anon, or authenticated
        const hasPublicFuncGrant = globalFuncAcl && globalFuncAcl.acl.some((entry) => {
          return entry.startsWith('=') || entry.startsWith('public=') || entry.startsWith('anon=') || entry.startsWith('authenticated=');
        });
        const hasCreatorGlobalRevoke = globalFuncAcl && !hasPublicFuncGrant;
