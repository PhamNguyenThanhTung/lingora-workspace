// Extract actual constraint definition expression:
function extractConstraintExpr(def) {
  // def is e.g. "CHECK ((raw_points >= (0)::numeric))"
  return def.replace(/^\s*CHECK\s*\(/i, '').replace(/\)\s*$/, '');
}
```
