// If entry starts with 'anon=' or 'authenticated=', grantee is anon or authenticated!
const hasPublicGrant = globalFuncAcl && globalFuncAcl.acl.some((entry) => entry.startsWith('=') || entry.startsWith('public=') || entry.startsWith('anon=') || entry.startsWith('authenticated='));
const hasCreatorGlobalRevoke = globalFuncAcl && !hasPublicGrant;
```
