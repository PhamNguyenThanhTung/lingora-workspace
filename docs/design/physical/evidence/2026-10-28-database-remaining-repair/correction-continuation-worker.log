```javascript
          // Test C: Numeric points boundaries (R6): evaluate actual installed check expressions from pg_constraint (PRE-07)
          const ptsCheckRes = await c.query(`
            SELECT conname, pg_get_constraintdef(oid) as def
              FROM pg_constraint
             WHERE conrelid = 'app.assessment_results'::regclass
               AND conname IN ('assessment_results_raw_points_check', 'assessment_results_possible_points_check', 'assessment_results_points_bound_check')
          `);
          const ptsCheckMap = new Map(ptsCheckRes.rows.map((r) => [r.conname, r.def]));
          const hasRawCheck = ptsCheckMap.has('assessment_results_raw_points_check');
          const hasPossibleCheck = ptsCheckMap.has('assessment_results_possible_points_check');
          const hasBoundsCheck = ptsCheckMap.has('assessment_results_points_bound_check');

          function extractConstraintExpr(def) {
            return def.replace(/^\s*CHECK\s*\(/i, '').replace(/\)\s*$/, '');
          }

          let evalRawValid = false, evalRawNegative = false, evalRawNull = false;
          let evalPossValid = false, evalPossNegative = false, evalPossZero = false;
          let evalBoundsValid = false, evalBoundsExceed = false, evalLargeBound = false;

          if (hasRawCheck && hasPossibleCheck && hasBoundsCheck) {
            const rawExpr = extractConstraintExpr(ptsCheckMap.get('assessment_results_raw_points_check'));
            const possExpr = extractConstraintExpr(ptsCheckMap.get('assessment_results_possible_points_check'));
            const boundsExpr = extractConstraintExpr(ptsCheckMap.get('assessment_results_points_bound_check'));

            const evalRes = await c.query(`
              SELECT
                (${rawExpr}) AS raw_valid,
                (${possExpr}) AS poss_valid,
                (${boundsExpr}) AS bounds_valid
              FROM (VALUES ($1::numeric, $2::numeric)) AS t(raw_points, possible_points);
            `, [5, 10]);
            evalRawValid = evalRes.rows[0].raw_valid === true;
            evalPossValid = evalRes.rows[0].poss_valid === true;
            evalBoundsValid = evalRes.rows[0].bounds_valid === true;

            const evalNeg = await c.query(`
              SELECT
                (${rawExpr}) AS raw_neg,
                (${possExpr}) AS poss_neg,
                (${possExpr}) AS poss_zero,
                (${boundsExpr}) AS bounds_exceed
              FROM (VALUES ($1::numeric, $2::numeric, $3::numeric, $4::numeric)) AS t(raw_points, possible_points, zero_val, exceed_raw);
            `, [-1, -1, 0, 15]);
            evalRawNegative = evalNeg.rows[0].raw_neg === false;
            evalPossNegative = evalNeg.rows[0].poss_neg === false;

            const evalZeroRes = await c.query(`
              SELECT (${possExpr}) AS poss_zero FROM (VALUES (0::numeric)) AS t(possible_points);
            `);
            evalPossZero = evalZeroRes.rows[0].poss_zero === false;

            const evalExceedRes = await c.query(`
              SELECT (${boundsExpr}) AS bounds_exceed FROM (VALUES (15::numeric, 10::numeric)) AS t(raw_points, possible_points);
            `);
            evalBoundsExceed = evalExceedRes.rows[0].bounds_exceed === false;

            const evalLargeRes = await c.query(`
              SELECT (${boundsExpr}) AS bounds_large FROM (VALUES (999999.9999::numeric, 999999.9999::numeric)) AS t(raw_points, possible_points);
            `);
            evalLargeBound = evalLargeRes.rows[0].bounds_large === true;

            const evalNullRes = await c.query(`
              SELECT (${rawExpr}) AS raw_null FROM (VALUES (NULL::numeric)) AS t(raw_points);
            `);
            evalRawNull = evalNullRes.rows[0].raw_null === null; // SQL UNKNOWN
          }

          pointsBoundaryChecksPass =
            hasRawCheck &&
            hasPossibleCheck &&
            hasBoundsCheck &&
            evalRawValid &&
            evalRawNegative &&
            evalRawNull &&
            evalPossValid &&
            evalPossNegative &&
            evalPossZero &&
            evalBoundsValid &&
            evalBoundsExceed &&
            evalLargeBound;

          // Test D: Lesson completion bounds (R6): evaluate actual installed expression from pg_constraint (PRE-07)
          const compBoundsRes = await c.query(`
            SELECT pg_get_constraintdef(oid) as def
              FROM pg_constraint
             WHERE conrelid = 'app.lesson_attempts'::regclass
               AND conname = 'lesson_attempts_completion_bounds_check'
          `);
          const compDef = compBoundsRes.rows[0]?.def || '';
          const compExpr = extractConstraintExpr(compDef);
          const hasCompCheckDef = compDef.includes('response_count') && compDef.includes('n_core') && compDef.includes('k_first_wrong');

          let compPass = false;
          if (hasCompCheckDef) {
            const compEvalRes = await c.query(`
              SELECT
                -- 1. Valid incomplete: all null
                (SELECT (${compExpr}) FROM (VALUES ($1::timestamptz, 2, NULL::int, NULL::int, NULL::int)) AS t(completed_at, n_core, k_first_wrong, response_count, contribution_units)) AS val_incomplete,
                -- 2. Valid completed N=2, K=1: count=3, units=2 in [2, 3] -> TRUE
                (SELECT (${compExpr}) FROM (VALUES ($2::timestamptz, 2, 1, 3, 2)) AS t(completed_at, n_core, k_first_wrong, response_count, contribution_units)) AS val_n2_k1_u2,
                -- 3. Valid completed N=2, K=1: count=3, units=3 in [2, 3] -> TRUE
                (SELECT (${compExpr}) FROM (VALUES ($2::timestamptz, 2, 1, 3, 3)) AS t(completed_at, n_core, k_first_wrong, response_count, contribution_units)) AS val_n2_k1_u3,
                -- 4. Invalid: units=1 (below 2*(N-K) = 2) -> FALSE
                (SELECT (${compExpr}) FROM (VALUES ($2::timestamptz, 2, 1, 3, 1)) AS t(completed_at, n_core, k_first_wrong, response_count, contribution_units)) AS val_n2_k1_u1_invalid,
                -- 5. Invalid: units=4 (above 2*N-1 = 3) -> FALSE
                (SELECT (${compExpr}) FROM (VALUES ($2::timestamptz, 2, 1, 3, 4)) AS t(completed_at, n_core, k_first_wrong, response_count, contribution_units)) AS val_n2_k1_u4_invalid,
                -- 6. PRE-07 counterexample: N=2, K=0, count=1, units=999 -> FALSE
                (SELECT (${compExpr}) FROM (VALUES ($2::timestamptz, 2, 0, 1, 999)) AS t(completed_at, n_core, k_first_wrong, response_count, contribution_units)) AS val_counterexample_invalid,
                -- 7. Invalid: negative K (K=-1) -> FALSE
                (SELECT (${compExpr}) FROM (VALUES ($2::timestamptz, 2, -1, 1, 2)) AS t(completed_at, n_core, k_first_wrong, response_count, contribution_units)) AS val_k_neg_invalid,
                -- 8. Invalid: K > N (K=3, N=2) -> FALSE
                (SELECT (${compExpr}) FROM (VALUES ($2::timestamptz, 2, 3, 5, 2)) AS t(completed_at, n_core, k_first_wrong, response_count, contribution_units)) AS val_k_gt_n_invalid,
                -- 9. Invalid: count != N + K (count=4, N=2, K=1) -> FALSE
                (SELECT (${compExpr}) FROM (VALUES ($2::timestamptz, 2, 1, 4, 2)) AS t(completed_at, n_core, k_first_wrong, response_count, contribution_units)) AS val_wrong_count_invalid;
            `, [null, new Date()]);

            const ev = compEvalRes.rows[0];
            compPass =
              ev.val_incomplete === true &&
              ev.val_n2_k1_u2 === true &&
              ev.val_n2_k1_u3 === true &&
              ev.val_n2_k1_u1_invalid === false &&
              ev.val_n2_k1_u4_invalid === false &&
              ev.val_counterexample_invalid === false &&
              ev.val_k_neg_invalid === false &&
              ev.val_k_gt_n_invalid === false &&
              ev.val_wrong_count_invalid === false;
          }
          completionBoundsChecksPass = compPass;
