title Lingora physical ERD - assessment (draft)
caption PROPOSED PHYSICAL DESIGN - NOT IMPLEMENTED | PK=UUID; FK=RESTRICT; ?=nullable; UQ=unique
entity "app.assessment_blueprints" as assessment_blueprints {
  PK id / FK created_by
  FK language_id / framework_id / course_id
  FK target_level_id? / next_level_id?
  purpose / coverage / requirements
  coverage_catalog_generation / config / generation
  scope immutable once used
}
entity "app.assessment_versions" as assessment_versions {
  PK id / FK blueprint_id
  UQ blueprint + version_no
  blueprint_snapshot / blueprint_generation
  assembled_at / assembly_input_hash
  UQ blueprint + generation + input hash
  status / is_active / row_version
  FK approved_by? / published_by?
  SYSTEM assembles atomically into IN_REVIEW
  membership / inputs immutable from assembly
}
entity "app.assessment_version_items" as assessment_version_items {
  PK id / FK assessment_version_id
  FK item_revision_id / item_id
  FK source_lesson_revision_id / source_submission_id
  FK contribution_assignment_episode_id
  UQ version + position / item
  weight / topic_ids / skill_ids
  coverage_tags + label snapshot
}
entity "app.assessment_attempts" as assessment_attempts {
  PK id / FK context_id / assessment_version_id
  submission_key? / submission_hash?
  started_at / finalized_at?
  UQ context + submission_key
}
entity "app_private.assessment_responses" as assessment_responses {
  PK id / FK attempt_id
  FK assessment_version_item_id / assessment_version_id
  UQ attempt + version_item
  input / awarded_points / answered_at
  PRIVATE - no learner SELECT
}
entity "app.assessment_results" as assessment_results {
  PK id / FK attempt_id UNIQUE
  FK recommended_level_id?
  raw_points / possible_points
  passed? / completed_at
  progression_applied_at?
}
