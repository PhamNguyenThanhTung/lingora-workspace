{
  "name": "@lingora/lesson-content",
  "version": "1.0.0",
  "description": "Canonical lesson content blocks, schemas, DTOs, and legacy adapters for Lingora.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./dto": "./src/dto.ts",
    "./legacy": "./src/legacy.ts",
    "./LessonContent": "./src/LessonContent.ts",
    "./styles.css": "./src/lesson-content.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/schema.test.mjs tests/legacy.test.mjs tests/renderer.test.mjs",
    "test:feature": "npm run test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "typescript": "7.0.2"
  }
}
