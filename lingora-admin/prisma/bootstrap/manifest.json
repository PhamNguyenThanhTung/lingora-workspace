{
  "manifest_version": "1.0.0",
  "description": "Cluster role and prerequisite manifest for Lingora database runtime (P1-03a AC-03)",
  "authority": "plans/2026-10-22-database-runtime-implementation-spec.md §2, §5",
  "cluster_roles": {
    "login_principals": [
      {
        "role": "lingora_runtime",
        "type": "LOGIN",
        "attributes": ["NOSUPERUSER", "NOBYPASSRLS", "NOCREATEDB", "NOCREATEROLE", "INHERIT"],
        "purpose": "Non-owner application runtime principal for Next.js / Prisma client interactive transactions under verified transaction-local subject."
      },
      {
        "role": "lingora_assembly",
        "type": "LOGIN",
        "attributes": ["NOSUPERUSER", "NOBYPASSRLS", "NOCREATEDB", "NOCREATEROLE", "INHERIT"],
        "purpose": "Dedicated system assembly service login for compiling submitted lesson contributions into assessment versions."
      },
      {
        "role": "lingora_auth_adapter",
        "type": "LOGIN",
        "attributes": ["NOSUPERUSER", "NOBYPASSRLS", "NOCREATEDB", "NOCREATEROLE", "INHERIT"],
        "purpose": "Isolated server-only Auth adapter login for staff reservation, PENDING account binding, and controlled activation."
      }
    ],
    "nologin_principals": [
      {
        "role": "lingora_authz_reader",
        "type": "NOLOGIN",
        "attributes": ["NOSUPERUSER", "NOBYPASSRLS"],
        "purpose": "Nonrecursive own-subject account id/role/status lookup under principal-specific policy without circular account queries."
      },
      {
        "role": "lingora_scoped_locker",
        "type": "NOLOGIN",
        "attributes": ["NOSUPERUSER", "NOBYPASSRLS"],
        "purpose": "Ordered row lock acquisition (LOCK-01) with SELECT and UPDATE USING policies but UPDATE WITH CHECK (false) denying domain writes."
      },
      {
        "role": "lingora_content_writer",
        "type": "NOLOGIN",
        "attributes": ["NOSUPERUSER", "NOBYPASSRLS"],
        "purpose": "Assigned Teacher draft payload editing, draft assessment omission toggling, and draft member association removal."
      },
      {
        "role": "lingora_transition_writer",
        "type": "NOLOGIN",
        "attributes": ["NOSUPERUSER", "NOBYPASSRLS"],
        "purpose": "Teacher lesson submission and Admin lifecycle transitions (review, approve, publish, archive, withdraw) and account status updates."
      },
      {
        "role": "lingora_learner_writer",
        "type": "NOLOGIN",
        "attributes": ["NOSUPERUSER", "NOBYPASSRLS"],
        "purpose": "Learner context creation/resume, open attempt answers, completion finalization, and SRS card reviews."
      },
      {
        "role": "lingora_grader",
        "type": "NOLOGIN",
        "attributes": ["NOSUPERUSER", "NOBYPASSRLS"],
        "purpose": "Internal grading calculation against private secrets without exposing keys to runtime or browser."
      },
      {
        "role": "lingora_fingerprint_reader",
        "type": "NOLOGIN",
        "attributes": ["NOSUPERUSER", "NOBYPASSRLS"],
        "purpose": "Collision existence verification for published practice and active assessment item fingerprints."
      },
      {
        "role": "lingora_assembly_writer",
        "type": "NOLOGIN",
        "attributes": ["NOSUPERUSER", "NOBYPASSRLS"],
        "purpose": "System-only complete submitted-source validation, version/member insertion, and SYSTEM audit."
      },
      {
        "role": "lingora_auth_provisioner",
        "type": "NOLOGIN",
        "attributes": ["NOSUPERUSER", "NOBYPASSRLS"],
        "purpose": "Private email reservation, exact UUID binding, PENDING activation, and Auth trigger execution."
      },
      {
        "role": "lingora_audit_writer",
        "type": "NOLOGIN",
        "attributes": ["NOSUPERUSER", "NOBYPASSRLS"],
        "purpose": "Sanitized append of ACCOUNT, VERIFIED_AUTH_SUBJECT, and SYSTEM audit events through checked paths."
      }
    ]
  },
  "schemas": [
    {
      "name": "app",
      "description": "Unexposed application domain catalog and relational tables."
    },
    {
      "name": "app_private",
      "description": "Unexposed security-sensitive tables (provisioning, receipts, audit, grading secrets)."
    }
  ],
  "ordering_rules": [
    "1. Cluster roles and provider prerequisites reconciled before migration apply",
    "2. Schemas app and app_private created and isolated from public access",
    "3. Tables created before foreign key circular dependencies",
    "4. Nullable circular pointers created before adding circular FK constraints",
    "5. Security objects, functions, grants, and FORCE RLS installed before trigger hookup",
    "6. Locale and curriculum configuration seeded before enabling Auth trigger",
    "7. Auth trigger on auth.users hooked up last to protect against unregistered/inconsistent accounts"
  ],
  "sql_only_objects_inventory": [
    {
      "object": "accounts_id_auth_users_fkey",
      "type": "FOREIGN KEY",
      "schema": "app",
      "table": "accounts",
      "source_columns": ["id"],
      "target_schema": "auth",
      "target_table": "users",
      "target_columns": ["id"],
      "on_update": "a",
      "on_delete": "c",
      "match_type": "s",
      "reason": "Cross-schema external provider FK to auth.users(id); Prisma does not manage provider auth schema."
    },
    {
      "object": "provisioning_requests_auth_user_id_fkey",
      "type": "FOREIGN KEY",
      "schema": "app_private",
      "table": "provisioning_requests",
      "source_columns": ["auth_user_id"],
      "target_schema": "auth",
      "target_table": "users",
      "target_columns": ["id"],
      "on_update": "a",
      "on_delete": "n",
      "match_type": "s",
      "reason": "Cross-schema external provider FK to auth.users(id); Prisma does not manage provider auth schema."
    },
    {
      "object": "assessment_versions_active_blueprint_idx",
      "type": "PARTIAL UNIQUE INDEX",
      "schema": "app",
      "table": "assessment_versions",
      "columns": ["blueprint_id"],
      "predicate": "is_active = true",
      "reason": "Unique active assessment version per blueprint (WHERE is_active = true); partial indexes are unsupported in Prisma schema."
    },
    {
      "object": "app.current_auth_subject",
      "type": "FUNCTION",
      "schema": "app",
      "returns": "uuid",
      "security_definer": false,
      "reason": "Transaction-local session subject accessor function; custom functions unsupported in Prisma schema."
    },
    {
      "object": "app_private.get_auth_subject_account",
      "type": "FUNCTION",
      "schema": "app_private",
      "owner": "lingora_authz_reader",
      "security_definer": true,
      "reason": "Nonrecursive own-subject account lookup with dedicated NOLOGIN owner; unsupported in Prisma schema."
    },
    {
      "object": "app_private.set_draft_assessment_contribution_omitted",
      "type": "FUNCTION",
      "schema": "app_private",
      "owner": "lingora_content_writer",
      "security_definer": true,
      "reason": "Checked draft contribution omission modifier; custom functions unsupported in Prisma schema."
    },
    {
      "object": "app_private.check_fingerprint_collision",
      "type": "FUNCTION",
      "schema": "app_private",
      "owner": "lingora_fingerprint_reader",
      "security_definer": true,
      "reason": "Cross-scope fingerprint collision checker; custom functions unsupported in Prisma schema."
    },
    {
      "object": "app_private.handle_auth_user_created",
      "type": "FUNCTION",
      "schema": "app_private",
      "owner": "lingora_auth_provisioner",
      "security_definer": true,
      "reason": "Auth user provisioning hook handler; custom functions unsupported in Prisma schema."
    },
    {
      "object": "on_auth_user_created",
      "type": "TRIGGER",
      "schema": "auth",
      "table": "users",
      "event": "AFTER INSERT",
      "function": "app_private.handle_auth_user_created",
      "reason": "Provider auth trigger on auth.users for safe signup and staff reservation skip; triggers unsupported in Prisma schema."
    },
    {
      "object": "retained_check_constraints",
      "type": "CHECK CONSTRAINT GROUP",
      "members": [
        "levels_position_check",
        "courses_curriculum_generation_check",
        "courses_coverage_catalog_generation_check",
        "courses_row_version_check",
        "units_position_check",
        "units_row_version_check",
        "lessons_availability_check",
        "lessons_position_check",
        "lessons_row_version_check",
        "content_assignments_scope_generation_check",
        "content_assignments_row_version_check",
        "assignment_history_event_type_check",
        "lesson_revisions_status_check",
        "lesson_revisions_revision_no_check",
        "lesson_revisions_row_version_check",
        "item_identities_origin_check",
        "assessment_blueprints_purpose_check",
        "assessment_blueprints_generation_check",
        "assessment_blueprints_row_version_check",
        "item_revisions_type_check",
        "item_revisions_revision_no_check",
        "item_revisions_row_version_check",
        "assessment_versions_status_check",
        "assessment_versions_version_no_check",
        "assessment_versions_row_version_check",
        "media_assets_byte_size_check",
        "media_assets_kind_check",
        "accounts_role_check",
        "accounts_status_check",
        "accounts_row_version_check",
        "learning_contexts_status_check",
        "learning_contexts_study_focus_check",
        "learning_contexts_row_version_check",
        "revision_reviews_action_check",
        "provisioning_requests_requested_role_check",
        "provisioning_requests_state_check",
        "provisioning_requests_row_version_check",
        "audit_events_actor_kind_check",
        "audit_events_outcome_check",
        "audit_events_actor_attribution_check"
      ],
      "reason": "Enforces domain integrity (positive positions, valid enum values, actor attributions); custom CHECK constraints unsupported in Prisma schema."
    },
    {
      "object": "retained_rls_policies",
      "type": "RLS POLICY GROUP",
      "members": [
        "languages_read_all",
        "frameworks_read_all",
        "levels_read_all",
        "courses_read_all",
        "units_read_all",
        "lessons_read_all",
        "content_assignments_read",
        "assignment_history_read",
        "lesson_revisions_read",
        "item_revisions_read",
        "item_identities_read",
        "assessment_blueprints_read",
        "assessment_versions_read",
        "accounts_select_own",
        "accounts_update_own",
        "accounts_authz_reader_select",
        "accounts_auth_adapter_all",
        "accounts_auth_provisioner_all",
        "contexts_learner_select",
        "contexts_learner_insert",
        "contexts_learner_update",
        "media_assets_read",
        "revision_reviews_read",
        "provisioning_requests_adapter_all",
        "provisioning_requests_provisioner_all",
        "command_receipts_own",
        "audit_events_insert_writer",
        "audit_events_adapter_all",
        "audit_events_runtime_select",
        "accounts_lock_only",
        "courses_lock_only",
        "blueprints_lock_only",
        "assignments_lock_only",
        "lessons_lock_only",
        "lesson_revisions_lock_only",
        "item_revisions_lock_only",
        "assessment_versions_lock_only",
        "contexts_lock_only"
      ],
      "reason": "Strict non-owner RLS enforcement and principal policies across all 20 tables; RLS policies unsupported in Prisma schema."
    },
    {
      "object": "retained_security_grants",
      "type": "GRANT GROUP",
      "roles": [
        "lingora_runtime",
        "lingora_assembly",
        "lingora_auth_adapter",
        "lingora_authz_reader",
        "lingora_scoped_locker",
        "lingora_content_writer",
        "lingora_transition_writer",
        "lingora_learner_writer",
        "lingora_grader",
        "lingora_fingerprint_reader",
        "lingora_assembly_writer",
        "lingora_auth_provisioner",
        "lingora_audit_writer"
      ],
      "reason": "Least-privilege table, column, and routine grants; table/column grants unsupported in Prisma schema."
    }
  ]
}
