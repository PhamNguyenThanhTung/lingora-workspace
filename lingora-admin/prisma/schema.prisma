datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app", "app_private"]
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id               String       @id @db.Uuid
  role             String       @db.Text
  status           String       @default("PENDING") @db.Text
  uiLocale         String       @default("en") @map("ui_locale") @db.Text
  nativeLanguageId String?      @map("native_language_id") @db.Uuid
  timezone         String       @default("UTC") @db.Text
  avatarMediaId    String?      @map("avatar_media_id") @db.Uuid
  activatedAt      DateTime?    @map("activated_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion       BigInt       @default(1) @map("row_version")

  uiLanguage       Language     @relation("AccountUiLanguage", fields: [uiLocale], references: [code], onUpdate: NoAction, onDelete: Restrict)
  nativeLanguage   Language?    @relation("AccountNativeLanguage", fields: [nativeLanguageId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  avatarMedia      MediaAsset?  @relation("AccountAvatarMedia", fields: [avatarMediaId], references: [id], onUpdate: NoAction, onDelete: Restrict)

  learningContexts LearningContext[]
  uploadedMedia    MediaAsset[] @relation("MediaUploadedBy")
  ownedMedia       MediaAsset[] @relation("MediaOwnerAccount")

  createdAssignments ContentAssignment[] @relation("AssignmentCreatedBy")
  teacherAssignments ContentAssignment[] @relation("AssignmentCurrentTeacher")
  historyPrevious    AssignmentHistory[] @relation("HistoryPreviousTeacher")
  historyNext        AssignmentHistory[] @relation("HistoryNextTeacher")
  historyChangedBy   AssignmentHistory[] @relation("HistoryChangedBy")

  createdLessons     LessonRevision[]    @relation("LessonRevisionCreatedBy")
  lastEditedLessons  LessonRevision[]    @relation("LessonRevisionLastEditedBy")
  submittedLessons   LessonRevision[]    @relation("LessonRevisionSubmittedBy")
  approvedLessons    LessonRevision[]    @relation("LessonRevisionApprovedBy")
  publishedLessons   LessonRevision[]    @relation("LessonRevisionPublishedBy")

  createdItems       ItemIdentity[]      @relation("ItemIdentityCreatedBy")
  createdItemRevs    ItemRevision[]      @relation("ItemRevisionCreatedBy")

  createdBlueprints  AssessmentBlueprint[] @relation("BlueprintCreatedBy")
  approvedVersions   AssessmentVersion[]   @relation("VersionApprovedBy")
  publishedVersions  AssessmentVersion[]   @relation("VersionPublishedBy")

  reviews            RevisionReview[]    @relation("ReviewActor")
  receipts           CommandReceipt[]
  auditEvents        AuditEvent[]        @relation("AuditActor")
  provisioningRequests ProvisioningRequest[] @relation("ProvisioningRequestedBy")

  @@map("accounts")
  @@schema("app")
}

model Language {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.Text
  names       Json     @db.JsonB
  isLearnable Boolean  @default(false) @map("is_learnable")
  isUiLocale  Boolean  @default(false) @map("is_ui_locale")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  accountsUiLanguage     Account[] @relation("AccountUiLanguage")
  accountsNativeLanguage Account[] @relation("AccountNativeLanguage")
  courses                Course[]
  learningContexts       LearningContext[]
  assessmentBlueprints   AssessmentBlueprint[]

  @@map("languages")
  @@schema("app")
}

model Framework {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @db.Text
  version   String   @db.Text
  names     Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  levels               Level[]
  courses              Course[]
  assessmentBlueprints AssessmentBlueprint[]

  @@unique([code, version], map: "frameworks_code_version_key")
  @@map("frameworks")
  @@schema("app")
}

model Level {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  frameworkId String    @map("framework_id") @db.Uuid
  code        String    @db.Text
  label       Json      @db.JsonB
  position    Int
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  framework   Framework @relation(fields: [frameworkId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  units       Unit[]
  coursesDefaultStart Course[] @relation("CourseDefaultStartLevel")
  targetBlueprints    AssessmentBlueprint[] @relation("BlueprintTargetLevel")
  nextBlueprints      AssessmentBlueprint[] @relation("BlueprintNextLevel")
  startContexts       LearningContext[]     @relation("ContextStartLevel")
  workingContexts     LearningContext[]     @relation("ContextWorkingLevel")

  @@unique([frameworkId, code], map: "levels_framework_id_code_key")
  @@unique([frameworkId, position], map: "levels_framework_id_position_key")
  @@map("levels")
  @@schema("app")
}

model Course {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  languageId                 String    @map("language_id") @db.Uuid
  frameworkId                String    @map("framework_id") @db.Uuid
  names                      Json      @db.JsonB
  isActive                   Boolean   @default(true) @map("is_active")
  curriculumGeneration       BigInt    @default(1) @map("curriculum_generation")
  defaultStartLevelId        String?   @map("default_start_level_id") @db.Uuid
  gateConfig                 Json      @default("{}") @map("gate_config") @db.JsonB
  practiceConfig             Json      @default("{}") @map("practice_config") @db.JsonB
  coverageCatalog            Json      @default("{}") @map("coverage_catalog") @db.JsonB
  coverageCatalogGeneration  BigInt    @default(1) @map("coverage_catalog_generation")
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion                 BigInt    @default(1) @map("row_version")

  language                   Language  @relation(fields: [languageId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  framework                  Framework @relation(fields: [frameworkId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  defaultStartLevel          Level?    @relation("CourseDefaultStartLevel", fields: [defaultStartLevelId], references: [id], onUpdate: NoAction, onDelete: Restrict)

  units                      Unit[]
  learningContexts           LearningContext[]
  assessmentBlueprints       AssessmentBlueprint[]

  @@map("courses")
  @@schema("app")
}

model Unit {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  levelId    String   @map("level_id") @db.Uuid
  code       String   @db.Text
  position   Int
  names      Json     @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion BigInt   @default(1) @map("row_version")

  course     Course   @relation(fields: [courseId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  level      Level    @relation(fields: [levelId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  lessons    Lesson[]

  @@unique([courseId, levelId, position], map: "units_course_id_level_id_position_key")
  @@map("units")
  @@schema("app")
}

model Lesson {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId           String           @map("unit_id") @db.Uuid
  position         Int
  isRequired       Boolean          @default(true) @map("is_required")
  availability     String           @default("PLANNED") @db.Text
  activeRevisionId String?          @map("active_revision_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion       BigInt           @default(1) @map("row_version")

  unit             Unit             @relation(fields: [unitId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  revisions        LessonRevision[] @relation("LessonRevisions")
  activeRevision   LessonRevision?  @relation("ActiveLessonRevision", fields: [activeRevisionId, id], references: [id, lessonId], onUpdate: NoAction, onDelete: Restrict, map: "lessons_active_revision_fkey")
  assignment       ContentAssignment?

  @@unique([unitId, position], map: "lessons_unit_id_position_key")
  @@map("lessons")
  @@schema("app")
}

model ContentAssignment {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdBy        String              @map("created_by") @db.Uuid
  currentTeacherId String              @map("current_teacher_id") @db.Uuid
  lessonId         String              @unique(map: "content_assignments_lesson_id_key") @map("lesson_id") @db.Uuid
  requirement      Json                @default("{}") @db.JsonB
  scope            Json                @default("{}") @db.JsonB
  scopeGeneration  BigInt              @default(1) @map("scope_generation")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion       BigInt              @default(1) @map("row_version")

  creator          Account             @relation("AssignmentCreatedBy", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: Restrict)
  currentTeacher   Account             @relation("AssignmentCurrentTeacher", fields: [currentTeacherId], references: [id], onUpdate: NoAction, onDelete: Restrict, map: "content_assignments_current_teacher_fkey")
  lesson           Lesson              @relation(fields: [lessonId], references: [id], onUpdate: NoAction, onDelete: Restrict)

  history          AssignmentHistory[]
  revisions        LessonRevision[]
  mediaAssets      MediaAsset[]

  @@unique([id, lessonId], map: "content_assignments_id_lesson_id_key")
  @@map("content_assignments")
  @@schema("app")
}

model AssignmentHistory {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId      String            @map("assignment_id") @db.Uuid
  sequenceNo        Int               @map("sequence_no")
  eventType         String            @map("event_type") @db.Text
  previousTeacherId String?           @map("previous_teacher_id") @db.Uuid
  nextTeacherId     String            @map("next_teacher_id") @db.Uuid
  scopeGeneration   BigInt            @map("scope_generation")
  changedBy         String            @map("changed_by") @db.Uuid
  reason            String?           @db.Text
  changedAt         DateTime          @default(now()) @map("changed_at") @db.Timestamptz(6)
  scopeSnapshot     Json              @default("{}") @map("scope_snapshot") @db.JsonB

  assignment        ContentAssignment @relation(fields: [assignmentId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  previousTeacher   Account?          @relation("HistoryPreviousTeacher", fields: [previousTeacherId], references: [id], onUpdate: NoAction, onDelete: Restrict, map: "assignment_history_previous_teacher_fkey")
  nextTeacher       Account           @relation("HistoryNextTeacher", fields: [nextTeacherId], references: [id], onUpdate: NoAction, onDelete: Restrict, map: "assignment_history_next_teacher_fkey")
  changer           Account           @relation("HistoryChangedBy", fields: [changedBy], references: [id], onUpdate: NoAction, onDelete: Restrict)

  creationEpisodes  LessonRevision[]  @relation("RevisionCreationEpisode")
  itemCreationEpisodes ItemRevision[] @relation("ItemRevisionCreationEpisode")
  reviewEpisodes    RevisionReview[]  @relation("ReviewAssignmentEpisode")

  @@unique([assignmentId, sequenceNo], map: "assignment_history_assignment_id_sequence_no_key")
  @@unique([id, assignmentId], map: "assignment_history_id_assignment_id_key")
  @@map("assignment_history")
  @@schema("app")
}

model LessonRevision {
  id                            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId                      String             @map("lesson_id") @db.Uuid
  revisionNo                    Int                @map("revision_no")
  priorRevisionId               String?            @map("prior_revision_id") @db.Uuid
  changeSummary                 String?            @map("change_summary") @db.Text
  assignmentId                  String             @map("assignment_id") @db.Uuid
  creationAssignmentEpisodeId   String             @map("creation_assignment_episode_id") @db.Uuid
  status                        String             @default("DRAFT") @db.Text
  title                         Json               @db.JsonB
  contentBlocks                 Json               @default("[]") @map("content_blocks") @db.JsonB
  topicIds                      String[]           @default([]) @map("topic_ids")
  skillIds                      String[]           @default([]) @map("skill_ids")
  purposeTags                   String[]           @default([]) @map("purpose_tags")
  coverageCatalogGeneration     BigInt?            @map("coverage_catalog_generation")
  coverageSnapshot              Json?              @map("coverage_snapshot") @db.JsonB
  submittedAssignmentGeneration BigInt?            @map("submitted_assignment_generation")
  assignmentScopeSnapshot       Json?              @map("assignment_scope_snapshot") @db.JsonB
  createdBy                     String             @map("created_by") @db.Uuid
  lastEditedBy                  String             @map("last_edited_by") @db.Uuid
  submittedBy                   String?            @map("submitted_by") @db.Uuid
  submittedAt                   DateTime?          @map("submitted_at") @db.Timestamptz(6)
  approvedBy                    String?            @map("approved_by") @db.Uuid
  approvedAt                    DateTime?          @map("approved_at") @db.Timestamptz(6)
  publishedBy                   String?            @map("published_by") @db.Uuid
  publishedAt                   DateTime?          @map("published_at") @db.Timestamptz(6)
  endedAt                       DateTime?          @map("ended_at") @db.Timestamptz(6)
  createdAt                     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion                    BigInt             @default(1) @map("row_version")

  lesson                        Lesson             @relation("LessonRevisions", fields: [lessonId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  priorRevision                 LessonRevision?    @relation("PriorLessonRevision", fields: [priorRevisionId], references: [id], onUpdate: NoAction, onDelete: Restrict, map: "lesson_revisions_prior_revision_fkey")
  successorRevisions            LessonRevision[]   @relation("PriorLessonRevision")
  assignment                    ContentAssignment  @relation(fields: [assignmentId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  creationEpisode               AssignmentHistory  @relation("RevisionCreationEpisode", fields: [creationAssignmentEpisodeId, assignmentId], references: [id, assignmentId], onUpdate: NoAction, onDelete: Restrict, map: "lesson_revisions_creation_assignment_episode_fkey")

  creator                       Account            @relation("LessonRevisionCreatedBy", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: Restrict)
  lastEditor                    Account            @relation("LessonRevisionLastEditedBy", fields: [lastEditedBy], references: [id], onUpdate: NoAction, onDelete: Restrict)
  submitter                     Account?           @relation("LessonRevisionSubmittedBy", fields: [submittedBy], references: [id], onUpdate: NoAction, onDelete: Restrict)
  approver                      Account?           @relation("LessonRevisionApprovedBy", fields: [approvedBy], references: [id], onUpdate: NoAction, onDelete: Restrict)
  publisher                     Account?           @relation("LessonRevisionPublishedBy", fields: [publishedBy], references: [id], onUpdate: NoAction, onDelete: Restrict)

  activeForLessons              Lesson[]           @relation("ActiveLessonRevision")
  authoredItemRevisions         ItemRevision[]     @relation("ItemRevisionAuthoringLesson")
  reviews                       RevisionReview[]   @relation("ReviewLessonRevision")

  @@unique([lessonId, revisionNo], map: "lesson_revisions_lesson_id_revision_no_key")
  @@unique([id, lessonId], map: "lesson_revisions_id_lesson_id_key")
  @@map("lesson_revisions")
  @@schema("app")
}

model ItemIdentity {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  origin            String         @db.Text
  createdBy         String         @map("created_by") @db.Uuid
  variantOfId       String?        @map("variant_of_id") @db.Uuid
  exactFingerprint  String         @map("exact_fingerprint") @db.Text
  practiceExposedAt DateTime?      @map("practice_exposed_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator           Account        @relation("ItemIdentityCreatedBy", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: Restrict)
  variantOf         ItemIdentity?  @relation("ItemVariantOf", fields: [variantOfId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  variants          ItemIdentity[] @relation("ItemVariantOf")
  revisions         ItemRevision[]

  @@map("item_identities")
  @@schema("app")
}

model ItemRevision {
  id                          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId                      String               @map("item_id") @db.Uuid
  revisionNo                  Int                  @map("revision_no")
  type                        String               @db.Text
  promptData                  Json                 @map("prompt_data") @db.JsonB
  practiceSkillIds            String[]             @default([]) @map("practice_skill_ids")
  practiceCoverageSnapshot    Json?                @map("practice_coverage_snapshot") @db.JsonB
  schemaVersion               Int                  @default(1) @map("schema_version")
  exactFingerprint            String               @map("exact_fingerprint") @db.Text
  createdBy                   String               @map("created_by") @db.Uuid
  creationAssignmentEpisodeId String               @map("creation_assignment_episode_id") @db.Uuid
  authoringLessonRevisionId   String               @map("authoring_lesson_revision_id") @db.Uuid
  assessmentBlueprintId       String?              @map("assessment_blueprint_id") @db.Uuid
  blueprintGeneration         BigInt?              @map("blueprint_generation")
  isDraftOmitted              Boolean              @default(false) @map("is_draft_omitted")
  frozenAt                    DateTime?            @map("frozen_at") @db.Timestamptz(6)
  createdAt                   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion                  BigInt               @default(1) @map("row_version")

  item                        ItemIdentity         @relation(fields: [itemId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  creator                     Account              @relation("ItemRevisionCreatedBy", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: Restrict)
  creationEpisode             AssignmentHistory    @relation("ItemRevisionCreationEpisode", fields: [creationAssignmentEpisodeId], references: [id], onUpdate: NoAction, onDelete: Restrict, map: "item_revisions_creation_assignment_episode_fkey")
  authoringLessonRevision     LessonRevision       @relation("ItemRevisionAuthoringLesson", fields: [authoringLessonRevisionId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  assessmentBlueprint         AssessmentBlueprint? @relation(fields: [assessmentBlueprintId], references: [id], onUpdate: NoAction, onDelete: Restrict)

  @@unique([itemId, revisionNo], map: "item_revisions_item_id_revision_no_key")
  @@unique([id, itemId], map: "item_revisions_id_item_id_key")
  @@unique([id, authoringLessonRevisionId], map: "item_revisions_id_authoring_lesson_revision_id_key")
  @@map("item_revisions")
  @@schema("app")
}

model AssessmentBlueprint {
  id                         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdBy                  String              @map("created_by") @db.Uuid
  languageId                 String              @map("language_id") @db.Uuid
  frameworkId                String              @map("framework_id") @db.Uuid
  courseId                   String              @map("course_id") @db.Uuid
  purpose                    String              @db.Text
  targetLevelId              String?             @map("target_level_id") @db.Uuid
  nextLevelId                String?             @map("next_level_id") @db.Uuid
  coverage                   Json                @default("{}") @db.JsonB
  requirements               Json                @default("{}") @db.JsonB
  config                     Json                @default("{}") @db.JsonB
  coverageCatalogGeneration  BigInt              @default(1) @map("coverage_catalog_generation")
  generation                 BigInt              @default(1)
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion                 BigInt              @default(1) @map("row_version")

  creator                    Account             @relation("BlueprintCreatedBy", fields: [createdBy], references: [id], onUpdate: NoAction, onDelete: Restrict)
  language                   Language            @relation(fields: [languageId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  framework                  Framework           @relation(fields: [frameworkId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  course                     Course              @relation(fields: [courseId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  targetLevel                Level?              @relation("BlueprintTargetLevel", fields: [targetLevelId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  nextLevel                  Level?              @relation("BlueprintNextLevel", fields: [nextLevelId], references: [id], onUpdate: NoAction, onDelete: Restrict)

  versions                   AssessmentVersion[]
  itemRevisions              ItemRevision[]

  @@map("assessment_blueprints")
  @@schema("app")
}

model AssessmentVersion {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blueprintId         String              @map("blueprint_id") @db.Uuid
  versionNo           Int                 @map("version_no")
  blueprintGeneration BigInt              @map("blueprint_generation")
  blueprintSnapshot   Json                @map("blueprint_snapshot") @db.JsonB
  assembledAt         DateTime            @default(now()) @map("assembled_at") @db.Timestamptz(6)
  assemblyInputHash   String              @map("assembly_input_hash") @db.Text
  status              String              @default("IN_REVIEW") @db.Text
  isActive            Boolean             @default(false) @map("is_active")
  approvedBy          String?             @map("approved_by") @db.Uuid
  approvedAt          DateTime?           @map("approved_at") @db.Timestamptz(6)
  publishedBy         String?             @map("published_by") @db.Uuid
  publishedAt         DateTime?           @map("published_at") @db.Timestamptz(6)
  endedAt             DateTime?           @map("ended_at") @db.Timestamptz(6)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion          BigInt              @default(1) @map("row_version")

  blueprint           AssessmentBlueprint @relation(fields: [blueprintId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  approver            Account?            @relation("VersionApprovedBy", fields: [approvedBy], references: [id], onUpdate: NoAction, onDelete: Restrict)
  publisher           Account?            @relation("VersionPublishedBy", fields: [publishedBy], references: [id], onUpdate: NoAction, onDelete: Restrict)

  reviews             RevisionReview[]    @relation("ReviewAssessmentVersion")

  @@unique([blueprintId, versionNo], map: "assessment_versions_blueprint_id_version_no_key")
  @@unique([blueprintId, blueprintGeneration, assemblyInputHash], map: "assessment_versions_blueprint_id_generation_input_hash_key")
  @@map("assessment_versions")
  @@schema("app")
}

model LearningContext {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  learnerId            String    @map("learner_id") @db.Uuid
  languageId           String    @map("language_id") @db.Uuid
  courseId             String    @map("course_id") @db.Uuid
  status               String    @default("ACTIVE") @db.Text
  purpose              String?   @db.Text
  studyPreferences     Json      @default("{}") @map("study_preferences") @db.JsonB
  studyFocus           String    @default("BALANCED") @map("study_focus") @db.Text
  selectedStartLevelId String?   @map("selected_start_level_id") @db.Uuid
  startSource          String?   @map("start_source") @db.Text
  startResultId        String?   @map("start_result_id") @db.Uuid
  selfReport           Json?     @map("self_report") @db.JsonB
  workingLevelId       String?   @map("working_level_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion           BigInt    @default(1) @map("row_version")

  learner              Account   @relation(fields: [learnerId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  language             Language  @relation(fields: [languageId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  course               Course    @relation(fields: [courseId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  selectedStartLevel   Level?    @relation("ContextStartLevel", fields: [selectedStartLevelId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  workingLevel         Level?    @relation("ContextWorkingLevel", fields: [workingLevelId], references: [id], onUpdate: NoAction, onDelete: Restrict)

  @@unique([learnerId, languageId], map: "learning_contexts_learner_id_language_id_key")
  @@map("learning_contexts")
  @@schema("app")
}

model MediaAsset {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucketId       String             @default("lingora-media") @map("bucket_id") @db.Text
  objectKey      String             @map("object_key") @db.Text
  sha256         String             @db.Text
  mimeType       String             @map("mime_type") @db.Text
  byteSize       BigInt             @map("byte_size")
  uploadedBy     String             @map("uploaded_by") @db.Uuid
  ownerAccountId String?            @map("owner_account_id") @db.Uuid
  assignmentId   String?            @map("assignment_id") @db.Uuid
  kind           String             @db.Text
  readyAt        DateTime?          @map("ready_at") @db.Timestamptz(6)
  frozenAt       DateTime?          @map("frozen_at") @db.Timestamptz(6)
  retiredAt      DateTime?          @map("retired_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  uploader       Account            @relation("MediaUploadedBy", fields: [uploadedBy], references: [id], onUpdate: NoAction, onDelete: Restrict)
  ownerAccount   Account?           @relation("MediaOwnerAccount", fields: [ownerAccountId], references: [id], onUpdate: NoAction, onDelete: Restrict, map: "media_assets_owner_account_fkey")
  assignment     ContentAssignment? @relation(fields: [assignmentId], references: [id], onUpdate: NoAction, onDelete: Restrict)

  accountsWithAvatar Account[]      @relation("AccountAvatarMedia")

  @@unique([bucketId, objectKey], map: "media_assets_bucket_id_object_key_key")
  @@map("media_assets")
  @@schema("app")
}

model RevisionReview {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonRevisionId        String?            @map("lesson_revision_id") @db.Uuid
  assessmentVersionId     String?            @map("assessment_version_id") @db.Uuid
  action                  String             @db.Text
  actorId                 String             @map("actor_id") @db.Uuid
  assignmentEpisodeId     String?            @map("assignment_episode_id") @db.Uuid
  assignmentGeneration    BigInt?            @map("assignment_generation")
  assignmentScopeSnapshot Json?              @map("assignment_scope_snapshot") @db.JsonB
  blueprintGeneration     BigInt?            @map("blueprint_generation")
  feedbackItemIds         String[]           @default([]) @map("feedback_item_ids") @db.Uuid
  occurredAt              DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(6)
  revisionRowVersion      BigInt             @map("revision_row_version")
  comment                 String?            @db.Text
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  lessonRevision          LessonRevision?    @relation("ReviewLessonRevision", fields: [lessonRevisionId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  assessmentVersion       AssessmentVersion? @relation("ReviewAssessmentVersion", fields: [assessmentVersionId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  actor                   Account            @relation("ReviewActor", fields: [actorId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  assignmentEpisode       AssignmentHistory? @relation("ReviewAssignmentEpisode", fields: [assignmentEpisodeId], references: [id], onUpdate: NoAction, onDelete: Restrict)

  @@unique([id, lessonRevisionId, assignmentEpisodeId], map: "revision_reviews_id_lesson_rev_assignment_ep_key")
  @@map("revision_reviews")
  @@schema("app")
}

model ProvisioningRequest {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operationKey         String    @unique(map: "provisioning_requests_operation_key_key") @map("operation_key") @db.Uuid
  normalizedEmail      String    @unique(map: "provisioning_requests_normalized_email_key") @map("normalized_email") @db.Text
  requestedRole        String    @map("requested_role") @db.Text
  requestedBy          String?   @map("requested_by") @db.Uuid
  authUserId           String?   @map("auth_user_id") @db.Uuid
  state                String    @default("REQUESTED") @db.Text
  providerCorrelationId String?  @map("provider_correlation_id") @db.Text
  lastErrorCode        String?   @map("last_error_code") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  rowVersion           BigInt    @default(1) @map("row_version")

  requester            Account?  @relation("ProvisioningRequestedBy", fields: [requestedBy], references: [id], onUpdate: NoAction, onDelete: Restrict)

  @@map("provisioning_requests")
  @@schema("app_private")
}

model CommandReceipt {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  command      String   @db.Text
  operationKey String   @map("operation_key") @db.Uuid
  inputHash    String   @map("input_hash") @db.Text
  targetId     String   @map("target_id") @db.Uuid
  safeResult   Json     @default("{}") @map("safe_result") @db.JsonB
  committedAt  DateTime @default(now()) @map("committed_at") @db.Timestamptz(6)

  actor        Account  @relation(fields: [actorId], references: [id], onUpdate: NoAction, onDelete: Restrict)

  @@unique([actorId, command, operationKey], map: "command_receipts_actor_id_command_operation_key_key")
  @@map("command_receipts")
  @@schema("app_private")
}

model AuditEvent {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorKind             String    @map("actor_kind") @db.Text
  actorId               String?   @map("actor_id") @db.Uuid
  verifiedAuthSubjectId String?   @map("verified_auth_subject_id") @db.Uuid
  action                String    @db.Text
  targetType            String    @map("target_type") @db.Text
  targetId              String?   @map("target_id") @db.Uuid
  targetVersionId       String?   @map("target_version_id") @db.Uuid
  outcome               String    @db.Text
  reason                String?   @db.Text
  correlationId         String?   @map("correlation_id") @db.Uuid
  safeContext           Json?     @map("safe_context") @db.JsonB
  occurredAt            DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)

  actor                 Account?  @relation("AuditActor", fields: [actorId], references: [id], onUpdate: NoAction, onDelete: Restrict)

  @@map("audit_events")
  @@schema("app_private")
}
