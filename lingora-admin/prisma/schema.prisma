generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Phase 0 Canonical Roles (ADR-014 & docs/phase-0-roles-and-mvp-final.md)
// ---------------------------------------------------------------------------
enum Role {
  ADMINISTRATOR
  LESSON_CREATOR
  MODERATOR
  OPERATIONS_STAFF
  LEARNER
  ORGANIZATIONAL_MANAGER
}

// ---------------------------------------------------------------------------
// Phase 0 Content Lifecycle (Draft -> In Review -> Changes Requested -> Approved -> Published -> Archived)
// ---------------------------------------------------------------------------
enum ContentStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum Cefr {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum ExerciseType {
  MCQ
  FILL_BLANK
  REORDER
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ---------------------------------------------------------------------------
// Core Learning Domain Models
// ---------------------------------------------------------------------------

model Language {
  code        String  @id @db.VarChar(8)
  name        String
  nativeName  String  @map("native_name")
  isLearnable Boolean @default(false) @map("is_learnable")
  isUiLocale  Boolean @default(false) @map("is_ui_locale")

  uiProfiles             Profile[]                 @relation("ProfileUiLocale")
  nativeProfiles         Profile[]                 @relation("ProfileNativeLanguage")
  courses                Course[]
  unitTranslations       UnitTranslation[]         @relation("UnitTranslationLocale")
  vocabularies           Vocabulary[]
  courseTranslations     CourseTranslation[]       @relation("CourseTranslationLocale")
  lessonTranslations     LessonTranslation[]       @relation("LessonTranslationLocale")
  vocabularyTranslations VocabularyTranslation[]   @relation("VocabularyTranslationLocale")
  scenarioTranslations   ChatScenarioTranslation[] @relation("ChatScenarioTranslationLocale")

  @@map("languages")
}

model Profile {
  id                         String    @id @db.Uuid
  email                      String    @unique
  displayName                String?   @map("display_name")
  avatarUrl                  String?   @map("avatar_url")
  role                       Role      @default(LEARNER)
  assignedRoles              Role[]    @default([LEARNER]) @map("assigned_roles")
  uiLocale                   String    @default("vi") @map("ui_locale") @db.VarChar(8)
  nativeLangCode             String    @default("vi") @map("native_lang_code") @db.VarChar(8)
  dailyGoalMin               Int       @default(15) @map("daily_goal_min")
  streakCount                Int       @default(0) @map("streak_count")
  timezone                   String    @default("Asia/Ho_Chi_Minh")
  lastQualifyingActivityDate DateTime? @map("last_qualifying_activity_date") @db.Date
  createdAt                  DateTime  @default(now()) @map("created_at")

  uiLanguage      Language       @relation("ProfileUiLocale", fields: [uiLocale], references: [code], onDelete: Restrict, onUpdate: Cascade)
  nativeLanguage  Language       @relation("ProfileNativeLanguage", fields: [nativeLangCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  createdCourses  Course[]       @relation("CourseCreator")
  reviewedCourses Course[]       @relation("CourseReviewer")
  createdLessons  Lesson[]       @relation("LessonCreator")
  reviewedLessons Lesson[]       @relation("LessonReviewer")
  progress        UserProgress[]
  srsCards        UserVocabSrs[]
  auditLogs       AuditLog[]

  @@map("profiles")
}

model Course {
  id           String        @id @default(uuid()) @db.Uuid
  languageCode String        @map("language_code") @db.VarChar(8)
  cefr         Cefr
  orderIndex   Int           @map("order_index")
  status       ContentStatus @default(DRAFT)
  isPublished  Boolean       @default(false) @map("is_published")
  creatorId    String?       @map("creator_id") @db.Uuid
  reviewerId   String?       @map("reviewer_id") @db.Uuid
  submittedAt  DateTime?     @map("submitted_at")
  reviewedAt   DateTime?     @map("reviewed_at")
  publishedAt  DateTime?     @map("published_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  language     Language            @relation(fields: [languageCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  creator      Profile?            @relation("CourseCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  reviewer     Profile?            @relation("CourseReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  translations CourseTranslation[]
  units        Unit[]
  lessons      Lesson[]

  @@index([languageCode, orderIndex])
  @@index([status])
  @@map("courses")
}

model CourseTranslation {
  courseId    String  @map("course_id") @db.Uuid
  locale      String  @db.VarChar(8)
  title       String
  description String?

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  language Language @relation("CourseTranslationLocale", fields: [locale], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@id([courseId, locale])
  @@map("course_translations")
}

model Unit {
  id         String   @id @default(uuid()) @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  orderIndex Int      @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  course       Course            @relation(fields: [courseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  translations UnitTranslation[]
  lessons      Lesson[]

  @@unique([courseId, orderIndex])
  @@map("units")
}

model UnitTranslation {
  unitId      String  @map("unit_id") @db.Uuid
  locale      String  @db.VarChar(8)
  title       String
  description String?

  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  language Language @relation("UnitTranslationLocale", fields: [locale], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@id([unitId, locale])
  @@map("unit_translations")
}

model Lesson {
  id          String        @id @default(uuid()) @db.Uuid
  courseId    String        @map("course_id") @db.Uuid
  unitId      String?       @map("unit_id") @db.Uuid
  orderIndex  Int           @map("order_index")
  status      ContentStatus @default(DRAFT)
  isPublished Boolean       @default(false) @map("is_published")
  objective   String?
  creatorId   String?       @map("creator_id") @db.Uuid
  reviewerId  String?       @map("reviewer_id") @db.Uuid
  submittedAt DateTime?     @map("submitted_at")
  reviewedAt  DateTime?     @map("reviewed_at")
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  course       Course              @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  unit         Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  creator      Profile?            @relation("LessonCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  reviewer     Profile?            @relation("LessonReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  translations LessonTranslation[]
  vocabulary   LessonVocabulary[]
  exercises    Exercise[]
  progress     UserProgress[]

  @@unique([courseId, orderIndex])
  @@index([status])
  @@map("lessons")
}

model LessonTranslation {
  lessonId    String  @map("lesson_id") @db.Uuid
  locale      String  @db.VarChar(8)
  title       String
  description String?

  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  language Language @relation("LessonTranslationLocale", fields: [locale], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@id([lessonId, locale])
  @@map("lesson_translations")
}

model Vocabulary {
  id             String   @id @default(uuid()) @db.Uuid
  languageCode   String   @map("language_code") @db.VarChar(8)
  term           String
  normalizedTerm String   @map("normalized_term")
  phonetic       String?
  audioUrl       String?  @map("audio_url")
  cefr           Cefr?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  language     Language                @relation(fields: [languageCode], references: [code], onDelete: Restrict, onUpdate: Cascade)
  translations VocabularyTranslation[]
  lessons      LessonVocabulary[]
  srsCards     UserVocabSrs[]

  @@unique([languageCode, normalizedTerm])
  @@map("vocabularies")
}

model VocabularyTranslation {
  vocabularyId String  @map("vocabulary_id") @db.Uuid
  locale       String  @db.VarChar(8)
  meaning      String
  example      String?

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  language   Language   @relation("VocabularyTranslationLocale", fields: [locale], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@id([vocabularyId, locale])
  @@map("vocabulary_translations")
}

model LessonVocabulary {
  lessonId     String @map("lesson_id") @db.Uuid
  vocabularyId String @map("vocabulary_id") @db.Uuid
  orderIndex   Int    @map("order_index")

  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([lessonId, vocabularyId])
  @@unique([lessonId, orderIndex])
  @@map("lesson_vocabulary")
}

model Exercise {
  id         String       @id @default(uuid()) @db.Uuid
  lessonId   String       @map("lesson_id") @db.Uuid
  type       ExerciseType
  payload    Json
  orderIndex Int          @map("order_index")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([lessonId, orderIndex])
  @@map("exercises")
}

model UserProgress {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  lessonId    String         @map("lesson_id") @db.Uuid
  status      ProgressStatus @default(NOT_STARTED)
  score       Int?
  completedAt DateTime?      @map("completed_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user   Profile @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lesson Lesson  @relation(fields: [lessonId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, lessonId])
  @@map("user_progress")
}

model UserVocabSrs {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  vocabularyId      String    @map("vocabulary_id") @db.Uuid
  easeFactor        Float     @default(2.5) @map("ease_factor")
  intervalDays      Float     @default(1) @map("interval_days")
  recallProbability Float?    @map("recall_probability")
  nextReviewAt      DateTime  @default(now()) @map("next_review_at")
  lastReviewedAt    DateTime? @map("last_reviewed_at")
  reviewCount       Int       @default(0) @map("review_count")
  lapseCount        Int       @default(0) @map("lapse_count")
  createdAt         DateTime  @default(now()) @map("created_at")

  user       Profile     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vocabulary Vocabulary  @relation(fields: [vocabularyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  logs       ReviewLog[]

  @@unique([userId, vocabularyId])
  @@index([userId, nextReviewAt])
  @@map("user_vocab_srs")
}

model ReviewLog {
  id           String   @id @default(uuid()) @db.Uuid
  srsCardId    String   @map("srs_card_id") @db.Uuid
  isCorrect    Boolean  @map("is_correct")
  intervalDays Float    @map("interval_days")
  reviewedAt   DateTime @default(now()) @map("reviewed_at")

  srsCard UserVocabSrs @relation(fields: [srsCardId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([srsCardId, reviewedAt])
  @@map("review_logs")
}

// ---------------------------------------------------------------------------
// Scenario Context (for UC-06 Scenario Writing practice)
// ---------------------------------------------------------------------------

model ChatScenario {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  isPublished  Boolean  @default(false) @map("is_published")
  systemPrompt String   @map("system_prompt")
  createdAt    DateTime @default(now()) @map("created_at")

  translations ChatScenarioTranslation[]

  @@map("chat_scenarios")
}

model ChatScenarioTranslation {
  scenarioId  String  @map("scenario_id") @db.Uuid
  uiLocale    String  @map("ui_locale") @db.VarChar(8)
  title       String
  description String?

  scenario ChatScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  language Language     @relation("ChatScenarioTranslationLocale", fields: [uiLocale], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@id([scenarioId, uiLocale])
  @@map("chat_scenario_translations")
}

// ---------------------------------------------------------------------------
// Audit Log (MVP-19: System, Role & Content Action Auditability)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor Profile @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
