{
  "name": "lingora-admin",
  "version": "1.0.0",
  "description": "Project 1 administration boundary and database runtime harness for Lingora.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:feature": "node --experimental-strip-types --experimental-test-module-mocks tests/feature/auth.test.mjs && node --experimental-strip-types --experimental-test-module-mocks tests/feature/languages-crud.test.mjs && node --experimental-strip-types --experimental-test-module-mocks tests/feature/frameworks-crud.test.mjs && node --experimental-strip-types --experimental-test-module-mocks tests/feature/courses-units-crud.test.mjs && node --experimental-strip-types --experimental-test-module-mocks tests/feature/teachers-crud.test.mjs",
    "test:components": "node tests/feature/isolated-components.test.mjs && node tests/feature/isolated-components-frameworks.test.mjs && node tests/feature/isolated-components-courses.test.mjs && node tests/feature/isolated-components-teachers.test.mjs",
    "test:e2e": "node tests/feature/e2e-browser.mjs",
    "test:all": "npm run test:feature && npm run test:components && npm run test:e2e",
    "db:product:validate": "DATABASE_URL=\"${DATABASE_URL:-postgresql://placeholder:placeholder@127.0.0.1:5432/placeholder?schema=app}\" DIRECT_URL=\"${DIRECT_URL:-postgresql://placeholder:placeholder@127.0.0.1:5432/placeholder?schema=app}\" prisma validate --schema prisma/product/schema.prisma",
    "db:product:generate": "DATABASE_URL=\"${DATABASE_URL:-postgresql://placeholder:placeholder@127.0.0.1:5432/placeholder?schema=app}\" DIRECT_URL=\"${DIRECT_URL:-postgresql://placeholder:placeholder@127.0.0.1:5432/placeholder?schema=app}\" prisma generate --schema prisma/product/schema.prisma",
    "db:product:migrate": "prisma migrate deploy --schema prisma/product/schema.prisma",
    "db:product:seed": "prisma db seed --schema prisma/product/schema.prisma"
  },
  "prisma": {
    "seed": "node prisma/product/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "pg": "8.13.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "playwright": "1.62.1",
    "prisma": "6.19.3",
    "supabase": "2.121.0",
    "typescript": "7.0.2"
  }
}
