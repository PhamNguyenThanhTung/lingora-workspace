{
  "name": "lingora-admin",
  "version": "1.0.0",
  "description": "Project 1 administration boundary and database runtime harness for Lingora.",
  "private": true,
  "type": "module",
  "scripts": {
    "test:db:a1": "node tests/database/scaffolds/a1-runner.mjs",
    "test:db:a2": "node tests/database/scaffolds/a2-runner.mjs",
    "test:db:a3": "node tests/database/scaffolds/a3-runner.mjs",
    "test:db:integrity": "node tests/database/scaffolds/integrity-runner.mjs",
    "test:db:security": "node tests/database/scaffolds/security-runner.mjs",
    "test:db:concurrency": "node tests/database/scaffolds/concurrency-runner.mjs",
    "test:db:smoke": "node tests/database/scaffolds/smoke-runner.mjs",
    "env:check": "node tests/database/env/env-guard.mjs check",
    "stack:start": "node tests/database/env/stack-manager.mjs start",
    "stack:stop": "node tests/database/env/stack-manager.mjs stop",
    "stack:status": "node tests/database/env/stack-manager.mjs status",
    "stack:destroy": "node tests/database/env/stack-manager.mjs destroy",
    "db:product:validate": "DATABASE_URL=\"${DATABASE_URL:-postgresql://placeholder:placeholder@127.0.0.1:5432/placeholder?schema=app}\" DIRECT_URL=\"${DIRECT_URL:-postgresql://placeholder:placeholder@127.0.0.1:5432/placeholder?schema=app}\" prisma validate --schema prisma/product/schema.prisma",
    "db:product:generate": "DATABASE_URL=\"${DATABASE_URL:-postgresql://placeholder:placeholder@127.0.0.1:5432/placeholder?schema=app}\" DIRECT_URL=\"${DIRECT_URL:-postgresql://placeholder:placeholder@127.0.0.1:5432/placeholder?schema=app}\" prisma generate --schema prisma/product/schema.prisma",
    "db:product:preflight": "node scripts/product-preflight.mjs",
    "db:product:migrate": "prisma migrate deploy --schema prisma/product/schema.prisma",
    "db:product:seed": "prisma db seed --schema prisma/product/schema.prisma",
    "db:product:smoke": "node scripts/product-database-smoke.mjs"
  },
  "prisma": {
    "seed": "node prisma/product/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "2.112.3",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "supabase": "2.121.0"
  }
}
