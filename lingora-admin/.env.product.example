# =============================================================================
# Dedicated Hosted Supabase DEV Configuration Template
# Authority: plans/current-task.md (DEV environment and Admin Auth readiness)
# =============================================================================
# This configuration is for the dedicated hosted Supabase DEV environment only.
# Do NOT place credentials in tracked git files or commit real passwords.
# Do NOT point to production or unknown databases.
#
# Dedicated Supabase DEV project reference (positively identified):
SUPABASE_DEV_PROJECT_REF=sncfyvpzwedqgwfpffkh

# Direct database connection URL (for migrations via prisma migrate deploy):
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.sncfyvpzwedqgwfpffkh.supabase.co:5432/postgres?schema=app

# Session connection pooler URL (port 5432 session mode):
# Pooler user format is postgres.[YOUR-PROJECT-REF]
DATABASE_URL=postgresql://postgres.sncfyvpzwedqgwfpffkh:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?schema=app

# Public Supabase Auth configuration for the future Slice 1 client/server adapter.
# Project URL is non-secret. Copy this project's publishable key from Dashboard.
# A legacy anon key can be used here if that is the project's available public key.
# Never put a service-role/secret key, DB password or management token in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://sncfyvpzwedqgwfpffkh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=[YOUR-PUBLIC-PUBLISHABLE-OR-ANON-KEY]

# Optional: Dedicated existing DEV Auth user UUID for smoke tests (auth.users row):
# If provided, smoke will verify provider FK and context linkage in rollback transaction.
# If omitted, smoke will report provider Auth identity test branch as NOT RUN.
DEV_AUTH_USER_ID=
